@using MudBlazor
@using EPMS.Client.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject CurrentUserPermissionService PermService
@inject AuthenticationStateProvider AuthState

<div style="display: flex; flex-direction: column; height: 100%;">
<MudNavMenu Style="flex: 1;">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    

    @if (_canViewPositions)
    {
        <MudNavLink Href="hr/positions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Work">Positions</MudNavLink>
    }
    @if (_canViewLevels)
    {
        <MudNavLink Href="hr/levels" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Stairs">Levels</MudNavLink>
    }
    @if (_canViewDepartments)
    {
        <MudNavLink Href="hr/departments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business">Departments</MudNavLink>
    }
    @if (_canViewTeams)
    {
        <MudNavLink Href="hr/teams" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups">Teams</MudNavLink>
    }
    <MudNavLink Href="hr/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Categories</MudNavLink>
    <MudNavLink Href="hr/employees" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Employee Directory</MudNavLink>


    <MudNavLink Href="performance/appraisal-cycles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CalendarMonth">Appraisal Cycles</MudNavLink>
    <MudNavLink Href="performance/rating-scales" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Star">Rating Scales</MudNavLink>
    <MudNavLink Href="performance/kpi-masters" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LibraryBooks">KPI Masters</MudNavLink>
    @if (_canViewEntityKpis)
    {
        <MudNavLink Href="performance/entity-kpis" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">KPI Assignments</MudNavLink>
    }
    @if (_canViewEmployeeKpis)
    {
        <MudNavLink Href="performance/employee-kpis" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonPin">Employee KPI Assignments</MudNavLink>
    }
    <MudNavLink Href="performance/kpi-weight-priorities" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Scale">KPI Weight Priorities</MudNavLink>
    @if (_canViewFormTemplates)
    {
        <MudNavLink Href="performance/form-templates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description">Form Templates</MudNavLink>
    }
    @if (_canViewPositionFormTemplates)
    {
        <MudNavLink Href="performance/position-form-templates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AssignmentInd">Position Form Templates</MudNavLink>
    }
    <MudNavLink Href="performance/question-rating-scales" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RateReview">Question Rating Scales</MudNavLink>
    <MudNavLink Href="performance/my-evaluations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EditNote">My Evaluations</MudNavLink>
    <MudNavLink Href="performance/appraisals" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">Appraisals</MudNavLink>
    <MudNavLink Href="performance/department-appraisals" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">Department Appraisals</MudNavLink>
    <MudNavLink Href="performance/team-appraisals" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">Team Appraisals</MudNavLink>
</MudNavMenu>

    @if (_isAdmin)
    {

        <MudNavLink Href="admin/admin-position" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AdminPanelSettings">Admin Position</MudNavLink>
        <MudNavLink Href="admin/position-permissions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Security">Position Permissions</MudNavLink>
        <MudNavLink Href="admin/password-requests" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonSearch">Password Reset Requests</MudNavLink>
        <MudNavLink Href="admin/default-password" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Lock">Default Password</MudNavLink>
        <MudNavLink Href="admin/create-user" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonAdd">Create User</MudNavLink>
        <MudNavLink Href="admin/recycle-bin" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DeleteSweep">Recycle Bin</MudNavLink>
    }
</div>

@code {
    private bool _canViewPositions;
    private bool _canViewLevels;
    private bool _canViewDepartments;
    private bool _canViewTeams;
    private bool _canViewEntityKpis;
    private bool _canViewEmployeeKpis;
    private bool _canViewFormTemplates;
    private bool _canViewPositionFormTemplates;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var permissions = await PermService.GetPermissionsAsync();
        var permSet = new HashSet<string>(permissions);

        _canViewPositions = permSet.Contains("POSITIONS.VIEW");
        _canViewLevels = permSet.Contains("LEVELS.VIEW");
        _canViewDepartments = permSet.Contains("DEPARTMENTS.VIEW");
        _canViewTeams = permSet.Contains("TEAMS.VIEW");
        _canViewEntityKpis = permSet.Contains("ENTITYKPI.VIEW");
        _canViewEmployeeKpis = permSet.Contains("EMPLOYEEKPI.VIEW");
        _canViewFormTemplates = permSet.Contains("FORMTEMPLATE.VIEW");
        _canViewPositionFormTemplates = permSet.Contains("POSITIONFORMTPL.VIEW");

        var authState = await AuthState.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("SystemAdmin") || authState.User.IsInRole("Admin");
    }
}
