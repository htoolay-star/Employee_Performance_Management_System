        </MudTooltip>
    </MudNavGroup>
    </MudTooltip>
    @if (_isAdmin || _isManager)
    {
    <MudTooltip Text="Fill Forms" Placement="Placement.Right" Disabled="@(!DrawerCollapsed)">
    <MudNavGroup Title="Fill Forms" Icon="@Icons.Material.Filled.EditNote" Expanded="false">
        <MudTooltip Text="KPI Forms" Placement="Placement.Right" Disabled="@(!DrawerCollapsed)">
            <MudNavLink Href="performance/my-evaluations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EditNote">KPI Forms</MudNavLink>
        </MudTooltip>
        <MudTooltip Text="Appraisal Forms" Placement="Placement.Right" Disabled="@(!DrawerCollapsed)">
            <MudNavLink Href="performance/my-forms/appraisal" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RateReview">Appraisal Forms</MudNavLink>
        </MudTooltip>
        <MudTooltip Text="Department KPIs" Placement="Placement.Right" Disabled="@(!DrawerCollapsed)">
            <MudNavLink Href="performance/department-appraisals" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">Department KPIs</MudNavLink>
        </MudTooltip>
        <MudTooltip Text="Team KPIs" Placement="Placement.Right" Disabled="@(!DrawerCollapsed)">
            <MudNavLink Href="performance/team-appraisals" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">Team KPIs</MudNavLink>
        </MudTooltip>
    </MudNavGroup>
    </MudTooltip>
    }
    @if (_isAdmin || _isManager)
    {
    <MudTooltip Text="Continuous Feedback" Placement="Placement.Right" Disabled="@(!DrawerCollapsed)">
        <MudNavLink Href="performance/continuous-feedbacks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Feedback">Continuous Feedback</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="One-on-One Meetings" Placement="Placement.Right" Disabled="@(!DrawerCollapsed)">
        <MudNavLink Href="performance/one-on-one-meetings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonSearch">One-on-One Meetings</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="Performance Improvement Plans" Placement="Placement.Right" Disabled="@(!DrawerCollapsed)">
