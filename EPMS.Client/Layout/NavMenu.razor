    <MudNavLink Href="hr/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Categories</MudNavLink>
    <MudNavLink Href="hr/employees" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Employee Directory</MudNavLink>

    <MudDivider Class="my-2" />

