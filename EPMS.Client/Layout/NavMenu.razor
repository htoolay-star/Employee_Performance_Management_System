</div>

@code {
    [Parameter] public bool DrawerCollapsed { get; set; }

    private bool _canViewPositions;
    private bool _canViewLevels;
    private bool _canViewDepartments;
    private bool _canViewTeams;
    private bool _canViewEntityKpis;
    private bool _canViewEmployeeKpis;
    private bool _canViewFormTemplates;
    private bool _canViewPositionFormTemplates;
    private bool _canViewEmployees;
    private bool _canViewApprCycles;
    private bool _canViewRatingScales;
    private bool _canViewKpiMasters;
    private bool _canViewKpiWeights;
    private bool _canViewQuestRating;
    private bool _canViewAppraisals;
    private bool _isAdmin;
    private bool _isSA;
    private bool _isManager;

    protected override async Task OnInitializedAsync()
    {
        if (NavCache.NavLoaded)
        {
            _isSA = NavCache.IsSA;
            _isAdmin = NavCache.IsAdmin;
            _isManager = NavCache.IsManager;
            var cachedPerms = NavCache.Permissions;
            _canViewPositions = cachedPerms.Contains("POSITIONS.VIEW");
            _canViewLevels = cachedPerms.Contains("LEVELS.VIEW");
            _canViewDepartments = cachedPerms.Contains("DEPARTMENTS.VIEW");
            _canViewTeams = cachedPerms.Contains("TEAMS.VIEW");
            _canViewEntityKpis = cachedPerms.Contains("ENTITYKPI.VIEW");
            _canViewEmployeeKpis = cachedPerms.Contains("EMPLOYEEKPI.VIEW");
            _canViewFormTemplates = cachedPerms.Contains("FORMTEMPLATE.VIEW");
            _canViewPositionFormTemplates = cachedPerms.Contains("POSITIONFORMTPL.VIEW");
            _canViewEmployees = cachedPerms.Contains("EMPLOYEES.VIEW");
            _canViewApprCycles = cachedPerms.Contains("APPRCYCLE.VIEW");
            _canViewRatingScales = cachedPerms.Contains("RATINGSCALE.VIEW");
            _canViewKpiMasters = cachedPerms.Contains("KPIMASTER.VIEW");
            _canViewKpiWeights = cachedPerms.Contains("KPIWEIGHT.VIEW");
            _canViewQuestRating = cachedPerms.Contains("QUESTRATING.VIEW");
            _canViewAppraisals = cachedPerms.Contains("APPRAISAL.VIEW");
            return;
        }

        var permissionsTask = PermService.GetPermissionsAsync();
        var authStateTask = AuthState.GetAuthenticationStateAsync();

        await Task.WhenAll(permissionsTask, authStateTask);

        var permissions = await permissionsTask;
        var permSet = new HashSet<string>(permissions);

        _canViewPositions = permSet.Contains("POSITIONS.VIEW");
        _canViewLevels = permSet.Contains("LEVELS.VIEW");
        _canViewDepartments = permSet.Contains("DEPARTMENTS.VIEW");
        _canViewTeams = permSet.Contains("TEAMS.VIEW");
        _canViewEntityKpis = permSet.Contains("ENTITYKPI.VIEW");
        _canViewEmployeeKpis = permSet.Contains("EMPLOYEEKPI.VIEW");
        _canViewFormTemplates = permSet.Contains("FORMTEMPLATE.VIEW");
        _canViewPositionFormTemplates = permSet.Contains("POSITIONFORMTPL.VIEW");
        _canViewEmployees = permSet.Contains("EMPLOYEES.VIEW");
        _canViewApprCycles = permSet.Contains("APPRCYCLE.VIEW");
        _canViewRatingScales = permSet.Contains("RATINGSCALE.VIEW");
        _canViewKpiMasters = permSet.Contains("KPIMASTER.VIEW");
        _canViewKpiWeights = permSet.Contains("KPIWEIGHT.VIEW");
        _canViewQuestRating = permSet.Contains("QUESTRATING.VIEW");
        _canViewAppraisals = permSet.Contains("APPRAISAL.VIEW");

        var authState = await authStateTask;
        _isSA = authState.User.IsInRole("SystemAdmin");
        _isAdmin = _isSA || authState.User.IsInRole("Admin");

        _isManager = false;
        if (authState.User.Identity is { IsAuthenticated: true })
        {
            try
            {
                var mgr = await AuthApiClient.IsManagerAsync();
                _isManager = mgr.Success && mgr.Data;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Manager status check failed: {ex.Message}");
                _isManager = false;
            }
        }

        NavCache.NavLoaded = true;
        NavCache.IsSA = _isSA;
        NavCache.IsAdmin = _isAdmin;
        NavCache.IsManager = _isManager;
        NavCache.Permissions = permissions.ToHashSet();
    }
}
