@inherits LayoutComponentBase
@using MudBlazor
@using EPMS.Client.Themes
@inject IJSRuntime JS

<MudThemeProvider Theme="EPMSTheme.GetTheme()" IsDarkMode="@_isDarkMode" />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleTheme" />
        <LoginDisplay />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Mini" Elevation="2">
        <MudDrawerHeader Class="@(_drawerOpen ? "" : "drawer-header-collapsed")">
            <img src="@(_isDarkMode ? "ACE-dark.svg" : "ACE.svg")" alt="ACE" class="@(_drawerOpen ? "drawer-logo" : "drawer-logo-collapsed")" />
        </MudDrawerHeader>
        <div class="@(_drawerOpen ? "" : "drawer-collapsed")">
            <NavMenu />
        </div>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
    <MudPopoverProvider />
</MudLayout>

@code {
    bool _drawerOpen = true;
    bool _isDarkMode = false;
    bool _pendingThemeSync = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string>("localStorage.getItem", "epms-dark-mode");
            _isDarkMode = stored == "true";
        }
        catch
        {
            _isDarkMode = false;
        }

        StateHasChanged();
        _pendingThemeSync = true;
    }

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        
        await JS.InvokeVoidAsync("localStorage.setItem", "epms-dark-mode", _isDarkMode.ToString().ToLower());
        
        _pendingThemeSync = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingThemeSync)
        {
            _pendingThemeSync = false;
            await JS.InvokeVoidAsync("epmsSyncTheme", _isDarkMode);
        }
    }
}
