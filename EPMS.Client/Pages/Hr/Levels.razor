@page "/hr/levels"
@using EPMS.Client.Services
@using EPMS.Shared.DTOs.LevelDTOs
@using EPMS.Shared.DTOs.Common
@using MudBlazor
@using static EPMS.Shared.Constants.ServiceResponseMessages
@using Refit
@inject ILevelApiClient LevelApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Levels - EPMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Level Management</MudText>

    <MudPaper Elevation="2" Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField @bind-Value="_searchString"
                          Placeholder="Search by code or name..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Style="max-width: 300px;"
                          TextChanged="OnSearchChanged" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                Add Level
            </MudButton>
        </MudStack>

        <MudDataGrid Items="@_filteredLevels"
                     Loading="@_loading"
                     Hover="true"
                     Striped="true"
                     Dense="true"
                     RowsPerPage="10">
            <Columns>
                <PropertyColumn Property="x => x.Id" Title="ID" />
                <PropertyColumn Property="x => x.Code" Title="Code" />
                <PropertyColumn Property="x => x.Name" Title="Name" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                                 Size="Size.Small">
                            @(context.Item.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenDeleteDialog(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText>No levels found.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Loading levels...</MudText>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="LevelDto" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

@code {
    private List<LevelDto> _levels = new();
    private List<LevelDto> _filteredLevels = new();
    private bool _loading = true;
    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadLevelsAsync();
    }

    private async Task LoadLevelsAsync()
    {
        _loading = true;
        try
        {
            var response = await LevelApiClient.GetAllAsync();
            if (response.Success && response.Data != null)
            {
                _levels = response.Data.ToList();
                FilterLevels();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to load levels", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "An error occurred", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<LevelDialog> { };
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<LevelDialog>("Create Level", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadLevelsAsync();
        }
    }

    private async Task OpenEditDialog(LevelDto level)
    {
        var parameters = new DialogParameters<LevelDialog>
        {
            { x => x.Level, level }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<LevelDialog>("Edit Level", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadLevelsAsync();
        }
    }

    private async Task OpenDeleteDialog(LevelDto level)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete level '{level.Name}'?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Level", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await DeleteLevelAsync(level.Id);
        }
    }

    private async Task DeleteLevelAsync(long id)
    {
        try
        {
            var response = await LevelApiClient.DeleteAsync(id);
            if (response.Success)
            {
                Snackbar.Add("Level deleted successfully", Severity.Success);
                await LoadLevelsAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to delete level", Severity.Error);
            }
        }
        catch (Refit.ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "An error occurred", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OnSearchChanged(string value)
    {
        FilterLevels();
    }

    private void FilterLevels()
    {
        if (string.IsNullOrWhiteSpace(_searchString))
        {
            _filteredLevels = _levels;
        }
        else
        {
            var search = _searchString.ToLower();
            _filteredLevels = _levels
                .Where(x => x.Code.ToLower().Contains(search) ||
                            x.Name.ToLower().Contains(search) ||
                            (x.Description?.ToLower().Contains(search) ?? false))
                .ToList();
        }
    }
}