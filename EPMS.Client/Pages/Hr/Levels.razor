@page "/hr/levels"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* ═══════════════════════════════════════════════════════════════════════════
   PATTERN: GetAll + Client-side QuickFilter + Client-side Sorting
   Use this pattern when the dataset is small (< ~500 rows).
   - Loads all rows once into memory on page load.
   - Filtering is done via MudDataGrid QuickFilter (client-side).
   - Sorting is done via MudDataGrid built-in column headers (client-side, no API call).
   - After every CUD operation, re-calls LoadAllAsync() to refresh the list.
   ═══════════════════════════════════════════════════════════════════════════ *@
@using EPMS.Client.Constants
@using EPMS.Client.Services.Auth
@using EPMS.Client.Services.Hr
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.LevelDTOs
@using MudBlazor
@using Refit
@using static EPMS.Shared.Constants.ServiceResponseMessages

@inject ILevelApiClient LevelApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject CurrentUserPermissionService PermService

<PageTitle>@UIConstants.Level.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    @if (!_initialized)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudStack Spacing="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
            </MudStack>
        </MudPaper>
    }
    else if (_error)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">@_errorMessage</MudAlert>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="rounded-lg">

            @* ── Header Row: Title + Add Button ──────────────────────────────── *@
            <MudPaper Elevation="0" Outlined="true" Class="ma-4 pa-4 rounded-lg">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6" Style="flex: 1; text-align: center;">@UIConstants.Level.PageTitle</MudText>
                    @if (_canCreate)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog">
                            @UIConstants.Level.AddButton
                        </MudButton>
                    }
                </MudStack>
            </MudPaper>

            @* ── Toolbar Section (bordered) ───────────────────────────────── *@
            <MudPaper Elevation="0" Outlined="true" Class="ma-4 pa-4 rounded-lg">
                <MudGrid>
                    <MudItem xs="4">
                        <MudTextField @bind-Value="_searchString"
                                      Placeholder="@UIConstants.Level.SearchPlaceholder"
                                      Label="Search"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Medium"
                                      Variant="Variant.Outlined"
                                      Clearable="true"
                                      Immediate="true"
                                      DebounceInterval="500"
                                      Dense="true"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudSelect T="bool"
                                   Value="@_statusFilter"
                                   ValueChanged="OnStatusFilterChanged"
                                   Variant="Variant.Outlined"
                                    Label="Status"
                                    Dense="true"
                                    FullWidth="true">
                            <MudSelectItem T="bool" Value="@(true)">@UIConstants.Common.Active</MudSelectItem>
                            <MudSelectItem T="bool" Value="@(false)">@UIConstants.Common.Inactive</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="4">
                        <TableSortControl SortBy="@_sortBy"
                                          SortDirection="@_sortDirection"
                                          SortColumns="@_sortableColumns"
                                          OnSortChanged="HandleSortChanged" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @* ── Data Grid Section (bordered) ─────────────────────────────── *@
            <MudPaper Elevation="0" Outlined="true" Class="mx-4 mb-4 rounded-lg">
                <MudDataGrid Items="@_levels"
                             QuickFilter="@QuickFilter"
                             Loading="@_loading"
                             SortMode="SortMode.None"
                             Hover="true"
                             Elevation="0"
                             Striped="true"
                             Dense="true">
                    <Columns>
                        <TemplateColumn Title="@UIConstants.Common.ColumnNo" Sortable="false">
                            <CellTemplate>
                                <span style="display: block; text-align: left;">@_rowNumbers.GetValueOrDefault(context.Item.Id)</span>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Code" Title="@UIConstants.Level.ColumnCode" />
                        <PropertyColumn Property="x => x.Name" Title="@UIConstants.Level.ColumnName" />
                        <PropertyColumn Property="x => x.Description" Title="@UIConstants.Common.Description" />
                        <TemplateColumn Title="@UIConstants.Common.Status">
                            <CellTemplate>
                                <MudChip Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                                         Size="Size.Small">
                                    @(context.Item.IsActive ? UIConstants.Common.Active : UIConstants.Common.Inactive)
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@UIConstants.Common.Actions" Sortable="false">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="0">
                                    @if (_canEdit)
                                    {
                                        <MudTooltip Text="Edit Level" Placement="Placement.Top">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => OpenEditDialog(context.Item))" />
                                        </MudTooltip>
                                    }
                                    @if (_canDelete)
                                    {
                                        <MudTooltip Text="Delete Level" Placement="Placement.Top">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => OpenDeleteDialog(context.Item))" />
                                        </MudTooltip>
                                    }
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                            <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                            <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Common.NoRecords</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@UIConstants.Level.NoDataFound</MudText>
                        </MudStack>
                    </NoRecordsContent>
                    <LoadingContent>
                        <MudStack Spacing="3" Class="w-100">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                        </MudStack>
                    </LoadingContent>
                    <PagerContent>
                        <MudDataGridPager T="LevelDto" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>

        </MudPaper>
    }
</MudContainer>

@code {
    // ── Dialog options (static: created once, reused for every dialog open) ──
    private static readonly DialogOptions _formDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private static readonly DialogOptions _confirmDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    // ── Permission fields ─────────────────────────────────────────────────────
    private bool _canView;
    private bool _canCreate;
    private bool _canEdit;
    private bool _canDelete;
    private bool _initialized;
    private bool _error;
    private string _errorMessage = string.Empty;

    // ── State ─────────────────────────────────────────────────────────────────
    private List<LevelDto> _allLevels = new();
    private List<LevelDto> _levels = new();
    private bool _loading = true;
    private string _searchString = string.Empty;
    private Dictionary<long, int> _rowNumbers = new();
    private bool _statusFilter = true;

    private string _sortBy = "Code";
    private string _sortDirection = "asc";
    private Dictionary<string, string> _sortableColumns = new()
  {
    { "Code", "Code" },
    { "Name", "Name" }
  };

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _canView = await PermService.HasPermissionAsync("LEVELS.VIEW");
            _canCreate = await PermService.HasPermissionAsync("LEVELS.CREATE");
            _canEdit = await PermService.HasPermissionAsync("LEVELS.EDIT");
            _canDelete = await PermService.HasPermissionAsync("LEVELS.DELETE");

            if (!_canView)
            {
                _error = true;
                _errorMessage = "You do not have permission to view levels.";
                return;
            }

            await LoadLevelsAsync();
        }
        finally
        {
            _initialized = true;
        }
    }

    // ── QuickFilter (runs client-side on every keystroke) ─────────────────────
    // Declared as a method, not a Func property, to avoid delegate allocation on every render.
    private bool QuickFilter(LevelDto x)
    {
        if (x.IsActive != _statusFilter)
            return false;

        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        return x.Code.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
          || x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    }

    // ── Data ──────────────────────────────────────────────────────────────────

     private async Task HandleSortChanged((string SortBy, string SortDirection) sortData)
    {
        _loading = true;
        await Task.Yield();

        _sortBy = sortData.SortBy;
        _sortDirection = sortData.SortDirection;

        _loading = false;
        ApplyFiltersAndSort();
    }

    /// <summary>Loads all levels from the API. Called on init and after every CUD operation.</summary>
     private async Task LoadLevelsAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var response = await LevelApiClient.GetAllAsync();
            if (response.Success && response.Data != null)
            {
                _allLevels = response.Data.ToList();
                ApplyFiltersAndSort();
            }

            else
                Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteLevelAsync(long id)
    {
        try
        {
            var response = await LevelApiClient.DeleteAsync(id);
            if (response.Success)
            {
                Snackbar.Add(LevelMsg.Deleted, Severity.Success);
                await LoadLevelsAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.DeleteFailed, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
    }

    // ── Dialogs ───────────────────────────────────────────────────────────────

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<LevelDialog>(
          UIConstants.Level.CreateDialogTitle, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(LevelMsg.Created, Severity.Success);
            await LoadLevelsAsync();
        }
    }

    private async Task OpenEditDialog(LevelDto level)
    {
        var parameters = new DialogParameters<LevelDialog>
    {
      { x => x.Level, level }
    };

        var dialog = await DialogService.ShowAsync<LevelDialog>(
          UIConstants.Level.EditDialogTitle, parameters, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(LevelMsg.Updated, Severity.Success);
            await LoadLevelsAsync();
        }
    }

    private async Task OpenDeleteDialog(LevelDto level)
    {
        var parameters = new DialogParameters<ConfirmDialog>
    {
      { x => x.ContentText, string.Format(UIConstants.Common.DeleteConfirmationFormat, level.Name) },
      { x => x.ButtonText, UIConstants.Common.Delete },
      { x => x.Color,   Color.Error }
    };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
          UIConstants.Level.DeleteDialogTitle, parameters, _confirmDialogOptions);

        if (await dialog.Result is { Canceled: false })
            await DeleteLevelAsync(level.Id);
    }

    private void ApplyFiltersAndSort()
    {
        if (!_allLevels.Any())
        {
            _levels = new();
            _rowNumbers = new();
            return;
        }

        var filteredList = _allLevels.Where(x => x.IsActive == _statusFilter).ToList();

        filteredList = _sortBy switch
        {
            "Name" => _sortDirection == "asc" ? filteredList.OrderBy(x => x.Name).ToList() : filteredList.OrderByDescending(x => x.Name).ToList(),
            _ => _sortDirection == "asc" ? filteredList.OrderBy(x => x.Code).ToList() : filteredList.OrderByDescending(x => x.Code).ToList(),
        };

        _levels = filteredList;

        _rowNumbers = filteredList
          .Select((x, i) => (x.Id, Index: i + 1))
          .ToDictionary(x => x.Id, x => x.Index);
    }

    private async Task OnStatusFilterChanged(bool value)
    {
        _statusFilter = value;
        _loading = true;
        await Task.Yield();
        ApplyFiltersAndSort();
        _loading = false;
    }
}