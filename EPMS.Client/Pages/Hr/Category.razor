@page "/hr/categories"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Shared
@using EPMS.Shared.DTOs.CategoryDTOs
@using EPMS.Shared.DTOs.Common
@using MudBlazor
@using Refit
@using static EPMS.Shared.Constants.ServiceResponseMessages

@inject ICategoryApiClient CategoryApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@UIConstants.Category.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.Category.PageTitle</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

        @* ── Toolbar ──────────────────────────────────────────────────── *@
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField @bind-Value="_searchString"
                          Placeholder="@UIConstants.Category.SearchPlaceholder"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Variant="Variant.Outlined"
                          Clearable="true"
                          Immediate="true"
                          DebounceInterval="500"
                          Style="max-width: 300px;" />

            <MudSelect T="bool"
                       Value="@_statusFilter"
                       ValueChanged="OnStatusFilterChanged"
                       Variant="Variant.Outlined"
                       Style="max-width: 150px;">
                <MudSelectItem T="bool" Value="@(true)">@UIConstants.Common.Active</MudSelectItem>
                <MudSelectItem T="bool" Value="@(false)">@UIConstants.Common.Inactive</MudSelectItem>
            </MudSelect>

            <TableSortControl SortBy="@_sortBy"
                              SortDirection="@_sortDirection"
                              SortColumns="@_sortableColumns"
                              OnSortChanged="HandleSortChanged" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                @UIConstants.Category.AddButton
            </MudButton>
        </MudStack>

        @* ── Data Grid ────────────────────────────────────────────────── *@
        <MudDataGrid Items="@_categories"
                     QuickFilter="@QuickFilter"
                     Loading="@_loading"
                     SortMode="SortMode.None"
                     Hover="true"
                     Elevation="0">
            <Columns>
                <TemplateColumn Title="@UIConstants.Common.ColumnNo" Sortable="false">
                    <CellTemplate>
                        <span style="display: block; text-align: left;">@_rowNumbers.GetValueOrDefault(context.Item.Id)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Code" Title="@UIConstants.Category.ColumnCode" />
                <PropertyColumn Property="x => x.Name" Title="@UIConstants.Category.ColumnName" />
                <PropertyColumn Property="x => x.ParentName" Title="Parent" />
                <PropertyColumn Property="x => x.Description" Title="@UIConstants.Common.Description" />
                <TemplateColumn Title="@UIConstants.Common.Status">
                    <CellTemplate>
                        <MudChip Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                                 Size="Size.Small">
                            @(context.Item.IsActive ? UIConstants.Common.Active : UIConstants.Common.Inactive)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@UIConstants.Common.Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="0">
                            <MudTooltip Text="Edit Category" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEditDialog(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete Category" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenDeleteDialog(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Common.NoRecords</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@UIConstants.Category.NoDataFound</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="CategoryDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>

@code {
    private static readonly DialogOptions _formDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private static readonly DialogOptions _confirmDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    private List<CategoryDto> _allCategories = new();
    private List<CategoryDto> _categories = new();
    private bool _loading = true;
    private string _searchString = string.Empty;
    private Dictionary<long, int> _rowNumbers = new();
    private bool _statusFilter = true;

    private string _sortBy = "Code";
    private string _sortDirection = "asc";
    private Dictionary<string, string> _sortableColumns = new()
    {
        { "Code", "Code" },
        { "Name", "Name" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private bool QuickFilter(CategoryDto x)
    {
        if (x.IsActive != _statusFilter)
            return false;

        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        return x.Code.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleSortChanged((string SortBy, string SortDirection) sortData)
    {
        _loading = true;
        await Task.Yield();

        _sortBy = sortData.SortBy;
        _sortDirection = sortData.SortDirection;

        _loading = false;
        ApplyFiltersAndSort();
    }

    private async Task LoadCategoriesAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var response = await CategoryApiClient.GetAllAsync();
            if (response.Success && response.Data != null)
            {
                _allCategories = response.Data.ToList();
                ApplyFiltersAndSort();
            }
            else
                Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteCategoryAsync(long id)
    {
        try
        {
            var response = await CategoryApiClient.DeleteAsync(id);
            if (response.Success)
            {
                Snackbar.Add(CategoryMsg.Deleted, Severity.Success);
                await LoadCategoriesAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.DeleteFailed, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CategoryDialog>(
            UIConstants.Category.CreateDialogTitle, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(CategoryMsg.Created, Severity.Success);
            await LoadCategoriesAsync();
        }
    }

    private async Task OpenEditDialog(CategoryDto category)
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.Category, category }
        };

        var dialog = await DialogService.ShowAsync<CategoryDialog>(
            UIConstants.Category.EditDialogTitle, parameters, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(CategoryMsg.Updated, Severity.Success);
            await LoadCategoriesAsync();
        }
    }

    private async Task OpenDeleteDialog(CategoryDto item)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, string.Format(UIConstants.Common.DeleteConfirmationFormat, item.Name) },
            { x => x.ButtonText, UIConstants.Common.Delete },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            UIConstants.Category.DeleteDialogTitle, parameters, _confirmDialogOptions);

        if (await dialog.Result is { Canceled: false })
            await DeleteCategoryAsync(item.Id);
    }

    private void ApplyFiltersAndSort()
    {
        if (!_allCategories.Any())
        {
            _categories = new();
            _rowNumbers = new();
            return;
        }

        var filteredList = _allCategories.Where(x => x.IsActive == _statusFilter).ToList();

        filteredList = _sortBy switch
        {
            "Name" => _sortDirection == "asc" ? filteredList.OrderBy(x => x.Name).ToList() : filteredList.OrderByDescending(x => x.Name).ToList(),
            _ => _sortDirection == "asc" ? filteredList.OrderBy(x => x.Code).ToList() : filteredList.OrderByDescending(x => x.Code).ToList(),
        };

        _categories = filteredList;

        _rowNumbers = filteredList
            .Select((x, i) => (x.Id, Index: i + 1))
            .ToDictionary(x => x.Id, x => x.Index);
    }

    private async Task OnStatusFilterChanged(bool value)
    {
        _statusFilter = value;
        _loading = true;
        await Task.Yield();
        ApplyFiltersAndSort();
        _loading = false;
    }
}
