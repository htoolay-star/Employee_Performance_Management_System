@using EPMS.Client.Models.Hr
@using EPMS.Shared.DTOs.TagDTOs
@using Mapster
@inject ITagApiClient TagApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model">
            <MudStack Spacing="3">
                <MudSelect T="string" @bind-Value="_model.Module" Label="Module" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("KPI")">KPI</MudSelectItem>
                    <MudSelectItem Value="@("HR")">HR</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_model.Name" Label="Tag Name"
                              Variant="Variant.Outlined"
                              Required="true"
                              For="@(() => _model.Name)" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@_saving">
            @(_saving ? "Saving..." : (IsEdit ? "Update" : "Create"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? _mudDialog { get; set; }
    [Parameter] public TagDto? Tag { get; set; }
    private bool IsEdit => Tag is not null;
    private MudForm? _form;
    private bool _saving;
    private TagFormModel _model = new();

    protected override void OnInitialized()
    {
        if (IsEdit) _model = Tag.Adapt<TagFormModel>();
    }

    private async Task Submit()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            SuccessResponse res;
            if (IsEdit)
            {
                var dto = new UpdateTagDto { Name = _model.Name, Module = _model.Module };
                res = await TagApiClient.UpdateAsync(Tag!.Id, dto);
            }
            else
            {
                var dto = new CreateTagDto { Name = _model.Name, Module = _model.Module };
                res = await TagApiClient.CreateAsync(dto);
            }

            if (res.Success)
            {
                Snackbar.Add("Tag saved successfully", MudBlazor.Severity.Success);
                _mudDialog?.Close(DialogResult.Ok(true));
            }
        }
        finally { _saving = false; }
    }

    private void Cancel() => _mudDialog?.Cancel();
}