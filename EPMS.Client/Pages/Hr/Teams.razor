@page "/hr/teams"
@* ═══════════════════════════════════════════════════════════════════════════
   PATTERN: ServerData + Prefetch + Filters
   Use this pattern when the dataset is large (hundreds to millions of rows).
   - Paging, filtering, and sorting are delegated to the server.
   - Dropdown data (Departments) is prefetched in the background on init.
   - Department filter and Status filter options.
   - After every CUD operation, calls RefreshDataAsync() to reload the page.
   ═══════════════════════════════════════════════════════════════════════════ *@
@using EPMS.Client.Constants
@using EPMS.Client.Services.Auth
@using EPMS.Client.Services.Hr
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.DepartmentDTOs
@using EPMS.Shared.DTOs.TeamDTOs
@using EPMS.Shared.Features.Teams
@using Mapster
@using MudBlazor
@using Refit
@using static EPMS.Shared.Constants.ServiceResponseMessages

@inject IDialogService DialogService
@inject ITeamApiClient TeamApiClient
@inject ISnackbar Snackbar
@inject LookupStateService LookupState

<PageTitle>@UIConstants.Team.PageTitle - EPMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.Team.PageTitle</MudText>

    <MudPaper Elevation="2" Class="pa-4">

        @* ── Toolbar ──────────────────────────────────────────────────── *@
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField T="string"
                          Value="@_searchString"
                          ValueChanged="@OnSearchChanged"
                          Immediate="true"
                          DebounceInterval="500"
                          Placeholder="@UIConstants.Team.SearchPlaceholder"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Style="max-width: 300px;" />

            <MudAutocomplete T="long?"
                       Value="@_departmentFilter"
                       ValueChanged="@OnDepartmentFilterChanged"
                       Placeholder="All Departments"
                       Clearable="true"
                       Variant="Variant.Outlined"
                       Style="max-width: 200px;"
                       SearchFunc="SearchFilterDepartments"
                       ToStringFunc="GetFilterDepartmentDisplay"
                       ResetValueOnEmptyText="true"
                       OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                <ItemTemplate Context="deptId">
                    @{ var dept = _departments.FirstOrDefault(x => x.Id == deptId); }
                    @if (dept != null)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText>@dept.Code</MudText>
                            @if (!dept.IsActive)
                            {
                                    <MudTooltip Text="This department is inactive" Placement="Placement.Right">
                                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                                    </MudTooltip>
                            }
                        </MudStack>
                    }
                </ItemTemplate>
            </MudAutocomplete>

            <MudSelect T="bool"
                       Value="@_statusFilter"
                       ValueChanged="OnStatusFilterChanged"
                       Placeholder="All Status"
                       Variant="Variant.Outlined"
                       Style="max-width: 150px;">
                <MudSelectItem T="bool" Value="@(true)">@UIConstants.Common.Active</MudSelectItem>
                <MudSelectItem T="bool" Value="@(false)">@UIConstants.Common.Inactive</MudSelectItem>
            </MudSelect>

            <TableSortControl SortBy="@_sortBy"
                              SortDirection="@_sortDirection"
                              SortColumns="@_sortableColumns"
                              OnSortChanged="OnSortChanged" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                @UIConstants.Team.AddButton
            </MudButton>
        </MudStack>

        @* ── Data Grid (server-side paging/sorting) ───────────────────── *@
        <MudDataGrid @ref="_dataGrid"
                     T="TeamGridItemDto"
                     ServerData="LoadServerDataAsync"
                     SortMode="SortMode.None"
                     Hover="true"
                     Striped="true"
                     Dense="true"
                     RowsPerPage="10">
            <Columns>
                @* RowIndex is computed server-side *@
                <TemplateColumn Title="@UIConstants.Common.ColumnNo" Sortable="false">
                    <CellTemplate>@context.Item.RowIndex</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Code" Title="@UIConstants.Team.ColumnCode" />
                <PropertyColumn Property="x => x.Name" Title="@UIConstants.Team.ColumnName" />
                <TemplateColumn Title="@UIConstants.Team.ColumnDepartment">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2">@context.Item.DepartmentCode</MudText>
                            
                            @if (!context.Item.DepartmentIsActive)
                            {
                                <MudTooltip Text="This Department is currently Inactive" Placement="Placement.Top">
                                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Description" Title="@UIConstants.Common.Description" />
                <PropertyColumn Property="x => x.LeadTeamName" Title="@UIConstants.Team.LeadColumn" />
                <TemplateColumn Title="@UIConstants.Common.Status" Sortable="false">
                    <CellTemplate>
                        <MudChip Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                                 Size="Size.Small">
                            @(context.Item.IsActive ? UIConstants.Common.Active : UIConstants.Common.Inactive)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@UIConstants.Common.Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenDeleteDialog(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Common.NoRecords</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@UIConstants.Position.NoDataFound</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="TeamGridItemDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>

@code {

    // Dialog options
    private static readonly DialogOptions _formDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private static readonly DialogOptions _confirmDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    // Grid state
    private MudDataGrid<TeamGridItemDto> _dataGrid = null!;
    private bool _isLoading = false;

    // Filters
    private string _searchString = string.Empty;
    private long? _departmentFilter;
    private bool _statusFilter = true;
    private string _sortBy = "Name";
    private string _sortDirection = "asc";

    private readonly Dictionary<string, string> _sortableColumns = new()
    {
        { "Code", "Code" },
        { "Name", "Name" }
    };

    private List<LookUpDto> _departments = new();

    protected override async Task OnInitializedAsync()
    {
        _departments = await LookupState.GetDepartmentsAsync();
        await base.OnInitializedAsync();
    }

    private async Task<GridData<TeamGridItemDto>> LoadServerDataAsync(GridState<TeamGridItemDto> state)
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var query = new TeamQueryParameters
            {
                PageNumber = state.Page + 1,
                PageSize = state.PageSize,
                SearchTerm = string.IsNullOrWhiteSpace(_searchString) ? null : _searchString.Trim(),
                DepartmentId = _departmentFilter,
                OrderBy = _sortBy,
                SortDirection = _sortDirection,
                IsActive = _statusFilter
            };

            var response = await TeamApiClient.GetPagedAsync(query);

            if (response.Success && response.Data != null)
            {
                return new GridData<TeamGridItemDto>
                {
                    Items = response.Data.Items,
                    TotalItems = response.Data.TotalCount
                };
            }

            Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        return new GridData<TeamGridItemDto> { Items = [], TotalItems = 0 };
    }

    // Filter handlers
    private async Task OnSearchChanged(string value)
    {
        _searchString = value;
        await RefreshDataAsync();
    }

    private async Task OnDepartmentFilterChanged(long? value)
    {
        _departmentFilter = value;
        await RefreshDataAsync();
    }

    private async Task OnStatusFilterChanged(bool value)
    {
        _statusFilter = value;
        await RefreshDataAsync();
    }

    private async Task OnSortChanged((string SortBy, string SortDirection) sort)
    {
        _sortBy = sort.SortBy;
        _sortDirection = sort.SortDirection;
        await RefreshDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    // Dialogs
    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<TeamDialog>(
            UIConstants.Team.CreateDialogTitle, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(TeamMsg.Created, Severity.Success);
            await RefreshDataAsync();
        }
    }

    private async Task OpenEditDialog(TeamGridItemDto item)
    {
        var parameters = new DialogParameters<TeamDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Team, item.Adapt<TeamDto>() }
        };

        var dialog = await DialogService.ShowAsync<TeamDialog>(
            UIConstants.Team.EditDialogTitle, parameters, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(TeamMsg.Updated, Severity.Success);
            await RefreshDataAsync();
        }
    }

    private async Task OpenDeleteDialog(TeamGridItemDto team)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, string.Format(UIConstants.Common.DeleteConfirmationFormat, team.Name) },
            { x => x.ButtonText, UIConstants.Common.Delete },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            UIConstants.Team.DeleteDialogTitle, parameters, _confirmDialogOptions);

        if (await dialog.Result is { Canceled: false })
            await DeleteTeamAsync(team.Id);
    }

    private async Task DeleteTeamAsync(long id)
    {
        try
        {
            var response = await TeamApiClient.DeleteAsync(id);
            if (response.Success)
            {
                LookupState.ClearTeamCache();
                Snackbar.Add(TeamMsg.Deleted, Severity.Success);
                await RefreshDataAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.DeleteFailed, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
    }


    private Task<IEnumerable<long?>> SearchFilterDepartments(string value, CancellationToken token)
    {
        var query = _departments.AsQueryable();
        
        if (!string.IsNullOrWhiteSpace(value))
        {
            query = query.Where(x => x.Code.Contains(value, StringComparison.OrdinalIgnoreCase));
        }
        
        return Task.FromResult(query.Select(x => (long?)x.Id).AsEnumerable());
    }

    private string GetFilterDepartmentDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var dept = _departments.FirstOrDefault(x => x.Id == id);
        if (dept == null) return string.Empty;
        return dept.IsActive ? dept.Code : $"{dept.Code} (Inactive)";
    }
}