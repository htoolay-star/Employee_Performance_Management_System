@* ═══════════════════════════════════════════════════════════════════════════
   PositionDialog — Create / Edit dialog for the Position entity.
   Supports PreloadedLevels passed from the parent page (Positions.razor).
   If PreloadedLevels is null or empty, falls back to loading levels itself.
   ═══════════════════════════════════════════════════════════════════════════ *@
@using EPMS.Client.Constants
@using EPMS.Client.Extensions
@using EPMS.Client.Models.Hr
@using EPMS.Client.Services
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.LevelDTOs
@using EPMS.Shared.DTOs.PositionDTOs
@using EPMS.Shared.Validators.PositionDTOs
@using Mapster
@using MudBlazor

@inject ILevelApiClient LevelApiClient
@inject IPositionApiClient PositionApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model" Validation="@ValidateField">
            <MudStack Spacing="3">

                <MudTextField @bind-Value="_model.Title"
                              Label="@UIConstants.Position.TitleLabel"
                              For="@(() => _model.Title)"
                              Variant="Variant.Outlined" />

                @* {{!-- Level select: shows a spinner while levels are loading --}} *@
                <MudSelect T="long?"
                           @bind-Value="_model.LevelId"
                           Label="@UIConstants.Position.LevelLabel"
                           Placeholder="@UIConstants.Position.SelectLevelPlaceholder"
                           For="@(() => _model.LevelId)"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    @foreach (var level in AvailableLevels)
                    {
                        long? currentLevelId = level.Id;
                        <MudSelectItem T="long?" Value="@currentLevelId">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText>@level.Name</MudText>
                                @if (!level.IsActive)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ml-auto">
                                        Inactive
                                    </MudChip>
                                }
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>

                @* {{!-- IsActive toggle: only shown on Edit --}} *@
                @if (IsEdit)
                {
                    <MudSwitch @bind-Value="_model.IsActive"
                               Label="@UIConstants.Common.Active"
                               Color="Color.Success" />
                }

            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@UIConstants.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   OnClick="Submit"
                   Disabled="@(_saving || !HasChanged())">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsEdit ? UIConstants.Common.Update : UIConstants.Common.Create)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    // ── Parameters ────────────────────────────────────────────────────────────
    [CascadingParameter] private IMudDialogInstance? _mudDialog { get; set; }

    /// <summary>Pass a PositionDto to open in Edit mode. Leave null for Create mode.</summary>
    [Parameter] public PositionDto? Position { get; set; }

    // ── Computed ──────────────────────────────────────────────────────────────
    private bool IsEdit => Position is not null;

    // ── State ─────────────────────────────────────────────────────────────────
    private MudForm? _form;
    private bool _saving;
    private List<LevelLookupDto> _levels = new();

    private IEnumerable<LevelLookupDto> AvailableLevels =>
        _levels.Where(x => x.IsActive || (IsEdit && x.Id == Position!.LevelId));

    private PositionFormModel _model = new();
    private Dictionary<string, string> _serverErrors = new();

    // Validators instantiated once; no need to recreate per render.
    private readonly CreatePositionDtoValidator _createValidator = new();
    private readonly UpdatePositionDtoValidator _updateValidator = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        if (Position is not null)
            _model = Position.Adapt<PositionFormModel>();

        await LoadLevelsAsync();

        await base.OnInitializedAsync();
    }

    // ── Data ──────────────────────────────────────────────────────────────────

    private async Task LoadLevelsAsync()
    {
        try
        {
            var response = await LevelApiClient.GetLookupAsync();
            if (response.Success && response.Data != null)
                _levels = response.Data.ToList();
            else
                Snackbar.Add(UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (Refit.ApiException)
        {
            Snackbar.Add(UIConstants.Common.LoadFailed, Severity.Error);
        }
        finally
        {
            StateHasChanged(); // Required: this runs outside the normal render cycle (fire-and-forget).
        }
    }

    // ── Actions ───────────────────────────────────────────────────────────────

    private async Task Submit()
    {
        // 1. Clear previous server errors so stale messages don't block submission.
        _serverErrors.Clear();

        // 2. Run client-side validation.
        await _form!.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add(UIConstants.Common.ValidationFailed, Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (IsEdit)
            {
                var dto = _model.Adapt<UpdatePositionDto>();
                var response = await PositionApiClient.UpdateAsync(Position!.Id, dto);

                if (response.Success)
                    _mudDialog?.Close(DialogResult.Ok(true));
                else
                    Snackbar.Add(response.Message ?? UIConstants.Common.UpdateFailed, Severity.Error);
            }
            else
            {
                var dto = _model.Adapt<CreatePositionDto>();
                var response = await PositionApiClient.CreateAsync(dto);

                if (response.Success)
                    _mudDialog?.Close(DialogResult.Ok(true));
                else
                    Snackbar.Add(response.Message ?? UIConstants.Common.CreateFailed, Severity.Error);
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ValidationFailed, Severity.Error);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            // Surface the conflict as an inline field error, not just a snackbar.
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            _serverErrors[nameof(_model.Title)] = error?.Message ?? UIConstants.Common.DuplicateEntry;
            await _form!.Validate(); // re-run so the field picks up the server error
            // No extra StateHasChanged() needed: _form.Validate() already triggers a re-render.
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => _mudDialog?.Cancel();

    // ── Validation ────────────────────────────────────────────────────────────

    /// <summary>
    /// Bridges MudForm's field-level validation callback to the appropriate
    /// FluentValidation validator, mapping through the form model → DTO.
    /// </summary>
    private async Task<IEnumerable<string>> ValidateField(object model, string propertyName)
    {
        IEnumerable<string> fluentErrors;

        if (IsEdit)
        {
            var fn = _updateValidator.ValidateMappedValue<PositionFormModel, UpdatePositionDto>(_model, _serverErrors);
            fluentErrors = await fn(model, propertyName);
        }
        else
        {
            var fn = _createValidator.ValidateMappedValue<PositionFormModel, CreatePositionDto>(_model, _serverErrors);
            fluentErrors = await fn(model, propertyName);
        }

        var errorList = fluentErrors.ToList();

        if (_serverErrors.TryGetValue(propertyName, out var serverError))
        {
            errorList.Add(serverError);
        }

        return errorList;
    }

    private bool HasChanged()
    {
        if (!IsEdit) return true;

        return _model.Title != Position!.Title ||
               _model.LevelId != Position.LevelId ||
               _model.IsActive != Position.IsActive;
    }
}
