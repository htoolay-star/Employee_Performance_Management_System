@page "/hr/tags"
@using EPMS.Shared.DTOs.TagDTOs
@inject ITagApiClient TagApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h4">Tags Management</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="OpenCreateDialog" StartIcon="@Icons.Material.Filled.Add">
            Add Tag
        </MudButton>
    </MudStack>

    <MudPaper Outlined="true" Class="pa-4">
        <MudTextField @bind-Value="_searchString" Placeholder="Search by Tag Name or Module..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium" Class="mt-0 mb-4" Immediate="true" Variant="Variant.Outlined" />

        <MudDataGrid Items="@_tags" Loading="_loading" Bordered="true" Dense="true" QuickFilter="SearchFilter">
            <Columns>
                <TemplateColumn Title="No." HeaderStyle="width:80px;">
                    <CellTemplate>
                        @_rowNumbers.GetValueOrDefault(context.Item.Id)
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Name" Title="Tag Name" />
                <PropertyColumn Property="x => x.Module" Title="Module" />

                <TemplateColumn Title="Actions">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                       OnClick="@(() => OpenEditDialog(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                       OnClick="@(() => OpenDeleteDialog(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="TagDto" /></PagerContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

@code {
    private List<TagDto> _tags = new();
    private bool _loading = true;
    private string _searchString = "";
    private Dictionary<long, int> _rowNumbers = new();

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _loading = true;
        var res = await TagApiClient.GetAllAsync();
        if (res.Success)
        {
            _tags = res.Data.ToList();
            RefreshRowNumbers();
        }
        _loading = false;
    }

    private bool SearchFilter(TagDto x)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;

        bool match = x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                     x.Module.Contains(_searchString, StringComparison.OrdinalIgnoreCase);

        return match;
    }

    private void RefreshRowNumbers()
    {
        _rowNumbers = _tags
            .Select((x, i) => new { x.Id, Index = i + 1 })
            .ToDictionary(x => x.Id, x => x.Index);
    }

    private async Task OpenCreateDialog()
    {
        var dial = await DialogService.ShowAsync<TagDialog>("Create New Tag");
        if (!(await dial.Result).Canceled) await LoadDataAsync();
    }

    private async Task OpenEditDialog(TagDto item)
    {
        var parameters = new DialogParameters { ["Tag"] = item };
        var dial = await DialogService.ShowAsync<TagDialog>("Edit Tag", parameters);
        if (!(await dial.Result).Canceled) await LoadDataAsync();
    }

    private async Task OpenDeleteDialog(TagDto item)
    {
        var parameters = new DialogParameters<ConfirmDialog>
    {
        { x => x.ContentText, $"Are you sure you want to delete tag '{item.Name}'?" },
        { x => x.ButtonText, "Delete" },
        { x => x.Color, Color.Error }
    };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Confirmation", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var res = await TagApiClient.DeleteAsync(item.Id);
            if (res.Success)
            {
                Snackbar.Add("Tag deleted successfully", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add(res.Message ?? "Delete failed", Severity.Error);
            }
        }
    }
}
