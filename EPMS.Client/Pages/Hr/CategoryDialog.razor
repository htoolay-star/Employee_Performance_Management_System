@using EPMS.Client.Constants
@using EPMS.Client.Models.Hr
@using EPMS.Client.Services
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.CategoryDTOs
@using EPMS.Shared.Validators.CategoryDTOs
@using FluentValidation
@using Mapster
@using MudBlazor

@inject ICategoryApiClient CategoryApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model" Validation="@ValidateField">
            <MudStack Spacing="3">
                <MudSelect T="string" @bind-Value="_model.Module" Label="Module" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("KPI")">KPI</MudSelectItem>
                    <MudSelectItem Value="@("HR")">HR</MudSelectItem>
                </MudSelect>

                @if (!IsEdit)
                {
                    <MudTextField @bind-Value="_model.Code" Label="Code" Variant="Variant.Outlined" For="@(() => _model.Code)" />
                }

                <MudTextField @bind-Value="_model.Name" Label="Name" Variant="Variant.Outlined" For="@(() => _model.Name)" />
                <MudTextField @bind-Value="_model.Description" Label="Description" Variant="Variant.Outlined" Lines="3" />

                <MudSelect T="long?" @bind-Value="_model.ParentId" Label="Parent Category" Variant="Variant.Outlined" Clearable="true">
                    <MudSelectItem T="long?" Value="null">None (Root)</MudSelectItem>

                    
                    @foreach (var p in _parents.Where(x => (!IsEdit || x.Id != Category?.Id) && x.IsActive))
                    {
                        <MudSelectItem T="long?" Value="@p.Id">@($"{p.Code} - {p.Name}")</MudSelectItem>
                    }
                </MudSelect>

                @if (IsEdit)
                {
                    @* bind-Value က _model.IsActive နဲ့ တိုက်ရိုက်ချိတ်ထားရပါမယ် *@
                    <MudSwitch @bind-Value="_model.IsActive"
                               Label="@(_model.IsActive ? "Active" : "Inactive")"
                               Color="Color.Success" />
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(_saving || !HasChanged())">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? _mudDialog { get; set; }
    [Parameter] public CategoryDto? Category { get; set; }
    private bool IsEdit => Category is not null;
    private MudForm? _form;
    private bool _saving;
    private CategoryFormModel _model = new();
    private List<LookUpDto> _parents = new();
    private Dictionary<string, string> _serverErrors = new();

    private readonly CreateCategoryDtoValidator _createValidator = new();
    private readonly UpdateCategoryDtoValidator _updateValidator = new();

    protected override async Task OnInitializedAsync()
    {
        if (Category is not null)
        {
            _model = Category.Adapt<CategoryFormModel>();
        }
        await LoadParentsAsync();
    }

    private async Task LoadParentsAsync()
    {
        var res = await CategoryApiClient.GetLookupAsync();
        if (res.Success)
        {
            _parents = res.Data.ToList();
        }
    }

    private async Task Submit()
    {
        _serverErrors.Clear();
        await _form!.Validate();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            SuccessResponse res;
            if (IsEdit)
            {
                var updateDto = new UpdateCategoryDto
                {
                    Name = _model.Name,
                    Description = _model.Description,
                    ParentId = _model.ParentId,
                    IsActive = _model.IsActive 
                };
                res = await CategoryApiClient.UpdateAsync(Category!.Id, updateDto);
            }
            else
            {
                var createDto = _model.Adapt<CreateCategoryDto>();
                var createRes = await CategoryApiClient.CreateAsync(createDto);
                res = createRes;
            }

            if (res.Success)
            {
                Snackbar.Add("Saved successfully", MudBlazor.Severity.Success);
                _mudDialog?.Close(DialogResult.Ok(true));
            }
        }
        finally { _saving = false; }
    }

    private void Cancel() => _mudDialog?.Cancel();
    private async Task<IEnumerable<string>> ValidateField(object m, string p)
    {
        var result = IsEdit
            ? await _updateValidator.ValidateAsync(ValidationContext<UpdateCategoryDto>.CreateWithOptions((UpdateCategoryDto)m.Adapt<UpdateCategoryDto>(), x => x.IncludeProperties(p)))
            : await _createValidator.ValidateAsync(ValidationContext<CreateCategoryDto>.CreateWithOptions((CreateCategoryDto)m.Adapt<CreateCategoryDto>(), x => x.IncludeProperties(p)));

        return result.Errors.Select(e => e.ErrorMessage);
    }
    private bool HasChanged()
    {
        if (!IsEdit) return true;

        return _model.Code != Category!.Code ||
               _model.Name != Category.Name ||
               _model.Description != Category.Description ||
               _model.IsActive != Category.IsActive ||
               _model.ParentId != Category.ParentId;
    } // Simplified for brevity
}