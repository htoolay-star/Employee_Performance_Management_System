@using EPMS.Client.Constants
@using EPMS.Client.Extensions
@using EPMS.Client.Models.Hr
@using EPMS.Client.Services.Auth
@using EPMS.Client.Services.Hr
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.DepartmentDTOs
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using EPMS.Shared.DTOs.TeamDTOs
@using EPMS.Shared.Validators.TeamDTOs
@using Mapster
@using MudBlazor

    @inject ITeamApiClient TeamApiClient
    @inject ISnackbar Snackbar
    @inject LookupStateService LookupState

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model" Validation="@ValidateField">
            <MudStack Spacing="3">

                @if (!IsEdit)
                {
                    
                    <MudTextField @bind-Value="_model.Code"
                                  Label="@UIConstants.Team.CodeLabel"
                                  For="@(() => _model.Code)"
                                  Variant="Variant.Outlined" />
                }

                <MudTextField @bind-Value="_model.Name"
                              Label="@UIConstants.Team.NameLabel"
                              For="@(() => _model.Name)"
                              Variant="Variant.Outlined" />


                <MudTextField @bind-Value="_model.Description"
                              Label="@UIConstants.Common.Description"
                              For="@(() => _model.Description)"
                              Variant="Variant.Outlined"
                              Lines="3" />

                @if (ShowDepartment)
                {
                    <MudAutocomplete T="long?"
                               @bind-Value="_model.DepartmentId"
                               Label="@UIConstants.Team.DepartmentLabel"
                               Placeholder="@UIConstants.Team.SelectDepartmentPlaceholder"
                               For="@(() => _model.DepartmentId)"
                               Variant="Variant.Outlined"
                               Clearable="true"
                                SearchFunc="SearchDepartments"
                                ToStringFunc="GetDepartmentDisplay"
                                ResetValueOnEmptyText="true"
                                OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                        <ItemTemplate Context="deptId">
                            @{ var dept = AvailableDepartments.FirstOrDefault(x => x.Id == deptId); }
                            @if (dept != null)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText>@dept.Name</MudText>
                                    @if (!dept.IsActive)
                                    {
                                            <MudTooltip Text="This department is inactive" Placement="Placement.Right">
                                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                                            </MudTooltip>
                                    }
                                </MudStack>
                            }
                        </ItemTemplate>
                    </MudAutocomplete>
                }

                <MudAutocomplete T="long?"
                           Label="Position"
                           @bind-Value="_selectedPositionId"
                           Placeholder="Select position to filter employees"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           SearchFunc="SearchPositions"
                           ToStringFunc="GetPositionDisplay"
                           ResetValueOnEmptyText="true"
                           OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                    <ItemTemplate Context="posId">
                        @{ var pos = _positions.FirstOrDefault(x => x.Id == posId); }
                        @if (pos != null)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText>@pos.Name</MudText>
                                @if (!pos.IsActive)
                                {
                                    <MudTooltip Text="This position is inactive" Placement="Placement.Right">
                                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                                    </MudTooltip>
                                }
                            </MudStack>
                        }
                    </ItemTemplate>
                </MudAutocomplete>

                <MudAutocomplete T="long?"
                           @bind-Value="_model.LeadTeamId"
                           Label="Team Lead"
                           Placeholder="Select team lead"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           SearchFunc="SearchEmployees"
                           ToStringFunc="GetEmployeeDisplay"
                           ResetValueOnEmptyText="true"
                           OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                    <ItemTemplate Context="empId">
                        @{ var emp = AvailableEmployees.FirstOrDefault(x => x.Id == empId); }
                        @if (emp != null)
                        {
                            <MudText>@emp.StaffNo - @emp.StaffName</MudText>
                        }
                    </ItemTemplate>
                </MudAutocomplete>

                @if (IsEdit)
                {
                    <MudSwitch @bind-Value="_model.IsActive"
                               Label="@UIConstants.Common.Active"
                               Color="Color.Success" />
                }

            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@UIConstants.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   OnClick="Submit"
                   Disabled="@(_saving || !HasChanged())">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsEdit ? UIConstants.Common.Update : UIConstants.Common.Create)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance? _mudDialog { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public TeamDto? Team { get; set; }

    [Parameter]
    public bool ShowDepartment { get; set; } = true;

    [Parameter]
    public long? SelectedDepartmentId { get; set; }

    private MudForm? _form;
    private bool _saving;
    private List<LookUpDto> _departments = new();
    private List<LookUpDto> _positions = new();
    private List<EmployeeLookupDto> _allEmployees = new();
    private long? _selectedPositionId;
    private Dictionary<string, string> _serverErrors = new();

    private readonly CreateTeamDtoValidator _createValidator = new();
    private readonly UpdateTeamDtoValidator _updateValidator = new();

    // Filter departments: show active only, or include current if editing and it's inactive
    private IEnumerable<LookUpDto> AvailableDepartments =>
        _departments.Where(x => x.IsActive || (IsEdit && x.Id == Team!.DepartmentId));

    private IEnumerable<EmployeeLookupDto> AvailableEmployees =>
        _allEmployees.Where(x => !_selectedPositionId.HasValue || x.PositionId == _selectedPositionId.Value);

    private TeamFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        if (Team is not null)
            _model = Team.Adapt<TeamFormModel>();

        _departments = await LookupState.GetDepartmentsAsync();
        _positions = await LookupState.GetPositionsAsync();
        _allEmployees = await LookupState.GetEmployeesAsync();

        if (_model.LeadTeamId.HasValue)
        {
            var currentLead = _allEmployees.FirstOrDefault(x => x.Id == _model.LeadTeamId.Value);
            if (currentLead?.PositionId.HasValue == true)
                _selectedPositionId = currentLead.PositionId;
        }

        if (!ShowDepartment && SelectedDepartmentId.HasValue)
        {
            _model.DepartmentId = SelectedDepartmentId.Value;
        }

        await base.OnInitializedAsync();
    }

    private async Task Submit()
    {
        _serverErrors.Clear();

        await _form!.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add(UIConstants.Common.ValidationFailed, Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (IsEdit && Team is not null)
            {
                var dto = _model.Adapt<UpdateTeamDto>();
                var response = await TeamApiClient.UpdateAsync(Team.Id, dto);

                if (response.Success)
                {
                    LookupState.ClearTeamCache();
                    _mudDialog?.Close(DialogResult.Ok(true));
                }
                else
                    Snackbar.Add(response.Message ?? UIConstants.Common.UpdateFailed, Severity.Error);
            }
            else
            {
                var dto = _model.Adapt<CreateTeamDto>();
                var response = await TeamApiClient.CreateAsync(dto);

                if (response.Success)
                {
                    LookupState.ClearTeamCache();
                    _mudDialog?.Close(DialogResult.Ok(true));
                }
                else
                    Snackbar.Add(response.Message ?? UIConstants.Common.CreateFailed, Severity.Error);
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ValidationFailed, Severity.Error);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            _serverErrors[nameof(_model.Name)] = error?.Message ?? UIConstants.Common.DuplicateEntry;
            await _form!.Validate();
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => _mudDialog?.Cancel();

    private async Task<IEnumerable<string>> ValidateField(object model, string propertyName)
    {
        IEnumerable<string> fluentErrors;

        if (IsEdit)
        {
            var fn = _updateValidator.ValidateMappedValue<TeamFormModel, UpdateTeamDto>(_model, _serverErrors);
            fluentErrors = await fn(model, propertyName);
        }
        else
        {
            var fn = _createValidator.ValidateMappedValue<TeamFormModel, CreateTeamDto>(_model, _serverErrors);
            fluentErrors = await fn(model, propertyName);
        }

        var errorList = fluentErrors.ToList();

        if (_serverErrors.TryGetValue(propertyName, out var serverError))
        {
            errorList.Add(serverError);
        }

        return errorList;
    }

    private bool HasChanged()
    {
        if (!IsEdit || Team == null) return true;

        return _model.Code != Team.Code ||
               _model.Name != Team.Name ||
               _model.DepartmentId != Team.DepartmentId ||
               _model.LeadTeamId != Team.LeadTeamId ||
               _model.Description != Team.Description ||
               _model.IsActive != Team.IsActive;
    }

    private Task<IEnumerable<long?>> SearchPositions(string value, CancellationToken token)
    {
        var query = _positions.AsQueryable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).AsEnumerable());
    }

    private string GetPositionDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var pos = _positions.FirstOrDefault(x => x.Id == id);
        return pos?.Name ?? string.Empty;
    }

    private Task<IEnumerable<long?>> SearchEmployees(string value, CancellationToken token)
    {
        var query = AvailableEmployees.AsQueryable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.StaffNo.Contains(value) || x.StaffName.Contains(value));
        return Task.FromResult(query.Select(x => (long?)x.Id).AsEnumerable());
    }

    private string GetEmployeeDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var emp = _allEmployees.FirstOrDefault(x => x.Id == id);
        return emp != null ? $"PM: {emp.StaffNo} - {emp.StaffName}" : string.Empty;
    }

    private async Task<IEnumerable<long?>> SearchDepartments(string value, CancellationToken token)
    {
        await Task.Yield();

        if (string.IsNullOrWhiteSpace(value))
            return AvailableDepartments.Select(x => (long?)x.Id).ToList();

        return AvailableDepartments
            .Where(x => x.Name != null && x.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(x => (long?)x.Id)
            .ToList();
    }

    private string GetDepartmentDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var dept = AvailableDepartments.FirstOrDefault(x => x.Id == id);
        if (dept == null) return string.Empty;
        
        return dept.IsActive ? dept.Name : $"{dept.Name} (Inactive)";
    }
}