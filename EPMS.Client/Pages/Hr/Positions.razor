@page "/hr/positions"
@* ═══════════════════════════════════════════════════════════════════════════
   PATTERN: ServerData + Prefetch
   Use this pattern when the dataset is large (hundreds to millions of rows).
   - Paging, filtering, and sorting are delegated to the server.
   - Dropdown data (Levels) is prefetched in the background on init so dialogs
     open instantly without waiting for a second API call.
   - After every CUD operation, calls RefreshDataAsync() which reloads only
     the current page from the server (no full list reload).
   ═══════════════════════════════════════════════════════════════════════════ *@
@using EPMS.Client.Constants
@using EPMS.Client.Services.Auth
@using EPMS.Client.Services.Hr
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.LevelDTOs
@using EPMS.Shared.DTOs.PositionDTOs
@using EPMS.Shared.Features.Positions
@using Mapster
@using MudBlazor
@using Refit
@using static EPMS.Shared.Constants.ServiceResponseMessages

@inject IDialogService DialogService
@inject IPositionApiClient PositionApiClient
@inject ISnackbar Snackbar
@inject LookupStateService LookupState

<PageTitle>@UIConstants.Position.PageTitle - EPMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.Position.PageTitle</MudText>

    <MudPaper Elevation="2" Class="pa-4">

        @* ── Toolbar ──────────────────────────────────────────────────── *@
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField T="string"
                          Value="@_searchString"
                          ValueChanged="@OnSearchChanged"
                          Immediate="true"
                          DebounceInterval="500"
                          Placeholder="@UIConstants.Position.SearchPlaceholder"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Style="max-width: 300px;" />

            <MudAutocomplete T="long?"
                       Value="@_levelFilter"
                       ValueChanged="@OnLevelFilterChanged"
                       Placeholder="All Levels"
                       Clearable="true"
                       Variant="Variant.Outlined"
                       Style="max-width: 200px;"
                       SearchFunc="SearchFilterLevels"
                       ToStringFunc="GetFilterLevelDisplay"
                       ResetValueOnEmptyText="true"
                       OpenIcon="@Icons.Material.Filled.ArrowDropDown">
            <ItemTemplate Context="levelId">
                @{ var level = _levels.FirstOrDefault(x => x.Id == levelId); }
                @if (level != null)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText>@level.Code</MudText>
                        @if (!level.IsActive)
                        {
                                <MudTooltip Text="This level is inactive" Placement="Placement.Right">
                                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                                </MudTooltip>
                        }
                    </MudStack>
                }
            </ItemTemplate>
            </MudAutocomplete>

            <MudSelect T="bool"
                       Value="@_statusFilter"
                       ValueChanged="OnStatusFilterChanged"
                       Placeholder="All Status"
                       Variant="Variant.Outlined"
                       Style="max-width: 180px;">
                <MudSelectItem T="bool" Value="@(true)">@UIConstants.Common.Active</MudSelectItem>
                <MudSelectItem T="bool" Value="@(false)">@UIConstants.Common.Inactive</MudSelectItem>
            </MudSelect>

            <TableSortControl SortBy="@_sortBy"
                              SortDirection="@_sortDirection"
                              SortColumns="@_sortableColumns"
                              OnSortChanged="OnSortChanged" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                @UIConstants.Position.AddButton
            </MudButton>
        </MudStack>

        @* {{!-- ── Data Grid (server-side paging/sorting) ───────────────────── --}} *@
        <MudDataGrid @ref="_dataGrid"
                     T="PositionGridItemDto"
                     ServerData="LoadServerDataAsync"
                     SortMode="SortMode.None"
                     Hover="true"
                     Striped="true"
                     Dense="true"
                     RowsPerPage="10">
            <Columns>
                @* {{!-- RowIndex is computed server-side: (page - 1) * pageSize + rowNum --}} *@
                <TemplateColumn Title="@UIConstants.Common.ColumnNo" Sortable="false">
                    <CellTemplate><span style="display: block; text-align: right;">@context.Item.RowIndex</span></CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Code" Title="@UIConstants.Position.ColumnCode" />
                <PropertyColumn Property="x => x.Name" Title="@UIConstants.Position.ColumnName" />
                <TemplateColumn Title="@UIConstants.Position.ColumnLevel">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2">@context.Item.LevelCode</MudText>
                
                            @if (!context.Item.LevelIsActive)
                            {
                                <MudTooltip Text="This Level is currently Inactive" Placement="Placement.Top">
                                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Description" Title="@UIConstants.Common.Description" />
                <TemplateColumn Title="@UIConstants.Common.Status" Sortable="false">
                    <CellTemplate>
                        <MudChip Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                                 Size="Size.Small">
                            @(context.Item.IsActive ? UIConstants.Common.Active : UIConstants.Common.Inactive)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@UIConstants.Common.Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenDeleteDialog(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Common.NoRecords</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@UIConstants.Position.NoDataFound</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="PositionGridItemDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>

@code {

    // ── Dialog options (static: created once, reused for every dialog open) ──
    private static readonly DialogOptions _formDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private static readonly DialogOptions _confirmDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    // ── Grid state ────────────────────────────────────────────────────────────
    private MudDataGrid<PositionGridItemDto> _dataGrid = null!;
    private bool _isLoading = false;
    private bool _statusFilter = true;
    private long? _levelFilter;

    // ── Search / sort state ───────────────────────────────────────────────────
    private string _searchString = string.Empty;
    private string _sortBy = "Name";
    private string _sortDirection = "asc";

    private readonly Dictionary<string, string> _sortableColumns = new()
    {
        { "Name", "Name" },
        { "Code", "Code" }
    };

    // ── Prefetched dropdown data ───────────────────────────────────────────────
    private List<LookUpDto> _levels = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    private async Task OnStatusFilterChanged(bool value)
    {
        _statusFilter = value;
        await RefreshDataAsync();
    }

    private async Task OnLevelFilterChanged(long? value)
    {
        _levelFilter = value;
        await RefreshDataAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _levels = await LookupState.GetLevelsAsync();
        await base.OnInitializedAsync();
    }

    // ── Server data callback (called by MudDataGrid on every page/sort change) ─

    private async Task<GridData<PositionGridItemDto>> LoadServerDataAsync(
        GridState<PositionGridItemDto> state)
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var query = new PositionQueryParameters
            {
                PageNumber = state.Page + 1,
                PageSize = state.PageSize,
                SearchTerm = string.IsNullOrWhiteSpace(_searchString) ? null : _searchString.Trim(),
                LevelId = _levelFilter,
                OrderBy = _sortBy,
                SortDirection = _sortDirection,
                IsActive = _statusFilter
            };

            var response = await PositionApiClient.GetPagedAsync(query);

            if (response.Success && response.Data != null)
                return new GridData<PositionGridItemDto>
                {
                    Items = response.Data.Items,
                    TotalItems = response.Data.TotalCount
                };

            Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        return new GridData<PositionGridItemDto> { Items = [], TotalItems = 0 };
    }

    // ── Toolbar event handlers ─────────────────────────────────────────────────

    private async Task OnSearchChanged(string value)
    {
        _searchString = value;
        await RefreshDataAsync();
    }

    private async Task OnSortChanged((string SortBy, string SortDirection) sort)
    {
        _sortBy = sort.SortBy;
        _sortDirection = sort.SortDirection;
        await RefreshDataAsync();
    }

    /// <summary>Reloads the current page from the server. Lighter than a full page reload.</summary>
    private async Task RefreshDataAsync()
    {
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    // ── Dialogs ───────────────────────────────────────────────────────────────

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<PositionDialog>(
            UIConstants.Position.CreateDialogTitle, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(PositionMsg.Created, Severity.Success);
            await RefreshDataAsync();
        }
    }

    private async Task OpenEditDialog(PositionGridItemDto item)
    {
        var parameters = new DialogParameters<PositionDialog>
        {
            { x => x.Position, item.Adapt<PositionDto>() }
        };

        var dialog = await DialogService.ShowAsync<PositionDialog>(
            UIConstants.Position.EditDialogTitle, parameters, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(PositionMsg.Updated, Severity.Success);
            await RefreshDataAsync();
        }
    }

    private async Task OpenDeleteDialog(PositionGridItemDto position)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, string.Format(UIConstants.Common.DeleteConfirmationFormat, position.Name) },
            { x => x.ButtonText,  UIConstants.Common.Delete },
            { x => x.Color,       Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            UIConstants.Position.DeleteDialogTitle, parameters, _confirmDialogOptions);

        if (await dialog.Result is { Canceled: false })
            await DeletePositionAsync(position.Id);
    }

    private async Task DeletePositionAsync(long id)
    {
        try
        {
            var response = await PositionApiClient.DeleteAsync(id);
            if (response.Success)
            {
                LookupState.ClearPositionCache();
                Snackbar.Add(PositionMsg.Deleted, Severity.Success);
                await RefreshDataAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.DeleteFailed, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
    }

    private Task<IEnumerable<long?>> SearchFilterLevels(string value, CancellationToken token)
    {
        var query = _levels.AsQueryable();

        if (!string.IsNullOrWhiteSpace(value))
        {
            query = query.Where(x => x.Code.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(query.Select(x => (long?)x.Id).AsEnumerable());
    }

    private string GetFilterLevelDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var level = _levels.FirstOrDefault(x => x.Id == id);
        if (level == null) return string.Empty;
        return level.IsActive ? level.Code : $"{level.Code} (Inactive)";
    }
}
