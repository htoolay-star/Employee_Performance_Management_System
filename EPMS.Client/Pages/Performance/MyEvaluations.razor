@page "/performance/my-evaluations"
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.FormDTOs
@using MudBlazor
@using Refit
@inject IAppraisalApiClient AppraisalApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>My Evaluations</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">My Evaluations</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

        <MudDataGrid Items="@_items"
                     Loading="@_loading"
                     Hover="true"
                     Elevation="0"
                     SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="#" Sortable="false" Style="width: 60px;">
                    <CellTemplate>
                        <span style="display: block; text-align: left; padding-right: 12px;">@(_items.IndexOf(context.Item) + 1)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.EmployeeName" Title="Employee" Sortable="true" />
                <PropertyColumn Property="x => x.CycleName" Title="Cycle" Sortable="true" />
                <TemplateColumn Title="Status" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Score" Sortable="true">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Align="Align.Right">@(context.Item.KpiScore?.ToString("F2") ?? "-")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Locked" Sortable="false" Style="width: 80px; text-align: center;">
                    <CellTemplate>
                        <MudIcon Icon="@(context.Item.IsLocked ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
                                 Color="@(context.Item.IsLocked ? Color.Error : Color.Default)"
                                 Size="Size.Small" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.Status is AppraisalStatuses.Draft or AppraisalStatuses.InProgress or null)
                        {
                            <MudTooltip Text="KPI Evaluation" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Disabled="@(context.Item.IsLocked)"
                                               OnClick="@(() => GoToFill(context.Item.Id))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="View Evaluation" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="@(() => GoToView(context.Item.Id))" />
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">No evaluations found</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">You have no pending KPI evaluations.</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="AppraisalDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>

@code {

    private List<AppraisalDto> _items = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var response = await AppraisalApiClient.GetMyEvaluationsAsync();
            if (response.Success && response.Data != null)
            {
                _items = response.Data.ToList();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to load evaluations.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void GoToFill(long id) =>
        Navigation.NavigateTo($"/performance/appraisals/{id}/fill");

    private void GoToView(long id) =>
        Navigation.NavigateTo($"/performance/appraisals/{id}/view?from=my-evaluations");

    private static Color GetStatusColor(string status) => status switch
    {
        AppraisalStatuses.Draft => Color.Warning,
        AppraisalStatuses.InProgress => Color.Info,
        AppraisalStatuses.Reviewed => Color.Primary,
        AppraisalStatuses.Finalized => Color.Success,
        _ => Color.Default
    };
}
