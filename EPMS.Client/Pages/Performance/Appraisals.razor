@page "/performance/appraisals"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.FormDTOs
@using MudBlazor
@using Refit
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IAppraisalApiClient AppraisalApiClient
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@UIConstants.AppraisalList.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.AppraisalList.PageTitle</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_searchString"
                              Placeholder="@UIConstants.AppraisalList.SearchPlaceholder"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" DebounceInterval="500"
                              Variant="Variant.Outlined" Clearable="true"
                              Style="max-width: 250px;" />

                <MudSelect T="string?"
                           Value="@_selectedStatusFilter"
                           ValueChanged="OnStatusFilterChanged"
                           Label="@UIConstants.AppraisalList.ColumnStatus"
                           Variant="Variant.Outlined"
                           Style="max-width: 150px;"
                           Clearable="true">
                    <MudSelectItem Value="@AppraisalStatuses.Draft">Draft</MudSelectItem>
                    <MudSelectItem Value="@AppraisalStatuses.InProgress">In Progress</MudSelectItem>
                    <MudSelectItem Value="@AppraisalStatuses.Reviewed">Reviewed</MudSelectItem>
                    <MudSelectItem Value="@AppraisalStatuses.Finalized">Finalized</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudStack>

        <MudDataGrid Items="@_items"
                     Loading="@_loading"
                     Hover="true"
                     Elevation="0"
                     SortMode="SortMode.None"
                     QuickFilter="@QuickFilter">
            <Columns>
                <TemplateColumn Title="@UIConstants.Common.ColumnNo" Sortable="false" Style="width: 60px;">
                    <CellTemplate>
                        <span style="display: block; text-align: left; padding-right: 12px;">@_rowNumbers.GetValueOrDefault(context.Item.Id)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.EmployeeName" Title="@UIConstants.AppraisalList.ColumnEmployee" Sortable="true" />
                <PropertyColumn Property="x => x.CycleName" Title="@UIConstants.AppraisalList.ColumnCycle" Sortable="true" />
                <TemplateColumn Title="@UIConstants.AppraisalList.ColumnStatus" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@UIConstants.AppraisalList.ColumnScore" Sortable="true">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Align="Align.Right">@(context.Item.TotalScore?.ToString("F2") ?? "-")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@UIConstants.AppraisalList.ColumnLocked" Sortable="false" Style="width: 80px; text-align: center;">
                    <CellTemplate>
                        <MudIcon Icon="@(context.Item.IsLocked ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
                                 Color="@(context.Item.IsLocked ? Color.Error : Color.Default)"
                                 Size="Size.Small" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@UIConstants.Common.Actions" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.ManagerReviewerId == _currentUserId)
                        {
                            <MudStack Row="true" Spacing="0">
                                <MudTooltip Text="KPI Evaluation" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="@(context.Item.IsLocked)"
                                                   OnClick="@(() => GoToFill(context.Item.Id))" />
                                </MudTooltip>
                                <MudTooltip Text="360° Feedback" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.People"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   Disabled="@(context.Item.IsLocked)"
                                                   OnClick="@(() => GoToEvaluate(context.Item.Id, EvaluatorRoles.Manager))" />
                                </MudTooltip>
                                <MudTooltip Text="Appraisal Review" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.RateReview"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   Disabled="@(context.Item.IsLocked)"
                                                   OnClick="@(() => GoToEvaluate(context.Item.Id, EvaluatorRoles.Appraisal))" />
                                </MudTooltip>
                                <MudTooltip Text="View Self-Assessment" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   OnClick="@(() => GoToEvaluate(context.Item.Id, EvaluatorRoles.Self, true))" />
                                </MudTooltip>
                                <MudTooltip Text="@UIConstants.Common.Delete" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenDeleteDialog(context.Item))" />
                                </MudTooltip>
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Row="true" Spacing="0">
                                <MudTooltip Text="Evaluate" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.RateReview"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => GoToEvaluate(context.Item.Id, null))" />
                                </MudTooltip>
                                <MudTooltip Text="@UIConstants.Common.Delete" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenDeleteDialog(context.Item))" />
                                </MudTooltip>
                            </MudStack>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Common.NoRecords</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@UIConstants.AppraisalList.NoDataFound</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="AppraisalDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>

@code {

    private static readonly DialogOptions _confirmDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    private string? _searchString;
    private string? _selectedStatusFilter;
    private List<AppraisalDto> _items = new();
    private Dictionary<long, int> _rowNumbers = new();
    private bool _loading = true;
    private long _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserIdAsync();
        await LoadDataAsync();
    }

    private async Task LoadCurrentUserIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userIdClaim) && long.TryParse(userIdClaim, out var userId))
        {
            _currentUserId = userId;
        }
    }

    private async Task OnStatusFilterChanged(string? v)
    {
        _selectedStatusFilter = v;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var response = await AppraisalApiClient.GetAllAsync();
            if (response.Success && response.Data != null)
            {
                _items = response.Data.ToList();
                _rowNumbers = _items.Select((x, i) => (x.Id, Index: i + 1)).ToDictionary(x => x.Id, x => x.Index);
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private bool QuickFilter(AppraisalDto x)
    {
        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            var search = _searchString.Trim();
            if (!string.IsNullOrWhiteSpace(x.EmployeeName) &&
                x.EmployeeName.Contains(search, StringComparison.OrdinalIgnoreCase))
                return true;
            return false;
        }
        return true;
    }

    private void GoToFill(long id) =>
        Navigation.NavigateTo($"/performance/appraisals/{id}/fill");

    private void GoToEvaluate(long id, string? role, bool viewOnly = false)
    {
        var url = $"/performance/appraisals/{id}/evaluate";
        var query = new List<string>();
        if (!string.IsNullOrEmpty(role))
            query.Add($"role={role}");
        if (viewOnly)
            query.Add("viewonly=true");
        if (query.Count > 0)
            url += "?" + string.Join("&", query);
        Navigation.NavigateTo(url);
    }

    private async Task OpenDeleteDialog(AppraisalDto item)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, string.Format(UIConstants.AppraisalList.DeleteConfirmFormat, item.EmployeeName ?? item.Id.ToString()) },
            { x => x.ButtonText, UIConstants.Common.Delete },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            UIConstants.Common.Delete, parameters, _confirmDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            try
            {
                var response = await AppraisalApiClient.DeleteAsync(item.Id);
                if (response.Success)
                {
                    Snackbar.Add(UIConstants.AppraisalList.DeleteSuccess, Severity.Success);
                    await LoadDataAsync();
                }
                else
                {
                    Snackbar.Add(response.Message ?? UIConstants.Common.DeleteFailed, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
            }
        }
    }

    private static Color GetStatusColor(string status) => status switch
    {
        AppraisalStatuses.Draft => Color.Warning,
        AppraisalStatuses.InProgress => Color.Info,
        AppraisalStatuses.Reviewed => Color.Primary,
        AppraisalStatuses.Finalized => Color.Success,
        _ => Color.Default
    };
}
