    private async Task ConfirmObjectiveForm()
    {
        await _objForm.Validate();
        if (!_objFormValid) return;

        _isProcessing = true;
        try
        {
            if (_isObjectiveEdit && _selectedObjective != null)
            {
                var dto = new UpdatePIPObjectiveDto
                {
                    Title = _objTitle,
                    SuccessCriteria = _objSuccessCriteria,
                    Description = string.IsNullOrWhiteSpace(_objDescription) ? null : _objDescription,
                    Status = string.IsNullOrWhiteSpace(_objStatus) ? null : _objStatus,
                    ManagerComment = string.IsNullOrWhiteSpace(_objManagerComment) ? null : _objManagerComment
                };
                var result = await ObjectiveApiClient.UpdateAsync(_selectedObjective.Id, dto);
                if (result.Success)
                {
                    Snackbar.Add(UIConstants.PIP.ObjectiveUpdated, Severity.Success);
                    _showObjectiveDialog = false;
                    _selectedObjective = null;
                    if (_selectedPIP != null) await LoadObjectivesAsync(_selectedPIP.Id);
                }
                else
                {
                    Snackbar.Add(result.Message ?? UIConstants.Common.UpdateFailed, Severity.Error);
                }
            }
            else if (_selectedPIP != null)
            {
                var dto = new CreatePIPObjectiveDto
                {
                    PIPId = _selectedPIP.Id,
                    Title = _objTitle,
                    SuccessCriteria = _objSuccessCriteria,
                    Description = string.IsNullOrWhiteSpace(_objDescription) ? null : _objDescription
                };
                var result = await ObjectiveApiClient.CreateAsync(dto);
                if (result.Success)
                {
                    Snackbar.Add(UIConstants.PIP.ObjectiveCreated, Severity.Success);
