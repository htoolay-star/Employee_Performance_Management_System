@page "/performance/reports/employee-summary"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using EPMS.Client.Services.Performance
@using EPMS.Client.Services.Info
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.ReportDTOs
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using EPMS.Shared.DTOs.PerformanceDTOs.AppraisalCycleDTOs
@using MudBlazor
@using Refit
@using Microsoft.JSInterop
@inject IPerformanceReportsApiClient ReportApiClient
@inject IAppraisalCycleApiClient AppraisalCycleApiClient
@inject IEmployeeProfileApiClient EmployeeApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Employee Performance Summary</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Employee Performance Summary Report</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
            <MudSelect T="long?"
                       @bind-Value="_selectedCycleId"
                       Label="Appraisal Cycle"
                       Variant="Variant.Outlined"
                       Style="max-width: 200px;"
                       Clearable="true"
                       @bind-Value:after="LoadDataAsync">
                <MudSelectItem Value="@((long?)null)">All Cycles</MudSelectItem>
                @foreach (var cycle in _cycles)
                {
                    <MudSelectItem Value="@((long?)cycle.Id)">@cycle.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="long?"
                       @bind-Value="_selectedEmployeeId"
                       Label="Employee"
                       Variant="Variant.Outlined"
                       Style="max-width: 250px;"
                       Clearable="true"
                       @bind-Value:after="LoadDataAsync">
                <MudSelectItem Value="@((long?)null)">All Employees</MudSelectItem>
                @foreach (var emp in _employees)
                {
                    <MudSelectItem Value="@((long?)emp.Id)">@emp.StaffNo - @emp.StaffName</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="ExportToExcelAsync"
                       Disabled="_loading">
                Export to Excel
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Print"
                       OnClick="PrintAsync"
                       Disabled="_loading">
                Print / PDF
            </MudButton>
        </MudStack>

        <MudDataGrid Items="@_items"
                     Loading="@_loading"
                     Hover="true"
                     Elevation="0"
                     SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="#" Sortable="false" Style="width: 50px;">
                    <CellTemplate>
                        @(_items.IndexOf(context.Item) + 1)
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.StaffNo" Title="Staff No" Sortable="true" />
                <PropertyColumn Property="x => x.StaffName" Title="Name" Sortable="true" />
                <PropertyColumn Property="x => x.DepartmentName" Title="Department" Sortable="true" />
                <PropertyColumn Property="x => x.PositionName" Title="Position" Sortable="true" />
                <PropertyColumn Property="x => x.CycleName" Title="Cycle" Sortable="true" />
                <TemplateColumn Title="KPI Score" Sortable="true" SortBy="@(x => x.KpiScore)">
                    <CellTemplate>
                        @(context.Item.KpiScore?.ToString("F1") ?? "-")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Self Score" Sortable="true" SortBy="@(x => x.SelfScore)">
                    <CellTemplate>
                        @(context.Item.SelfScore?.ToString("F1") ?? "-")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="360 Score" Sortable="true" SortBy="@(x => x.ThreeSixtyScore)">
                    <CellTemplate>
                        @(context.Item.ThreeSixtyScore?.ToString("F1") ?? "-")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Appraisal Score" Sortable="true" SortBy="@(x => x.AppraisalScore)">
                    <CellTemplate>
                        @(context.Item.AppraisalScore?.ToString("F1") ?? "-")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Total Score" Sortable="true" SortBy="@(x => x.TotalScore)">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="@GetScoreColor(context.Item.TotalScore)">
                            @(context.Item.TotalScore?.ToString("F1") ?? "-")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Rating" Sortable="true" SortBy="@(x => x.RatingLabel)">
                    <CellTemplate>
                        <MudChip Size="Size.Small">@(context.Item.RatingLabel ?? "-")</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status" Sortable="true" SortBy="@(x => x.Status)">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Finalized" Sortable="true" SortBy="@(x => x.FinalizedDate)">
                    <CellTemplate>
                        @(context.Item.FinalizedDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "-")
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">No data</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No appraisals found for the selected filters.</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="EmployeeSummaryReportDto" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

@code {
    private long? _selectedCycleId;
    private long? _selectedEmployeeId;
    private List<EmployeeSummaryReportDto> _items = new();
    private List<AppraisalCycleDto> _cycles = new();
    private List<EmployeeLookupDto> _employees = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCyclesAsync(), LoadEmployeesAsync());
        await LoadDataAsync();
    }

    private async Task LoadCyclesAsync()
    {
        try
        {
            var response = await AppraisalCycleApiClient.GetAllAsync();
            if (response.Success && response.Data != null)
                _cycles = response.Data.ToList();
        }
        catch { }
    }

    private async Task LoadEmployeesAsync()
    {
        try
        {
            var response = await EmployeeApiClient.GetLookupAsync();
            if (response.Success && response.Data != null)
                _employees = response.Data.ToList();
        }
        catch { }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var response = await ReportApiClient.GetEmployeeSummaryAsync(_selectedCycleId, _selectedEmployeeId);
            if (response.Success && response.Data != null)
                _items = response.Data;
            else
                Snackbar.Add(response.Message ?? "Failed to load data.", Severity.Error);
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to load data.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ExportToExcelAsync()
    {
        try
        {
            var response = await ReportApiClient.GetEmployeeSummaryExcelAsync(_selectedCycleId, _selectedEmployeeId);
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("downloadFile", $"EmployeeSummary_{DateTime.Now:yyyyMMdd}.xlsx", base64);
                Snackbar.Add("Export completed.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Export failed.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export error: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private static Color GetScoreColor(decimal? score) => score switch
    {
        >= 80 => Color.Success,
        >= 60 => Color.Warning,
        >= 0 => Color.Error,
        _ => Color.Default
    };

    private static Color GetStatusColor(string status) => status switch
    {
        "FINALIZED" => Color.Success,
        "DRAFT" => Color.Warning,
        _ => Color.Default
    };
}
