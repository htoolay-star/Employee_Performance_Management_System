@page "/performance/my-kpi"
@implements IDisposable
@using EPMS.Client.Constants
@using EPMS.Client.Models.Performance
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using Mapster
@using MudBlazor
@using Refit
@inject IAppraisalApiClient AppraisalApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@UIConstants.MyKpi.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.MyKpi.PageTitle</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

        <MudDataGrid Items="@_items"
                     Loading="@_loading"
                     Hover="true"
                     Elevation="0"
                     SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="#" Sortable="false" Style="width: 60px;">
                    <CellTemplate>
                        <span style="display: block; text-align: left; padding-right: 12px;">@(_items.IndexOf(context.Item) + 1)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.EmployeeName" Title="Employee" Sortable="true" />
                <PropertyColumn Property="x => x.CycleName" Title="Cycle" Sortable="true" />
                @* Manager Name *@
                <PropertyColumn Property="x => x.ManagerName" Title="Manager" Sortable="true" />
                <TemplateColumn Title="Status" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.KpiStatus)">@context.Item.KpiStatus</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Score" Sortable="true">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Align="Align.Right">@(context.Item.Details.Sum(d => d.WeightedScore).ToString("F2"))</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudTooltip Text="View KPI" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => Navigation.NavigateTo($"/performance/appraisals/{context.Item.Id}/view?from=my-kpi"))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.MyKpi.NoData</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="AppraisalFillFormModel" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>

@code {

    private List<AppraisalFillFormModel> _items = new();
    private bool _loading = true;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var response = await AppraisalApiClient.GetMyKpiAsync();
            if (response.Success && response.Data != null)
            {
                _items = response.Data.Adapt<List<AppraisalFillFormModel>>();
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static Color GetStatusColor(string status) => status switch
    {
        AppraisalStatuses.Kpi.Draft => Color.Warning,
        AppraisalStatuses.Kpi.Reviewed => Color.Primary,
        AppraisalStatuses.Kpi.Finalized => Color.Success,
        _ => Color.Default
    };
}
