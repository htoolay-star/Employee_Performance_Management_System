@page "/performance/rating-scales"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Performance
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.PerformanceDTOs.RatingScaleDTOs
@using MudBlazor
@using Refit
@using static EPMS.Shared.Constants.ServiceResponseMessages

@inject IRatingScaleApiClient RatingScaleApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@UIConstants.RatingScale.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.RatingScale.PageTitle</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField @bind-Value="_searchString"
                          Placeholder="@UIConstants.RatingScale.SearchPlaceholder"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Variant="Variant.Outlined"
                          Clearable="true"
                          Immediate="true"
                          DebounceInterval="500"
                          Style="max-width: 300px;" />

            <MudSelect T="bool"
                       Value="@_statusFilter"
                       ValueChanged="OnStatusFilterChanged"
                       Variant="Variant.Outlined"
                       Style="max-width: 150px;">
                <MudSelectItem T="bool" Value="@(true)">@UIConstants.Common.Active</MudSelectItem>
                <MudSelectItem T="bool" Value="@(false)">@UIConstants.Common.Inactive</MudSelectItem>
            </MudSelect>

            <TableSortControl SortBy="@_sortBy"
                              SortDirection="@_sortDirection"
                              SortColumns="@_sortableColumns"
                              OnSortChanged="HandleSortChanged" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                @UIConstants.RatingScale.AddButton
            </MudButton>
        </MudStack>

        <MudDataGrid Items="@_ratingScales"
                     QuickFilter="@QuickFilter"
                     Loading="@_loading"
                     SortMode="SortMode.None"
                     Hover="true"
                     Elevation="0">
            <Columns>
                <TemplateColumn Title="@UIConstants.Common.ColumnNo" Sortable="false">
                    <CellTemplate>
                        <span style="display: block; text-align: left;">@_rowNumbers.GetValueOrDefault(context.Item.Id)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Rating" Title="@UIConstants.RatingScale.ColumnRating" Sortable="true" />
                <PropertyColumn Property="x => x.Label" Title="@UIConstants.RatingScale.ColumnLabel" />
                <PropertyColumn Property="x => x.MinScore" Title="@UIConstants.RatingScale.ColumnMinScore" Sortable="true" />
                <PropertyColumn Property="x => x.MaxScore" Title="@UIConstants.RatingScale.ColumnMaxScore" Sortable="true" />
                <PropertyColumn Property="x => x.PromotionEligibility" Title="@UIConstants.RatingScale.ColumnPromotionEligibility" />
                <TemplateColumn Title="@UIConstants.Common.Status">
                    <CellTemplate>
                        <MudChip Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                                 Size="Size.Small">
                            @(context.Item.IsActive ? UIConstants.Common.Active : UIConstants.Common.Inactive)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@UIConstants.Common.Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="0">
                            <MudTooltip Text="Edit Rating Scale" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEditDialog(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete Rating Scale" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenDeleteDialog(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Common.NoRecords</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@UIConstants.RatingScale.NoDataFound</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="RatingScaleDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>

@code {

    private static readonly DialogOptions _formDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private static readonly DialogOptions _confirmDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    private List<RatingScaleDto> _allRatingScales = new();
    private List<RatingScaleDto> _ratingScales = new();
    private bool _loading = true;
    private string _searchString = string.Empty;
    private Dictionary<long, int> _rowNumbers = new();
    private bool _statusFilter = true;

    private string _sortBy = "Rating";
    private string _sortDirection = "asc";
    private Dictionary<string, string> _sortableColumns = new()
    {
        { "Rating", "Rating" },
        { "Label", "Label" },
        { "MinScore", "Min Score" },
        { "MaxScore", "Max Score" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadRatingScalesAsync();
    }

    private bool QuickFilter(RatingScaleDto x)
    {
        if (x.IsActive != _statusFilter)
            return false;

        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        return x.Rating.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || x.Label.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || (x.PromotionEligibility?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task HandleSortChanged((string SortBy, string SortDirection) sortData)
    {
        _loading = true;
        await Task.Yield();

        _sortBy = sortData.SortBy;
        _sortDirection = sortData.SortDirection;

        _loading = false;
        ApplyFiltersAndSort();
    }

    private async Task LoadRatingScalesAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var response = await RatingScaleApiClient.GetAllAsync();
            if (response.Success && response.Data != null)
            {
                _allRatingScales = response.Data.ToList();
                ApplyFiltersAndSort();
            }
            else
                Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteRatingScaleAsync(long id)
    {
        try
        {
            var response = await RatingScaleApiClient.DeleteAsync(id);
            if (response.Success)
            {
                Snackbar.Add(RatingScaleMsg.Deleted, Severity.Success);
                await LoadRatingScalesAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.DeleteFailed, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<RatingScaleDialog>(
            UIConstants.RatingScale.CreateDialogTitle, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(RatingScaleMsg.Created, Severity.Success);
            await LoadRatingScalesAsync();
        }
    }

    private async Task OpenEditDialog(RatingScaleDto ratingScale)
    {
        var parameters = new DialogParameters<RatingScaleDialog>
        {
            { x => x.RatingScale, ratingScale }
        };

        var dialog = await DialogService.ShowAsync<RatingScaleDialog>(
            UIConstants.RatingScale.EditDialogTitle, parameters, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(RatingScaleMsg.Updated, Severity.Success);
            await LoadRatingScalesAsync();
        }
    }

    private async Task OpenDeleteDialog(RatingScaleDto ratingScale)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, string.Format(UIConstants.Common.DeleteConfirmationFormat, ratingScale.Label) },
            { x => x.ButtonText, UIConstants.Common.Delete },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            UIConstants.RatingScale.DeleteDialogTitle, parameters, _confirmDialogOptions);

        if (await dialog.Result is { Canceled: false })
            await DeleteRatingScaleAsync(ratingScale.Id);
    }

    private void ApplyFiltersAndSort()
    {
        if (!_allRatingScales.Any()) return;

        var filteredList = _allRatingScales.Where(x => x.IsActive == _statusFilter).ToList();

        filteredList = _sortBy switch
        {
            "Label" => _sortDirection == "asc"
                ? filteredList.OrderBy(x => x.Label).ToList()
                : filteredList.OrderByDescending(x => x.Label).ToList(),
            "MinScore" => _sortDirection == "asc"
                ? filteredList.OrderBy(x => x.MinScore).ToList()
                : filteredList.OrderByDescending(x => x.MinScore).ToList(),
            "MaxScore" => _sortDirection == "asc"
                ? filteredList.OrderBy(x => x.MaxScore).ToList()
                : filteredList.OrderByDescending(x => x.MaxScore).ToList(),
            _ => _sortDirection == "asc"
                ? filteredList.OrderBy(x => x.Rating).ToList()
                : filteredList.OrderByDescending(x => x.Rating).ToList(),
        };

        _ratingScales = filteredList;

        _rowNumbers = filteredList
            .Select((x, i) => (x.Id, Index: i + 1))
            .ToDictionary(x => x.Id, x => x.Index);
    }

    private async Task OnStatusFilterChanged(bool value)
    {
        _statusFilter = value;
        _loading = true;
        await Task.Yield();
        ApplyFiltersAndSort();
        _loading = false;
    }
}
