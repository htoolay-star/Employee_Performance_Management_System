@page "/performance/pending"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.FormDTOs
@using MudBlazor
@using Refit
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,SystemAdmin")]
@inject IAppraisalApiClient AppraisalApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@UIConstants.Pending.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.Pending.PageTitle</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

        <MudDataGrid Items="@_items"
                     Loading="@_loading"
                     Hover="true"
                     Elevation="0"
                     SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="#" Sortable="false" Style="width: 60px;">
                    <CellTemplate>
                        <span style="display: block; text-align: left; padding-right: 12px;">@(_items.IndexOf(context.Item) + 1)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.EmployeeName" Title="Employee" Sortable="true" />
                <PropertyColumn Property="x => x.CycleName" Title="Cycle" Sortable="true" />
                <TemplateColumn Title="Score" Sortable="true">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Align="Align.Right">@context.Item.KpiScore?.ToString("F2")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => Navigation.NavigateTo($"/performance/appraisals/{context.Item.Id}/view"))">
                            View
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Style="font-size: 4rem;" Color="Color.Success" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Pending.NoData</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>

@code {

    private List<AppraisalDto> _items = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var response = await AppraisalApiClient.GetPendingAsync();
            if (response.Success && response.Data != null)
            {
                _items = response.Data.ToList();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to load pending approvals.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
}
