@using EPMS.Client.Constants
@using EPMS.Client.Extensions
@using EPMS.Client.Models.Performance
@using EPMS.Client.Services.Performance
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.PerformanceDTOs.QuestionRatingScaleDTOs
@using EPMS.Shared.Validators.PerformanceDTOs.QuestionRatingScaleDTOs
@using Mapster
@using MudBlazor

@inject IQuestionRatingScaleApiClient QuestionRatingScaleApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model" Validation="ValidateField">
            <MudStack Spacing="3">

                @if (!IsEdit)
                {
                    <MudTextField @bind-Value="_model.Name"
                                  Label="@UIConstants.QuestionRatingScale.NameLabel"
                                  For="@(() => _model.Name)"
                                  Variant="Variant.Outlined" />
                }
                else
                {
                    <MudTextField Value="@_model.Name" Label="@UIConstants.QuestionRatingScale.NameLabel" Variant="Variant.Outlined" ReadOnly="true" />
                }

                <MudText Typo="Typo.subtitle2" Class="mt-2">Rating Levels</MudText>

                @for (int i = 0; i < _model.Levels.Count; i++)
                {
                    var index = i;

                    <MudPaper Elevation="1" Class="pa-3">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudTextField @bind-Value="_model.Levels[index].Rating"
                                          Label="Rating"
                                          For="@(() => _model.Levels[index].Rating)"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Number"
                                          Style="max-width: 100px;" />

                            <MudTextField @bind-Value="_model.Levels[index].MinScore"
                                          Label="Min Score"
                                          For="@(() => _model.Levels[index].MinScore)"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Number"
                                          Style="max-width: 120px;" />

                            <MudTextField @bind-Value="_model.Levels[index].MaxScore"
                                          Label="Max Score"
                                          For="@(() => _model.Levels[index].MaxScore)"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Number"
                                          Style="max-width: 120px;" />

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => RemoveLevel(index))"
                                           Disabled="@(_model.Levels.Count <= 1)" />
                        </MudStack>
                    </MudPaper>
                }

                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddLevel"
                           Size="Size.Small">
                    Add Level
                </MudButton>

                @if (IsEdit)
                {
                    <MudSwitch @bind-Value="_model.IsActive"
                               Label="@UIConstants.Common.Active"
                               Color="Color.Success" />
                }

            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@UIConstants.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   OnClick="Submit"
                   Disabled="@(_saving || !HasChanged())">
            @if (_saving)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
            }
            @(IsEdit ? UIConstants.Common.Update : UIConstants.Common.Create)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] private IMudDialogInstance? _mudDialog { get; set; }

    [Parameter] public QuestionRatingScaleDto? RatingScale { get; set; }

    private bool IsEdit => RatingScale is not null;

    private MudForm? _form;
    private bool _saving;
    private QuestionRatingScaleFormModel _model = new();
    private Dictionary<string, string> _serverErrors = new();
    private Dictionary<string, string> _levelErrors = new();

    private readonly CreateQuestionRatingScaleValidator _createValidator = new();
    private readonly UpdateQuestionRatingScaleValidator _updateValidator = new();

    protected override Task OnInitializedAsync()
    {
        if (RatingScale is not null)
        {
            _model = RatingScale.Adapt<QuestionRatingScaleFormModel>();
            if (_model.Levels.Count == 0)
            {
                _model.Levels.Add(new QuestionRatingScaleLevelFormModel { Rating = 1, MinScore = 1, MaxScore = 5 });
            }
        }

        return base.OnInitializedAsync();
    }

    private void AddLevel()
    {
        var nextRating = _model.Levels.Any() ? _model.Levels.Max(l => l.Rating) + 1 : 1;
        _model.Levels.Add(new QuestionRatingScaleLevelFormModel { Rating = nextRating, MinScore = nextRating, MaxScore = nextRating });
    }

    private void RemoveLevel(int index)
    {
        if (_model.Levels.Count > 1)
            _model.Levels.RemoveAt(index);
    }

    private void ValidateLevelFields()
    {
        _levelErrors.Clear();

        var ratingGroups = _model.Levels
            .Select((l, i) => (l, i))
            .GroupBy(x => x.l.Rating)
            .Where(g => g.Count() > 1)
            .ToList();

        foreach (var group in ratingGroups)
        {
            foreach (var item in group)
            {
                var key = $"Levels[{item.i}].Rating";
                _levelErrors[key] = $"Duplicate rating value: {group.Key}";
            }
        }

        for (int i = 0; i < _model.Levels.Count; i++)
        {
            for (int j = i + 1; j < _model.Levels.Count; j++)
            {
                var a = _model.Levels[i];
                var b = _model.Levels[j];

                if (a.MinScore <= b.MaxScore && b.MinScore <= a.MaxScore)
                {
                    var minAKey = $"Levels[{i}].MinScore";
                    var maxAKey = $"Levels[{i}].MaxScore";
                    var minBKey = $"Levels[{j}].MinScore";
                    var maxBKey = $"Levels[{j}].MaxScore";

                    _levelErrors[minAKey] = $"Overlaps with Rating {b.Rating} ({b.MinScore}-{b.MaxScore})";
                    _levelErrors[maxAKey] = $"Overlaps with Rating {b.Rating} ({b.MinScore}-{b.MaxScore})";
                    _levelErrors[minBKey] = $"Overlaps with Rating {a.Rating} ({a.MinScore}-{a.MaxScore})";
                    _levelErrors[maxBKey] = $"Overlaps with Rating {a.Rating} ({a.MinScore}-{a.MaxScore})";
                }
            }
        }

        for (int i = 0; i < _model.Levels.Count; i++)
        {
            var level = _model.Levels[i];
            if (level.MinScore > level.MaxScore)
            {
                var maxKey = $"Levels[{i}].MaxScore";
                _levelErrors[maxKey] = "Max Score must be >= Min Score";
            }
        }

        StateHasChanged();
    }

    private async Task Submit()
    {
        _serverErrors.Clear();
        ValidateLevelFields();

        await _form!.Validate();
        if (!_form.IsValid || _levelErrors.Count > 0)
        {
            Snackbar.Add(UIConstants.Common.ValidationFailed, Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (IsEdit)
            {
                var dto = new UpdateQuestionRatingScaleDto
                {
                    Name = _model.Name,
                    IsActive = _model.IsActive,
                    Levels = _model.Levels.Select(l => new UpdateQuestionRatingScaleLevelDto
                    {
                        Id = l.Id,
                        Rating = l.Rating,
                        MinScore = l.MinScore,
                        MaxScore = l.MaxScore
                    }).ToList()
                };

                var response = await QuestionRatingScaleApiClient.UpdateAsync(RatingScale!.Id, dto);

                if (response.Success)
                {
                    _mudDialog?.Close(DialogResult.Ok(true));
                    return;
                }
                else
                    Snackbar.Add(response.Message ?? UIConstants.Common.UpdateFailed, Severity.Error);
            }
            else
            {
                var dto = new CreateQuestionRatingScaleDto
                {
                    Name = _model.Name,
                    Levels = _model.Levels.Select(l => new CreateQuestionRatingScaleLevelDto
                    {
                        Rating = l.Rating,
                        MinScore = l.MinScore,
                        MaxScore = l.MaxScore
                    }).ToList()
                };

                var response = await QuestionRatingScaleApiClient.CreateAsync(dto);

                if (response.Success)
                {
                    _mudDialog?.Close(DialogResult.Ok(true));
                    return;
                }
                else
                    Snackbar.Add(response.Message ?? UIConstants.Common.CreateFailed, Severity.Error);
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ValidationFailed, Severity.Error);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            _serverErrors[nameof(_model.Name)] = error?.Message ?? UIConstants.Common.DuplicateEntry;
            await _form!.Validate();
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => _mudDialog?.Cancel();

    private async Task<IEnumerable<string>> ValidateField(object model, string propertyName)
    {
        IEnumerable<string> fluentErrors;

        if (IsEdit)
        {
            var fn = _updateValidator.ValidateMappedValue<QuestionRatingScaleFormModel, UpdateQuestionRatingScaleDto>(_model, _serverErrors);
            fluentErrors = await fn(model, propertyName);
        }
        else
        {
            var fn = _createValidator.ValidateMappedValue<QuestionRatingScaleFormModel, CreateQuestionRatingScaleDto>(_model, _serverErrors);
            fluentErrors = await fn(model, propertyName);
        }

        var errorList = fluentErrors.ToList();

        if (_levelErrors.TryGetValue(propertyName, out var levelError))
            errorList.Add(levelError);

        if (_serverErrors.TryGetValue(propertyName, out var serverError))
            errorList.Add(serverError);

        return errorList;
    }

    private bool HasChanged()
    {
        if (!IsEdit) return true;

        if (_model.Name != RatingScale!.Name) return true;
        if (_model.IsActive != RatingScale.IsActive) return true;

        var existingLevels = RatingScale.Levels ?? new List<QuestionRatingScaleLevelDto>();
        if (_model.Levels.Count != existingLevels.Count) return true;

        for (int i = 0; i < _model.Levels.Count; i++)
        {
            var newLevel = _model.Levels[i];
            var existingLevel = existingLevels.ElementAtOrDefault(i);
            if (existingLevel == null) return true;

            if (newLevel.Rating != existingLevel.Rating ||
                newLevel.MinScore != existingLevel.MinScore ||
                newLevel.MaxScore != existingLevel.MaxScore)
                return true;
        }

        return false;
    }
}
