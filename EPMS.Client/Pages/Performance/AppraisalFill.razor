@page "/performance/appraisals/{AppraisalId:long}/fill"
@layout BlankLayout
@implements IDisposable
@using EPMS.Client.Constants
@using EPMS.Client.Models.Performance
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.FormDTOs
@using EPMS.Shared.Utilities
@using Mapster
@using MudBlazor
@using Refit
@inject IAppraisalApiClient AppraisalApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@UIConstants.AppraisalFill.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    @if (_loading)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudStack Spacing="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
            </MudStack>
        </MudPaper>
    }
    else if (_error)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudText Color="Color.Error" Typo="Typo.body1">@_errorMessage</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudForm @ref="_form">
                @* Header: Back Arrow + Centered Title + Cycle & Status *@
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                    <MudSimpleTable Class="w-100 mb-4">
                        <tbody>
                            <tr>
                                <td style="width: 48px;">
                                    <BackButton Href="/performance/my-evaluations" />
                                </td>
                                <td style="text-align: center;">
                                    <MudText Typo="Typo.h5">@UIConstants.AppraisalFill.PageTitle</MudText>
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                    <MudSimpleTable Class="w-100">
                        <tbody>
                            <tr>
                                <td><strong>Cycle:</strong> @_model.CycleName</td>
                                <td>
                                    <strong>Status:</strong>
                                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_model.Status)">@_model.Status</MudChip>
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>

                @* Employee Info *@
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                    <MudSimpleTable Class="employee-info-table">
                        <thead>
                            <tr>
                                <th>Staff No</th>
                                <th>Staff Name</th>
                                <th>Position</th>
                                <th>Department</th>
                                @if (!string.IsNullOrEmpty(_model.TeamName))
                                {
                                    <th>Team</th>
                                }
                                <th>Manager</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@_model.StaffNo</td>
                                <td>@_model.EmployeeName</td>
                                <td>@_model.PositionName</td>
                                <td>@_model.DepartmentName</td>
                                @if (!string.IsNullOrEmpty(_model.TeamName))
                                {
                                    <td>@_model.TeamName</td>
                                }
                                <td>@_model.ManagerName</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>

                @* KPI Details Grid *@
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                    <MudTable Items="@_model.Details"
                              Hover="true"
                              Elevation="0"
                              Class="mb-0">
                        <ColGroup>
                            <col style="width: 40px;" />
                            <col style="width: 220px;" />
                            <col style="width: 80px;" />
                            <col style="width: 80px;" />
                            <col style="width: 20px;" />
                            <col style="width: 100px;" />
                            <col style="width: 90px;" />
                            <col style="width: 120px;" />
                            <col style="width: 180px;" />
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>@UIConstants.AppraisalFill.ColumnKPI</MudTh>
                            <MudTh>@UIConstants.AppraisalFill.ColumnWeight</MudTh>
                            <MudTh>@UIConstants.AppraisalFill.ColumnTarget</MudTh>
                            <MudTh>@UIConstants.AppraisalFill.ColumnDirection</MudTh>
                        <MudTh>@UIConstants.AppraisalFill.ColumnActual</MudTh>
                        <MudTh>@UIConstants.AppraisalFill.ColumnScore</MudTh>
                        <MudTh>@UIConstants.AppraisalFill.ColumnWeighted</MudTh>
                        <MudTh>@UIConstants.AppraisalFill.ColumnRemarks</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="#">@(_model.Details.IndexOf(context) + 1)</MudTd>
                        <MudTd DataLabel="KPI">@context.KPIName</MudTd>
                        <MudTd DataLabel="Weight">@context.Weightage%</MudTd>
                        <MudTd DataLabel="Target">@context.TargetValue</MudTd>
                        <MudTd DataLabel="Direction" Style="text-align: center;">
                            <MudTooltip Text="@GetDirectionTooltip(context.ScoringDirection)">
                                <MudIcon Icon="@GetDirectionIcon(context.ScoringDirection)"
                                         Size="Size.Small"
                                         Color="Color.Primary" />
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Actual">
                            <MudNumericField T="decimal?"
                                             Value="context.ActualValue"
                                             ValueChanged="value => OnActualValueChanged(context, value)"
                                             Variant="Variant.Outlined"
                                             Placeholder="Enter value"
                                             Margin="Margin.Dense"
                                             Immediate="false"
                                             Min="0"
                                             Disabled="@_model.IsReadOnly"
                                             Validation="@(new Func<decimal?, string?>(v => v < 0 ? UIConstants.AppraisalFill.NegativeValueError : null))" />
                        </MudTd>
                        <MudTd DataLabel="Score">
                            <MudText Typo="Typo.body2" Align="Align.Right">@context.Score.ToString("F2")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Weighted">
                            <MudText Typo="Typo.body2" Align="Align.Right">@context.WeightedScore.ToString("F2")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Remarks">
                            <MudTextField T="string"
                                          @bind-Value="context.Remarks"
                                          Variant="Variant.Outlined"
                                          Placeholder="Notes"
                                          Margin="Margin.Dense"
                                          Lines="3"
                                          Disabled="@_model.IsReadOnly" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                </MudPaper>

                @* Summary Row *@
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                    <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2">
                            <strong>Total Weighted Score:</strong>
                            <MudText Typo="Typo.body1" Color="Color.Primary" Style="display: inline; margin-left: 8px;">
                                @_model.Details.Sum(d => d.WeightedScore).ToString("F2")
                            </MudText>
                        </MudText>
                    </MudStack>
                </MudPaper>

                @* Submit Button *@
                @if (!_model.IsReadOnly)
                {
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="Submit"
                                   Disabled="@(_loading || _submitting || _model.IsLocked || _model.Details.Count == 0)">
                            @if (_submitting)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            }
                            @UIConstants.AppraisalFill.SubmitButton
                        </MudButton>
                    </MudStack>
                }
                else
                {
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudChip T="string" Color="Color.Info">Read-Only View</MudChip>
                    </MudStack>
                }
            </MudForm>
        </MudPaper>
    }
</MudContainer>

@code {

    [Parameter] public long AppraisalId { get; set; }

    private MudForm? _form;
    private AppraisalFillFormModel _model = new();
    private bool _loading = true;
    private bool _error;
    private string _errorMessage = string.Empty;
    private bool _submitting;
    private CancellationTokenSource? _cts;

    private static readonly DialogOptions _confirmDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        StateHasChanged();

        try
        {
            var response = await AppraisalApiClient.GetFillAsync(AppraisalId);
            if (response.Success)
            {
                if (response.Data != null)
                {
                    _model = response.Data.Adapt<AppraisalFillFormModel>();
                }
                else
                {
                    _error = true;
                    _errorMessage = "Appraisal data was not found. Please try again or contact support.";
                }
            }
            else
            {
                _error = true;
                _errorMessage = response.Message ?? UIConstants.Common.LoadFailed;
            }
        }
        catch (ApiException ex)
        {
            _error = true;
            _errorMessage = $"Error loading appraisal: {ex.StatusCode}";
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = string.Format(UIConstants.Common.ErrorFormat, ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task Submit()
    {
        if (_submitting)
            return;

        _submitting = true;
        StateHasChanged();

        try
        {
            if (_form != null)
            {
                await _form.Validate();
                if (!_form.IsValid)
                    return;
            }

            var confirmed = await ShowSubmitConfirmation();
            if (!confirmed)
                return;

            var dto = new AppraisalSubmissionDto
            {
                Id = _model.Id,
                Details = _model.Details
                    .Where(d => d.KPIId.HasValue)
                    .Select(d => new AppraisalDetailDto
                    {
                        KPIId = d.KPIId,
                        ActualValue = d.ActualValue,
                        Comment = d.Remarks,
                    })
                    .ToList()
            };

            var response = await AppraisalApiClient.SubmitAsync(dto);
            if (response.Success)
            {
                Snackbar.Add(UIConstants.AppraisalFill.SubmitSuccess, Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<bool> ShowSubmitConfirmation()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to submit this evaluation? This action cannot be undone." },
            { x => x.ButtonText, "Submit" },
            { x => x.Color, Color.Primary }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Confirm Submission", parameters, _confirmDialogOptions);

        var result = await dialog.Result;
        return result is { Canceled: false };
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Warning,
        "InProgress" => Color.Info,
        "REVIEWED" => Color.Primary,
        "Finalized" => Color.Success,
        _ => Color.Default
    };

    private string GetDirectionTooltip(string? direction) =>
        direction == AppraisalConstants.ScoringDirections.LowerIsBetter
            ? "Lower is better"
            : "Higher is better";

    private string GetDirectionIcon(string? direction) =>
        direction == AppraisalConstants.ScoringDirections.LowerIsBetter
            ? Icons.Material.Filled.TrendingDown
            : Icons.Material.Filled.TrendingUp;

    private void OnActualValueChanged(AppraisalDetailFillItem item, decimal? newValue)
    {
        item.ActualValue = newValue;
        item.Score = KPIScoringCalculator.CalculateScore(item.ActualValue, item.TargetValue, item.ScoringDirection);
        item.WeightedScore = KPIScoringCalculator.CalculateWeightedScore(item.Score, item.Weightage);
        StateHasChanged();
    }
}
