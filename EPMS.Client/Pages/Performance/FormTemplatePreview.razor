@page "/performance/form-templates/{TemplateId:long}/preview"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.PerformanceDTOs.FormTemplateDTOs
@using MudBlazor
@using Refit

@inject IFormTemplateApiClient FormTemplateApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Preview — @_model?.Name ?? "Form Template"</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">
        <BackButton Href="@($"/performance/form-templates/{TemplateId}/questions")" />
        @UIConstants.FormQuestion.PageTitle — @_model?.Name
    </MudText>

    @if (_loading)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudStack Spacing="3" Class="w-100">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
            </MudStack>
        </MudPaper>
    }
    else if (_error)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        </MudPaper>
    }
    else if (_model != null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

            @* Header info *@
            <MudSimpleTable Class="mb-4">
                <tbody>
                    <tr>
                        <td><strong>Employee Name:</strong></td>
                        <td>—</td>
                        <td><strong>Employee Id:</strong></td>
                        <td>—</td>
                    </tr>
                    <tr>
                        <td><strong>Current Position:</strong></td>
                        <td>—</td>
                        <td><strong>Department:</strong></td>
                        <td>—</td>
                    </tr>
                    <tr>
                        <td><strong>Form Type:</strong></td>
                        <td>@GetFormTypeDisplay(_model.FormType)</td>
                        <td><strong>Questions:</strong></td>
                        <td>@_model.Questions.Count</td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            @* Questions table *@
            @{
                var showYesNo = _model.HasYesNo;
                var showComment = _model.HasComment;
            }
            <MudTable Items="@_model.Questions" Hover="true" Elevation="0" Class="mb-4">
                <ColGroup>
                    <col style="width: 40px;" />
                    <col style="width: 120px;" />
                    <col />
                    <col style="width: @(showYesNo ? "220px" : "120px")" />
                    @if (showComment) { <col style="width: 200px;" /> }
                </ColGroup>
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Category</MudTh>
                    <MudTh>@UIConstants.EvaluationForm.ColumnQuestion</MudTh>
                    <MudTh>@UIConstants.EvaluationForm.ColumnRating</MudTh>
                    @if (showComment)
                    {
                        <MudTh>@UIConstants.EvaluationForm.ColumnComment</MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">@context.Sequence</MudTd>
                    <MudTd DataLabel="Category">
                        @if (!string.IsNullOrEmpty(context.CategoryName))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.CategoryName</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Default">—</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Question">
                        <MudText Typo="Typo.body1">@context.QuestionText</MudText>
                    </MudTd>
                    <MudTd DataLabel="Rating">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudSelect T="int?"
                                       Value="@((int?)null)"
                                       Variant="Variant.Outlined"
                                       Disabled="true"
                                       Margin="Margin.Dense"
                                       Style="min-width: 80px;">
                                <MudSelectItem T="int?" Value="@((int?)null)">
                                    @(_model.RatingMaxScore.HasValue ? $"1 — {_model.RatingMaxScore}" : _model.RatingScaleName ?? "N/A")
                                </MudSelectItem>
                            </MudSelect>
                            @if (_model.HasYesNo)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Default"
                                           Disabled="true"
                                           Size="Size.Small"
                                           Class="px-3">Yes</MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Default"
                                           Disabled="true"
                                           Size="Size.Small"
                                           Class="px-3">No</MudButton>
                            }
                        </MudStack>
                    </MudTd>
                    @if (showComment)
                    {
                        <MudTd DataLabel="Comment">
                            <MudTextField T="string"
                                          Value="@string.Empty"
                                          Variant="Variant.Outlined"
                                          Placeholder="@UIConstants.EvaluationForm.CommentPlaceholder"
                                          Margin="Margin.Dense"
                                          Disabled="true"
                                          Immediate="true" />
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>

            @* Footer note *@
            <MudAlert Severity="Severity.Info" Class="mt-4">
                This is a read-only preview. The actual form may randomly select a subset of questions when assigned to an evaluator.
            </MudAlert>

        </MudPaper>
    }
</MudContainer>

@code {

    [Parameter] public long TemplateId { get; set; }

    private FormTemplatePreviewDto? _model;
    private bool _loading = true;
    private bool _error;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var response = await FormTemplateApiClient.GetPreviewAsync(TemplateId);
            if (response.Success && response.Data != null)
            {
                _model = response.Data;
            }
            else
            {
                _error = true;
                _errorMessage = response.Message ?? UIConstants.Common.LoadFailed;
            }
        }
        catch (ApiException ex)
        {
            _error = true;
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            _errorMessage = error?.Message ?? UIConstants.Common.ErrorOccurred;
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = string.Format(UIConstants.Common.ErrorFormat, ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static string GetFormTypeDisplay(string formType)
    {
        return formType?.Trim().ToUpperInvariant() switch
        {
            AppraisalConstants.FormTypes.Self => "Self Assessment",
            AppraisalConstants.FormTypes.Manager => "Manager",
            AppraisalConstants.FormTypes.Peer => "Peer",
            AppraisalConstants.FormTypes.Subordinate => "Subordinate",
            AppraisalConstants.FormTypes.Appraisal => "Appraisal",
            _ => formType ?? ""
        };
    }
}
