@page "/performance/employee-kpis"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using EPMS.Client.Constants
@using EPMS.Client.Services.Auth
@using EPMS.Client.Services.Performance
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.Performance.EmployeeKPI
@using EPMS.Shared.DTOs.PerformanceDTOs.AppraisalCycleDTOs
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using MudBlazor
@using Refit

@inject IEmployeeKPIApiClient EmployeeKPIApiClient
@inject LookupStateService LookupState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject CurrentUserPermissionService PermService

<PageTitle>@UIConstants.EmployeeKPI.PageTitle</PageTitle>

@if (!_initialized)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudStack Spacing="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
            </MudStack>
        </MudPaper>
    </MudContainer>
}
else if (_error)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.EmployeeKPI.PageTitle</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudAutocomplete T="long?"
                                 Value="@_selectedEmployeeId"
                                 ValueChanged="OnEmployeeFilterChanged"
                                 Label="Employee"
                                 Variant="Variant.Outlined"
                                 Style="max-width: 250px;"
                                 Clearable="true"
                                 SearchFunc="SearchEmployees"
                                 ToStringFunc="GetEmployeeDisplay"
                                 ResetValueOnEmptyText="true" />

                <MudSelect T="long?"
                            Value="@_selectedCycleId"
                            ValueChanged="OnCycleFilterChanged"
                            Label="Cycle"
                            Variant="Variant.Outlined"
                            Style="max-width: 200px;"
                            Clearable="true">
                    @foreach (var c in _cycles)
                    {
                        <MudSelectItem Value="@((long?)c.Id)" @key="c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            @if (_canCreate)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">
                    @UIConstants.EmployeeKPI.AddButton
                </MudButton>
            }
        </MudStack>

        <MudDataGrid Items="@_items"
                     Loading="@_loading"
                     Hover="true"
                     Elevation="0"
                     SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="@UIConstants.Common.ColumnNo" Sortable="false" Style="width: 60px;">
                    <CellTemplate>
                        <span style="display: block; text-align: left; padding-right: 12px;">@_rowNumbers.GetValueOrDefault(context.Item.Id)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.EmployeeName" Title="@UIConstants.EmployeeKPI.ColumnEmployee" />
                <PropertyColumn Property="x => x.KPIName" Title="@UIConstants.EmployeeKPI.ColumnKPI" />
                <PropertyColumn Property="x => x.PriorityName" Title="@UIConstants.EmployeeKPI.ColumnPriority" />
                <PropertyColumn Property="x => x.Weightage" Title="@UIConstants.EmployeeKPI.ColumnWeightage" Sortable="true" />
                <PropertyColumn Property="x => x.TargetValue" Title="@UIConstants.EmployeeKPI.ColumnTarget" />
                <PropertyColumn Property="x => x.TargetUnit" Title="@UIConstants.EmployeeKPI.ColumnUnit" />
                <TemplateColumn Title="@UIConstants.Common.Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudTooltip Text="Edit" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialog(context.Item))" />
                                </MudTooltip>
                            }
                            @if (_canDelete)
                            {
                                <MudTooltip Text="Delete" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenDeleteDialog(context.Item))" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Common.NoRecords</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@UIConstants.EmployeeKPI.NoDataFound</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="EmployeeKPIDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>
}

@code {

    private static readonly DialogOptions _formDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private static readonly DialogOptions _confirmDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    private long? _selectedEmployeeId;
    private long? _selectedCycleId;
    private List<EmployeeKPIDto> _items = new();
    private Dictionary<long, int> _rowNumbers = new();
    private bool _loading = true;

    private bool _initialized;
    private bool _error;
    private string _errorMessage = string.Empty;
    private bool _canView;
    private bool _canCreate;
    private bool _canEdit;
    private bool _canDelete;

    private List<AppraisalCycleDto> _cycles = new();
    private List<EmployeeLookupDto> _employees = new();

    private async Task OnEmployeeFilterChanged(long? v)
    {
        _selectedEmployeeId = v;
        await LoadDataAsync();
    }

    private async Task OnCycleFilterChanged(long? v)
    {
        _selectedCycleId = v;
        await LoadDataAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _canView = await PermService.HasPermissionAsync("EMPLOYEEKPI.VIEW");
            if (!_canView)
            {
                _error = true;
                _errorMessage = "You do not have permission to view Employee KPIs.";
                return;
            }

            _canCreate = await PermService.HasPermissionAsync("EMPLOYEEKPI.CREATE");
            _canEdit = await PermService.HasPermissionAsync("EMPLOYEEKPI.EDIT");
            _canDelete = await PermService.HasPermissionAsync("EMPLOYEEKPI.DELETE");

            _employees = await LookupState.GetEmployeesAsync();
            _cycles = await LookupState.GetActiveCyclesAsync();
            await LoadDataAsync();
        }
        finally
        {
            _initialized = true;
        }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            SuccessResponse<IEnumerable<EmployeeKPIDto>>? response;

            if (_selectedEmployeeId.HasValue && _selectedCycleId.HasValue)
                response = await EmployeeKPIApiClient.GetByEmployeeAndCycleAsync(_selectedEmployeeId.Value, _selectedCycleId.Value);
            else if (_selectedCycleId.HasValue)
                response = await EmployeeKPIApiClient.GetByCycleAsync(_selectedCycleId.Value);
            else
                response = await EmployeeKPIApiClient.GetAllAsync();

            if (response.Success && response.Data != null)
            {
                _items = response.Data.ToList();
                _rowNumbers = _items.Select((x, i) => (x.Id, Index: i + 1)).ToDictionary(x => x.Id, x => x.Index);
            }
            else
                Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Task<IEnumerable<long?>> SearchEmployees(string value, CancellationToken _)
    {
        var query = _employees.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.StaffNo.Contains(value, StringComparison.OrdinalIgnoreCase)
                                  || x.StaffName.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).ToList().AsEnumerable());
    }

    private string GetEmployeeDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var emp = _employees.FirstOrDefault(x => x.Id == id);
        return emp != null ? $"{emp.StaffNo} - {emp.StaffName}" : id.ToString()!;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<EmployeeKPIDialog>
        {
            { x => x.PrefilledEmployeeId, _selectedEmployeeId },
            { x => x.PrefilledCycleId, _selectedCycleId }
        };

        var dialog = await DialogService.ShowAsync<EmployeeKPIDialog>(
            UIConstants.EmployeeKPI.CreateDialogTitle, parameters, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Employee KPI created successfully.", Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialog(EmployeeKPIDto item)
    {
        var parameters = new DialogParameters<EmployeeKPIDialog>
        {
            { x => x.Kpi, item }
        };

        var dialog = await DialogService.ShowAsync<EmployeeKPIDialog>(
            UIConstants.EmployeeKPI.EditDialogTitle, parameters, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Employee KPI updated successfully.", Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task OpenDeleteDialog(EmployeeKPIDto item)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, string.Format(UIConstants.Common.DeleteConfirmationFormat,
                $"{item.EmployeeName} - {item.KPIName}") },
            { x => x.ButtonText, UIConstants.Common.Delete },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            UIConstants.EmployeeKPI.DeleteDialogTitle, parameters, _confirmDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            try
            {
                var response = await EmployeeKPIApiClient.DeleteAsync(item.Id);
                if (response.Success)
                {
                    Snackbar.Add("Employee KPI deleted.", Severity.Success);
                    await LoadDataAsync();
                }
                else
                    Snackbar.Add(response.Message ?? UIConstants.Common.DeleteFailed, Severity.Error);
            }
            catch (ApiException ex)
            {
                var error = await ex.GetContentAsAsync<SuccessResponse>();
                Snackbar.Add(error?.Message ?? UIConstants.Common.DeleteFailed, Severity.Error);
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
            }
        }
    }
}
