    private async Task ConfirmComplete()
    {
        if (_selectedMeeting == null) return;
        _isSaving = true;
        try
        {
            var dto = new CompleteMeetingDto
            {
                Summary = _formSummary,
                DiscussionNotes = _formDiscussionNotes,
                PrivateNotes = _formPrivateNotes,
                ActionItems = _formActionItems
            };
            var result = await MeetingApiClient.CompleteAsync(_selectedMeeting.Id, dto);
            if (result.Success)
