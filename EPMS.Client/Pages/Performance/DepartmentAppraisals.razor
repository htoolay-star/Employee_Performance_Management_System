@page "/performance/department-appraisals"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using EPMS.Client.Constants
@using EPMS.Client.Services.Auth
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.FormDTOs
@using EPMS.Shared.DTOs.PerformanceDTOs.AppraisalCycleDTOs
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using Refit

@inject IAppraisalApiClient AppraisalApi
@inject LookupStateService LookupState
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    @if (_error)
    {
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        </MudContainer>
    }
    else
    {
    <MudText Typo="Typo.h4" Class="mb-4">Department Appraisals</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
            <MudSelect T="long?"
                       Value="@_selectedCycleId"
                       ValueChanged="OnCycleChanged"
                       Label="Appraisal Cycle"
                       Variant="Variant.Outlined"
                       Style="max-width: 400px; min-width: 280px;"
                       Clearable="true"
                       Disabled="@_cyclesLoading">
                @if (_cyclesLoading)
                {
                    <MudSelectItem Value="@((long?)null)" Disabled="true">Loading...</MudSelectItem>
                }
                else
                {
                    @foreach (var cycle in _cycles)
                    {
                        <MudSelectItem Value="@((long?)cycle.Id)">@cycle.Name (@cycle.YearLabel)</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudStack>

        @if (_appraisalsLoading)
        {
            <MudStack Spacing="3" Class="w-100">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
            </MudStack>
        }
        else
        {
            <MudAlert Severity="@_alertSeverity" Class="mb-4" Variant="Variant.Filled" Visible="@(!string.IsNullOrEmpty(_message))">
                @_message
            </MudAlert>

            <MudDataGrid Items="@_appraisals"
                         Loading="@_appraisalsLoading"
                         Hover="true"
                         Elevation="0"
                         SortMode="SortMode.None"
                         Class="mb-4">
                <Columns>
                    <TemplateColumn Title="#" Sortable="false" Style="width: 50px;">
                        <CellTemplate>
                            <span style="display: block; text-align: left; padding-right: 12px;">@(_appraisals.IndexOf(context.Item) + 1)</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.EntityName" Title="Department" />
                    <PropertyColumn Property="x => x.EntityHeadName" Title="Dept Head" />
                    <PropertyColumn Property="x => x.CycleName" Title="Cycle" />
                    <TemplateColumn Title="Status" Sortable="false">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.KpiStatus)">@context.Item.KpiStatus</MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="KPI Score" Sortable="false">
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Align="Align.Right">@(context.Item.KpiScore?.ToString("F2") ?? "-")</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Actions" Sortable="false">
                        <CellTemplate>
                            @if (context.Item.KpiStatus is AppraisalStatuses.Kpi.Draft or null)
                            {
                                <MudTooltip Text="Fill KPI" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => Navigation.NavigateTo($"/performance/department-appraisals/{context.Item.Id}/fill"))" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="View KPI" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   OnClick="@(() => Navigation.NavigateTo($"/performance/department-appraisals/{context.Item.Id}/fill"))" />
                                </MudTooltip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                        <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                        <MudText Typo="Typo.h6" Color="Color.Default">No department appraisals found</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">There are no appraisals for the selected cycle.</MudText>
                    </MudStack>
                </NoRecordsContent>
                <PagerContent>
                    <MudDataGridPager T="AppraisalDto" />
                </PagerContent>
            </MudDataGrid>
            }

    </MudPaper>
    }
</MudContainer>

@code {
    private bool _isAdmin;
    private bool _error;
    private string _errorMessage = string.Empty;

    private List<AppraisalCycleDto> _cycles = new();
    private long? _selectedCycleId;
    private bool _cyclesLoading = true;

    private List<AppraisalDto> _appraisals = new();
    private bool _appraisalsLoading;

    private string _message = string.Empty;
    private Severity _alertSeverity = Severity.Normal;

    private const string EntityType = "DEPARTMENT";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Admin") || authState.User.IsInRole("SystemAdmin");

        if (!_isAdmin)
        {
            _error = true;
            _errorMessage = "You do not have permission to view department appraisals.";
            return;
        }

        await LoadCyclesAsync();
        await LoadAppraisalsAsync(null);
    }

    private async Task LoadCyclesAsync()
    {
        _cyclesLoading = true;
        StateHasChanged();
        try
        {
            _cycles = await LookupState.GetCyclesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading cycles: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cyclesLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnCycleChanged(long? cycleId)
    {
        _selectedCycleId = cycleId;
        _message = string.Empty;
        await LoadAppraisalsAsync(cycleId);
    }

    private async Task LoadAppraisalsAsync(long? cycleId)
    {
        _appraisalsLoading = true;
        _message = string.Empty;
        StateHasChanged();
        try
        {
            SuccessResponse<IEnumerable<AppraisalDto>> response;
            if (cycleId.HasValue)
                response = await AppraisalApi.GetByEntityTypeAndCycleAsync(EntityType, cycleId.Value);
            else
                response = await AppraisalApi.GetByEntityTypeAsync(EntityType);

            if (response.Success && response.Data != null)
            {
                _appraisals = response.Data.ToList();
            }
            else
            {
                _message = response.Message ?? "Failed to load appraisals.";
                _alertSeverity = Severity.Error;
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            _message = error?.Message ?? "Failed to load appraisals.";
            _alertSeverity = Severity.Error;
        }
        catch (Exception ex)
        {
            _message = $"Error loading appraisals: {ex.Message}";
            _alertSeverity = Severity.Error;
        }
        finally
        {
            _appraisalsLoading = false;
            StateHasChanged();
        }
    }



    private static Color GetStatusColor(string status) => status switch
    {
        AppraisalStatuses.Kpi.Draft => Color.Warning,
        AppraisalStatuses.Kpi.Reviewed => Color.Primary,
        AppraisalStatuses.Kpi.Finalized => Color.Success,
        _ => Color.Default
    };
}
