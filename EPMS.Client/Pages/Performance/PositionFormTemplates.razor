@page "/performance/position-form-templates"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Auth
@using EPMS.Client.Services.Performance
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.PerformanceDTOs.PositionFormTemplateDTOs
@using MudBlazor
@using Refit

@inject IPositionFormTemplateApiClient PositionFormTemplateApiClient
@inject LookupStateService LookupState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@UIConstants.PositionFormTemplate.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.PositionFormTemplate.PageTitle</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudAutocomplete T="long?"
                                 Value="@_selectedPositionId"
                                 ValueChanged="OnPositionFilterChanged"
                                 Label="Position"
                                 Variant="Variant.Outlined"
                                 Style="max-width: 250px;"
                                 Clearable="true"
                                 SearchFunc="SearchPositions"
                                 ToStringFunc="GetPositionDisplay"
                                 ResetValueOnEmptyText="true" />
            </MudStack>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                @UIConstants.PositionFormTemplate.AddButton
            </MudButton>
        </MudStack>

        <MudDataGrid Items="@_items"
                     Loading="@_loading"
                     Hover="true"
                     Elevation="0"
                     SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="@UIConstants.Common.ColumnNo" Sortable="false" Style="width: 60px;">
                    <CellTemplate>
                        <span style="display: block; text-align: left; padding-right: 12px;">@_rowNumbers.GetValueOrDefault(context.Item.Id)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@UIConstants.PositionFormTemplate.ColumnTemplate">
                    <CellTemplate>
                        @GetTemplateName(context.Item.FormTemplateId)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@UIConstants.PositionFormTemplate.ColumnMandatory">
                    <CellTemplate>
                        <MudChip Color="@(context.Item.IsMandatory ? Color.Primary : Color.Default)"
                                 Size="Size.Small">
                            @(context.Item.IsMandatory ? "Yes" : "No")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@UIConstants.Common.Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="0">
                            <MudTooltip Text="Edit" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEditDialog(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenDeleteDialog(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Common.NoRecords</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@UIConstants.PositionFormTemplate.NoDataFound</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="PositionFormTemplateDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>

@code {

    private static readonly DialogOptions _formDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private static readonly DialogOptions _confirmDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    private long? _selectedPositionId;
    private List<PositionFormTemplateDto> _items = new();
    private Dictionary<long, int> _rowNumbers = new();
    private bool _loading = true;

    private List<LookUpDto> _positions = new();
    private List<LookUpDto> _templates = new();

    protected override async Task OnInitializedAsync()
    {
        _positions = await LookupState.GetPositionsAsync();
        _templates = await LookupState.GetFormTemplatesAsync();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            SuccessResponse<IEnumerable<PositionFormTemplateDto>> response;
            if (_selectedPositionId.HasValue)
                response = await PositionFormTemplateApiClient.GetByPositionIdAsync(_selectedPositionId.Value);
            else
                response = await PositionFormTemplateApiClient.GetAllAsync();

            if (response.Success && response.Data != null)
            {
                _items = response.Data.ToList();
                _rowNumbers = _items.Select((x, i) => (x.Id, Index: i + 1)).ToDictionary(x => x.Id, x => x.Index);
            }
            else
                Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Task<IEnumerable<long?>> SearchPositions(string value, CancellationToken _)
    {
        var query = _positions.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Code.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).ToList().AsEnumerable());
    }

    private string GetPositionDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var pos = _positions.FirstOrDefault(x => x.Id == id);
        return pos?.Code ?? id.ToString()!;
    }

    private string GetTemplateName(long templateId)
    {
        return _templates.FirstOrDefault(t => t.Id == templateId)?.Code ?? $"Template #{templateId}";
    }

    private async Task OnPositionFilterChanged(long? v)
    {
        _selectedPositionId = v;
        await LoadDataAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<PositionFormTemplateDialog>
        {
            { x => x.PrefilledPositionId, _selectedPositionId }
        };

        var dialog = await DialogService.ShowAsync<PositionFormTemplateDialog>(
            UIConstants.PositionFormTemplate.CreateDialogTitle, parameters, _formDialogOptions);

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var createdPositionId = result.Data as long?;
            if (createdPositionId.HasValue)
                _selectedPositionId = createdPositionId.Value;
            Snackbar.Add("Template assigned successfully.", Severity.Success);
            LookupState.ClearFormTemplateCache();
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialog(PositionFormTemplateDto item)
    {
        var parameters = new DialogParameters<PositionFormTemplateDialog>
        {
            { x => x.Assignment, item }
        };

        var dialog = await DialogService.ShowAsync<PositionFormTemplateDialog>(
            UIConstants.PositionFormTemplate.EditDialogTitle, parameters, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Assignment updated successfully.", Severity.Success);
            LookupState.ClearFormTemplateCache();
            await LoadDataAsync();
        }
    }

    private async Task OpenDeleteDialog(PositionFormTemplateDto item)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, string.Format(UIConstants.Common.DeleteConfirmationFormat,
                $"{GetTemplateName(item.FormTemplateId)}") },
            { x => x.ButtonText, UIConstants.Common.Delete },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            UIConstants.PositionFormTemplate.DeleteDialogTitle, parameters, _confirmDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            try
            {
                var response = await PositionFormTemplateApiClient.DeleteAsync(item.Id);
                if (response.Success)
                {
                    Snackbar.Add("Assignment deleted.", Severity.Success);
                    LookupState.ClearFormTemplateCache();
                    await LoadDataAsync();
                }
                else
                    Snackbar.Add(response.Message ?? UIConstants.Common.DeleteFailed, Severity.Error);
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
            }
        }
    }
}
