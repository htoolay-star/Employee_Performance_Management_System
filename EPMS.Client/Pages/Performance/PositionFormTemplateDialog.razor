@* ═══════════════════════════════════════════════════════════════════════════
   PositionFormTemplateDialog — Create / Edit dialog.
   Create: assigns a form template to a position with a mandatory flag.
   Edit: only allows toggling IsMandatory (per update DTO).
   ═══════════════════════════════════════════════════════════════════════════ *@
@using EPMS.Client.Constants
@using EPMS.Client.Models.Performance
@using EPMS.Client.Services.Auth
@using EPMS.Client.Services.Performance
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.PerformanceDTOs.PositionFormTemplateDTOs
@using Mapster
@using MudBlazor

@inject IPositionFormTemplateApiClient PositionFormTemplateApiClient
@inject LookupStateService LookupState
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model" Validation="@ValidateField">
            <MudStack Spacing="3">

                <MudAutocomplete T="long?"
                                 @bind-Value="_model.PositionId"
                                 Label="Position"
                                 Variant="Variant.Outlined"
                                 Disabled="@PrefilledPositionId.HasValue"
                                 SearchFunc="SearchPositions"
                                 ToStringFunc="GetPositionDisplay"
                                 Clearable="true" />

                @if (IsEdit)
                {
                    <MudTextField Value="@GetTemplateNameById(_model.FormTemplateId)"
                                  Label="@UIConstants.PositionFormTemplate.FormTemplateLabel"
                                  Variant="Variant.Outlined"
                                  Disabled="true" />
                }
                else
                {
                    <MudAutocomplete T="long?"
                                     @bind-Value="_model.FormTemplateId"
                                     Label="@UIConstants.PositionFormTemplate.FormTemplateLabel"
                                     Variant="Variant.Outlined"
                                     SearchFunc="SearchTemplates"
                                     ToStringFunc="GetTemplateNameById" />
                }

                <MudSwitch @bind-Value="_model.IsMandatory"
                           Label="@UIConstants.PositionFormTemplate.MandatoryLabel"
                           Color="Color.Primary" />

            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@UIConstants.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   OnClick="Submit"
                   Disabled="@(_saving || !HasChanged())">
            @if (_saving)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
            }
            @(IsEdit ? UIConstants.Common.Update : UIConstants.Common.Create)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    // ── Parameters ────────────────────────────────────────────────────────────
    [CascadingParameter] private IMudDialogInstance? _mudDialog { get; set; }

    [Parameter] public long? PrefilledPositionId { get; set; }
    [Parameter] public PositionFormTemplateDto? Assignment { get; set; }

    // ── Computed ──────────────────────────────────────────────────────────────
    private bool IsEdit => Assignment is not null;

    // ── State ─────────────────────────────────────────────────────────────────
    private MudForm? _form;
    private bool _saving;
    private PositionFormTemplateFormModel _model = new();
    private Dictionary<string, string> _serverErrors = new();

    private List<LookUpDto> _positions = new();
    private List<LookUpDto> _templates = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _positions = await LookupState.GetPositionsAsync();
        _templates = await LookupState.GetFormTemplatesAsync();

        if (IsEdit)
        {
            _model = Assignment.Adapt<PositionFormTemplateFormModel>();
        }
        else
        {
            if (PrefilledPositionId.HasValue)
                _model.PositionId = PrefilledPositionId.Value;
        }

        await base.OnInitializedAsync();
    }

    // ── Actions ───────────────────────────────────────────────────────────────

    private async Task Submit()
    {
        _serverErrors.Clear();

        await _form!.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add(UIConstants.Common.ValidationFailed, Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (IsEdit)
            {
                var dto = _model.Adapt<UpdatePositionFormTemplateDto>();
                var response = await PositionFormTemplateApiClient.UpdateAsync(Assignment!.Id, dto);

                if (response.Success)
                    _mudDialog?.Close(DialogResult.Ok(true));
                else
                    Snackbar.Add(response.Message ?? UIConstants.Common.UpdateFailed, Severity.Error);
            }
            else
            {
                var dto = _model.Adapt<CreatePositionFormTemplateDto>();
                var response = await PositionFormTemplateApiClient.CreateAsync(dto);

                if (response.Success)
                    _mudDialog?.Close(DialogResult.Ok(_model.PositionId));
                else
                    Snackbar.Add(response.Message ?? UIConstants.Common.CreateFailed, Severity.Error);
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ValidationFailed, Severity.Error);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.DuplicateEntry, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => _mudDialog?.Cancel();

    // ── Autocomplete Helpers ──────────────────────────────────────────────────

    private Task<IEnumerable<long?>> SearchPositions(string value, CancellationToken _)
    {
        var query = _positions.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Code.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).ToList().AsEnumerable());
    }

    private string GetPositionDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var pos = _positions.FirstOrDefault(x => x.Id == id);
        return pos?.Code ?? id.ToString()!;
    }

    private Task<IEnumerable<long?>> SearchTemplates(string value, CancellationToken _)
    {
        var query = _templates.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Code.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).ToList().AsEnumerable());
    }

    private string GetTemplateNameById(long? id)
    {
        if (id == null) return string.Empty;
        var tpl = _templates.FirstOrDefault(t => t.Id == id);
        return tpl?.Code ?? id.ToString()!;
    }

    // ── Validation ────────────────────────────────────────────────────────────

    private async Task<IEnumerable<string>> ValidateField(object model, string propertyName)
    {
        var errorList = new List<string>();

        if (!IsEdit)
        {
            if (propertyName == nameof(_model.FormTemplateId) && _model.FormTemplateId is null)
                errorList.Add("Form template is required.");
        }

        if (_serverErrors.TryGetValue(propertyName, out var serverError))
            errorList.Add(serverError);

        return errorList;
    }

    private bool HasChanged()
    {
        if (!IsEdit) return _model.FormTemplateId is not null;

        return _model.IsMandatory != Assignment!.IsMandatory;
    }
}
