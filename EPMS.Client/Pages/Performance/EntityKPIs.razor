@page "/performance/entity-kpis"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using EPMS.Client.Constants
@using EPMS.Client.Services.Auth
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.Performance.EntityKPI
@using MudBlazor
@using Refit

@inject IEntityKPIApiClient EntityKPIApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject LookupStateService LookupState
@inject CurrentUserPermissionService PermService

<PageTitle>@UIConstants.EntityKPI.PageTitle</PageTitle>

@if (_error)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.EntityKPI.PageTitle</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudSelect T="string"
                           Value="@_entityTypeFilter"
                           ValueChanged="OnEntityTypeFilterChanged"
                            Label="Type"
                           Variant="Variant.Outlined"
                           Style="max-width: 200px;"
                           Clearable="true">
                    <MudSelectItem T="string" Value="@AppraisalConstants.EntityTypes.Position">Position</MudSelectItem>
                    <MudSelectItem T="string" Value="@AppraisalConstants.EntityTypes.Department">Department</MudSelectItem>
                    <MudSelectItem T="string" Value="@AppraisalConstants.EntityTypes.Team">Team</MudSelectItem>
                </MudSelect>

                <MudAutocomplete T="long?"
                                 Value="@_selectedEntityId"
                                 ValueChanged="OnEntityFilterChanged"
                                 Label="Assigned To"
                                 Variant="Variant.Outlined"
                                 Style="max-width: 250px;"
                                 Clearable="true"
                                 Disabled="@(string.IsNullOrEmpty(_entityTypeFilter))"
                                 SearchFunc="SearchEntities"
                                 ToStringFunc="GetEntityDisplay"
                                 ResetValueOnEmptyText="true" />
            </MudStack>

            @if (_canCreate)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">
                    @UIConstants.EntityKPI.AddButton
                </MudButton>
            }
        </MudStack>

        <MudDataGrid Items="@_items"
                     Loading="@_loading"
                     Hover="true"
                     Elevation="0"
                     SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="@UIConstants.Common.ColumnNo" Sortable="false" Style="width: 60px;">
                    <CellTemplate>
                        <span style="display: block; text-align: left; padding-right: 12px;">@_rowNumbers.GetValueOrDefault(context.Item.Id)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.EntityType" Title="@UIConstants.EntityKPI.ColumnEntityType" />
                <PropertyColumn Property="x => x.EntityName" Title="@UIConstants.EntityKPI.ColumnEntity" />
                <PropertyColumn Property="x => x.KPIName" Title="@UIConstants.EntityKPI.ColumnKPI" />
                <PropertyColumn Property="x => x.PriorityName" Title="@UIConstants.EntityKPI.ColumnPriority" />
                <PropertyColumn Property="x => x.Weightage" Title="@UIConstants.EntityKPI.ColumnWeightage" Sortable="true" />
                <PropertyColumn Property="x => x.TargetValue" Title="@UIConstants.EntityKPI.ColumnTarget" />
                <PropertyColumn Property="x => x.TargetUnit" Title="@UIConstants.EntityKPI.ColumnUnit" />
                <TemplateColumn Title="@UIConstants.Common.Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudTooltip Text="Edit" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialog(context.Item))" />
                                </MudTooltip>
                            }
                            @if (_canDelete)
                            {
                                <MudTooltip Text="Delete" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenDeleteDialog(context.Item))" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Common.NoRecords</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@UIConstants.EntityKPI.NoDataFound</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="EntityKPIDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>
}

@code {

    private static readonly DialogOptions _formDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private static readonly DialogOptions _confirmDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    private string? _entityTypeFilter;
    private long? _selectedEntityId;
    private List<EntityKPIDto> _items = new();
    private Dictionary<long, int> _rowNumbers = new();
    private bool _loading = true;

    private bool _error;
    private string _errorMessage = string.Empty;
    private bool _canView;
    private bool _canCreate;
    private bool _canEdit;
    private bool _canDelete;

    private List<LookUpDto> _departments = new();
    private List<LookUpDto> _positions = new();
    private List<LookUpDto> _teams = new();

    protected override async Task OnInitializedAsync()
    {
        _canView = await PermService.HasPermissionAsync("ENTITYKPI.VIEW");
        if (!_canView)
        {
            _error = true;
            _errorMessage = "You do not have permission to view Entity KPIs.";
            return;
        }

        _canCreate = await PermService.HasPermissionAsync("ENTITYKPI.CREATE");
        _canEdit = await PermService.HasPermissionAsync("ENTITYKPI.EDIT");
        _canDelete = await PermService.HasPermissionAsync("ENTITYKPI.DELETE");

        _departments = await LookupState.GetDepartmentsAsync();
        _positions = await LookupState.GetPositionsAsync();
        _teams = await LookupState.GetTeamsAsync();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            SuccessResponse<IEnumerable<EntityKPIDto>>? response;

            if (!string.IsNullOrEmpty(_entityTypeFilter))
            {
                if (_selectedEntityId.HasValue)
                    response = await EntityKPIApiClient.GetByEntityAsync(_entityTypeFilter, _selectedEntityId.Value);
                else
                    response = await EntityKPIApiClient.GetByEntityTypeAsync(_entityTypeFilter);
            }
            else
            {
                response = await EntityKPIApiClient.GetAllAsync();
            }

            if (response.Success && response.Data != null)
            {
                _items = response.Data.ToList();
                _rowNumbers = _items.Select((x, i) => (x.Id, Index: i + 1)).ToDictionary(x => x.Id, x => x.Index);
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Task<IEnumerable<long?>> SearchEntities(string value, CancellationToken _)
    {
        var source = _entityTypeFilter?.ToUpperInvariant() switch
        {
            AppraisalConstants.EntityTypes.Position => _positions.Cast<LookUpDto>(),
            AppraisalConstants.EntityTypes.Department => _departments.Cast<LookUpDto>(),
            AppraisalConstants.EntityTypes.Team => _teams.Cast<LookUpDto>(),
            _ => Enumerable.Empty<LookUpDto>()
        };

        var query = source.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).ToList().AsEnumerable());
    }

    private string GetEntityDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var source = _entityTypeFilter?.ToUpperInvariant() switch
        {
            AppraisalConstants.EntityTypes.Position => _positions.AsEnumerable(),
            AppraisalConstants.EntityTypes.Department => _departments.AsEnumerable(),
            AppraisalConstants.EntityTypes.Team => _teams.AsEnumerable(),
            _ => Enumerable.Empty<LookUpDto>()
        };
        var item = source.FirstOrDefault(x => x.Id == id);
        return item != null ? $"{item.Name}" : id.ToString()!;
    }

    private async Task OnEntityTypeFilterChanged(string v)
    {
        _entityTypeFilter = v;
        _selectedEntityId = null;
        await LoadDataAsync();
    }

    private async Task OnEntityFilterChanged(long? v)
    {
        _selectedEntityId = v;
        await LoadDataAsync();
    }

    private async Task OnFilterChanged() => await LoadDataAsync();

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<EntityKPIDialog>
        {
            { x => x.PrefilledEntityType, _entityTypeFilter },
            { x => x.PrefilledEntityId, _selectedEntityId }
        };

        var dialog = await DialogService.ShowAsync<EntityKPIDialog>(
            UIConstants.EntityKPI.CreateDialogTitle, parameters, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("KPI assignment created successfully.", Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialog(EntityKPIDto item)
    {
        var parameters = new DialogParameters<EntityKPIDialog>
        {
            { x => x.KpiAssignment, item }
        };

        var dialog = await DialogService.ShowAsync<EntityKPIDialog>(
            UIConstants.EntityKPI.EditDialogTitle, parameters, _formDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("KPI assignment updated successfully.", Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task OpenDeleteDialog(EntityKPIDto item)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, string.Format(UIConstants.Common.DeleteConfirmationFormat,
                $"{item.EntityType} - {item.KPIName}") },
            { x => x.ButtonText, UIConstants.Common.Delete },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            UIConstants.EntityKPI.DeleteDialogTitle, parameters, _confirmDialogOptions);

        if (await dialog.Result is { Canceled: false })
        {
            try
            {
                var response = await EntityKPIApiClient.DeleteAsync(item.Id);
                if (response.Success)
                {
                    Snackbar.Add("KPI assignment deleted.", Severity.Success);
                    await LoadDataAsync();
                }
                else
                {
                    Snackbar.Add(response.Message ?? UIConstants.Common.DeleteFailed, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
            }
        }
    }
}
