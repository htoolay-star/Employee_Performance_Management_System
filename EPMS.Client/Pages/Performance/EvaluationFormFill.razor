@page "/performance/appraisals/{AppraisalId:long}/evaluate"
@layout BlankLayout
@using EPMS.Client.Constants
@using EPMS.Client.Models.Performance
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.FormDTOs
@using MudBlazor
@using Refit
@using Microsoft.AspNetCore.Components.Authorization

@inject IEvaluationResponseApiClient EvalResponseApiClient
@inject IAppraisalApiClient AppraisalApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthState

<PageTitle>@UIConstants.EvaluationForm.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    @if (_loading)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudStack Spacing="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
            </MudStack>
        </MudPaper>
    }
    else if (_error)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudText Color="Color.Error" Typo="Typo.body1">@_errorMessage</MudText>
        </MudPaper>
    }
    else if (_model == null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudText Typo="Typo.body1">@UIConstants.EvaluationForm.NoFormsAvailable</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudForm @ref="_form">

            @* Header: Back + Centered Title + Form Type & Status *@
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                <MudSimpleTable Class="w-100 mb-4">
                    <tbody>
                        <tr>
                            <td style="width: 48px;">
                                <BackButton Href="@BackHref" />
                            </td>
                            <td style="text-align: center;">
                                <MudText Typo="Typo.h5">@UIConstants.EvaluationForm.PageTitle</MudText>
                            </td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
                <MudSimpleTable Class="w-100">
                    <tbody>
                        <tr>
                            <td style="text-align: left;">
                                <MudText Typo="Typo.body1" Class="mr-2 d-inline">Form Type:</MudText>
                                <MudChip T="string" Size="Size.Medium">@GetRoleDisplay(_model.Role)</MudChip>
                            </td>
                            <td style="text-align: right;">
                                <MudText Typo="Typo.body1" Class="mr-2 d-inline">Status:</MudText>
                                <MudChip T="string" Size="Size.Medium" Color="@GetStatusColor(RoleStatus)">@RoleStatus</MudChip>
                            </td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>

            @* Employee Info *@
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                <MudSimpleTable Class="employee-info-table">
                    <thead>
                        <tr>
                            <th>Staff No</th>
                            <th>Staff Name</th>
                            <th>Position</th>
                            <th>Department</th>
                            @if (!string.IsNullOrEmpty(_model.TeamName))
                            {
                                <th>Team</th>
                            }
                            <th>Manager</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@_model.EmployeeNo</td>
                            <td>@_model.EmployeeName</td>
                            <td>@_model.Position</td>
                            <td>@_model.Department</td>
                            @if (!string.IsNullOrEmpty(_model.TeamName))
                            {
                                <td>@_model.TeamName</td>
                            }
                            <td>@(_model.ManagerName ?? "—")</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>

                @* Submitted Banner *@
                @if (_model.IsSubmitted && !ViewOnly)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4" Dense="true">
                        @UIConstants.EvaluationForm.AlreadySubmitted
                    </MudAlert>
                }

                @* Read-Only Banner *@
                @if (ViewOnly)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
                        You are viewing a submitted evaluation in read-only mode.
                    </MudAlert>
                }

                @* Questions by Template *@
                @{
                    var templateGroups = _model.Questions
                        .GroupBy(q => new { q.TemplateId, q.TemplateName });
                }

                @foreach (var group in templateGroups)
                {
                    var questions = group.ToList();
                    var showYesNo = questions.Any(q => q.HasYesNo);
                    var showComment = questions.Any(q => q.HasComment);

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                        <MudSimpleTable Class="w-100">
                            <colgroup>
                                <col style="width: 40px;" />
                                <col style="width: 120px;" />
                                <col />
                                <col style="width: @(showYesNo ? "220px" : "120px")" />
                                @if (showComment) { <col style="width: 200px;" /> }
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Category</th>
                                    <th>@UIConstants.EvaluationForm.ColumnQuestion</th>
                                    <th>@UIConstants.EvaluationForm.ColumnRating</th>
                                    @if (showComment)
                                    {
                                        <th>@UIConstants.EvaluationForm.ColumnComment</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in questions)
                                {
                                    <tr>
                                        <td>@q.Sequence</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(q.CategoryName))
                                            {
                                                @q.CategoryName
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Default">—</MudText>
                                            }
                                        </td>
                                        <td>@q.QuestionText</td>
                                        <td>
                                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                                @if (q.RatingLevels != null && q.RatingLevels.Any())
                                                {
                                                    var ratingLevelsCap = q.HasYesNo && q.YesNoAnswer == false
                                                        ? (int)Math.Ceiling((q.MaxScore ?? q.RatingLevels.Max(l => l.Rating)) * 0.6)
                                                        : q.RatingLevels.Max(l => l.Rating);
                                                    <MudSelect T="int?"
                                                               Value="@q.RatingValue"
                                                               ValueChanged="@(v => OnRatingChanged(q, v))"
                                                               Variant="Variant.Outlined"
                                                               Margin="Margin.Dense"
                                                                Disabled="@(_model.IsSubmitted || IsRoleLocked || ViewOnly)"
                                                               Style="min-width: 80px;">
                                                        <MudSelectItem T="int?" Value="null">--</MudSelectItem>
                                                        @foreach (var level in q.RatingLevels.Where(l => l.Rating <= ratingLevelsCap).OrderBy(l => l.Rating))
                                                        {
                                                            <MudSelectItem T="int?" Value="@level.Rating">@level.Rating</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                }
                                                else if (q.MaxScore.HasValue)
                                                {
                                                var ratingMax = q.HasYesNo && q.YesNoAnswer == false
                                                    ? (int)Math.Ceiling(q.MaxScore!.Value * 0.6)
                                                    : q.MaxScore!.Value;
                                                    <MudSelect T="int?"
                                                               Value="@q.RatingValue"
                                                               ValueChanged="@(v => OnRatingChanged(q, v))"
                                                               Variant="Variant.Outlined"
                                                               Margin="Margin.Dense"
                                                                Disabled="@(_model.IsSubmitted || IsRoleLocked || ViewOnly)"
                                                               Style="min-width: 80px;">
                                                        <MudSelectItem T="int?" Value="null">--</MudSelectItem>
                                                        @for (var i = 1; i <= ratingMax; i++)
                                                        {
                                                            <MudSelectItem T="int?" Value="@i">@i</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                }
                                                @if (q.HasYesNo)
                                                {
                                                    <MudButton OnClick="() => OnYesNoChanged(q, true)"
                                                               Variant="@(q.YesNoAnswer == true ? Variant.Filled : Variant.Outlined)"
                                                               Color="Color.Success"
                                                                Disabled="@(_model.IsSubmitted || IsRoleLocked || ViewOnly)"
                                                               Size="Size.Small"
                                                               Class="px-3">Yes</MudButton>
                                                    <MudButton OnClick="() => OnYesNoChanged(q, false)"
                                                               Variant="@(q.YesNoAnswer == false ? Variant.Filled : Variant.Outlined)"
                                                               Color="Color.Error"
                                                                Disabled="@(_model.IsSubmitted || IsRoleLocked || ViewOnly)"
                                                               Size="Size.Small"
                                                               Class="px-3">No</MudButton>
                                                }
                                            </MudStack>
                                        </td>
                                        @if (showComment)
                                        {
                                            <td>
                                                <MudTextField T="string" Value="@q.Comment"
                                                              ValueChanged="@(v => { q.Comment = v; _ = OnCommentChanged(q); })"
                                                              Variant="Variant.Outlined"
                                                              Placeholder="@UIConstants.EvaluationForm.CommentPlaceholder"
                                                              Margin="Margin.Dense"
                                                              Disabled="@(_model.IsSubmitted || IsRoleLocked)"
                                                              Immediate="true" />
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudPaper>
                }

                @* Total Score Summary *@
                @{
                    var totalScore = _model.Questions.Sum(q => q.RatingValue ?? 0);
                    var totalMax = _model.Questions.Sum(q => q.MaxScore ?? 0);
                }
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                    <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2">
                            <strong>Total Score:</strong>
                            <MudText Typo="Typo.body1" Color="Color.Primary" Style="display: inline; margin-left: 8px;">
                                @totalScore
                                @if (totalMax > 0)
                                {
                                    <span>/ @totalMax</span>
                                }
                            </MudText>
                        </MudText>
                    </MudStack>
                </MudPaper>

                @* Feedback History (Appraisal Review only) *@
                @if (_currentRole == EvaluatorRoles.Appraisal)
                {
                    <FeedbackHistoryPanel EmployeeId="@_model.EmployeeId" />
                }

                @* Submit Button *@
                @if (!ViewOnly)
                {
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="Submit"
                                   Disabled="@(_submitting || _model.IsSubmitted || IsRoleLocked || _model.Questions.Count == 0)">
                            @if (_submitting)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            }
                            @UIConstants.EvaluationForm.SubmitButton
                        </MudButton>
                    </MudStack>
                }
                @if (_isAdmin && ViewOnly && RoleStatus == GetRoleReviewedStatus())
                {
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="Finalize"
                                   Disabled="@(_submitting)">
                            @if (_submitting)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            }
                            @UIConstants.AppraisalView.FinalizeButton
                        </MudButton>
                    </MudStack>
                }
                else if (ViewOnly && RoleStatus == GetRoleFinalizedStatus())
                {
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudChip T="string" Color="Color.Success">@GetRoleDisplay(_model.Role) Finalized</MudChip>
                    </MudStack>
                }
            </MudForm>
        </MudPaper>
    }
</MudContainer>

@code {

    [Parameter] public long AppraisalId { get; set; }
    [SupplyParameterFromQuery(Name = "role")] public string? ExplicitRole { get; set; }
    [SupplyParameterFromQuery(Name = "viewonly")] public bool ViewOnly { get; set; }
    [SupplyParameterFromQuery(Name = "evaluatorId")] public long? EvaluatorId { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    private string BackHref => From switch
    {
        "my-forms/self" => "/performance/my-forms/self",
        "my-forms/360" => "/performance/my-forms/360",
        "my-forms/appraisal" => "/performance/my-forms/appraisal",
        "my-360-feedback" => "/performance/my-360-feedback",
        "evaluation-pending" => "/performance/evaluations/pending",
        _ => "/performance/appraisals"
    };

    private MudForm? _form;
    private EvaluationFormFillDto? _model;
    private bool _loading = true;
    private bool _error;
    private string _errorMessage = string.Empty;
    private bool _submitting;
    private string _currentRole = string.Empty;
    private bool _isAdmin;
    private readonly Dictionary<long, CancellationTokenSource> _saveCtsDict = new();

    private string RoleStatus => _model switch
    {
        not null when _currentRole == EvaluatorRoles.Self => _model.SelfStatus,
        not null when _currentRole == EvaluatorRoles.Manager => _model.ManagerStatus,
        not null when _currentRole == EvaluatorRoles.Peer => _model.PeerStatus,
        not null when _currentRole == EvaluatorRoles.Subordinate => _model.SubordinateStatus,
        not null when _currentRole == EvaluatorRoles.Appraisal => _model.CommitteeStatus,
        _ => _model?.Status ?? "DRAFT"
    };

    private bool IsRoleLocked => _currentRole switch
    {
        EvaluatorRoles.Appraisal => _model?.AppraisalLocked ?? false,
        EvaluatorRoles.Self => _model?.SelfLocked ?? false,
        EvaluatorRoles.Manager or EvaluatorRoles.Peer or EvaluatorRoles.Subordinate => _model?.ThreeSixtyLocked ?? false,
        _ => false
    };

    private string GetRoleFinalizedStatus() => _currentRole switch
    {
        EvaluatorRoles.Self => AppraisalStatuses.Self.Finalized,
        EvaluatorRoles.Manager => AppraisalStatuses.Manager.Finalized,
        EvaluatorRoles.Peer => AppraisalStatuses.Peer.Finalized,
        EvaluatorRoles.Subordinate => AppraisalStatuses.Subordinate.Finalized,
        EvaluatorRoles.Appraisal => AppraisalStatuses.Committee.Finalized,
        _ => AppraisalStatuses.Finalized
    };

    private string GetRoleReviewedStatus() => _currentRole switch
    {
        EvaluatorRoles.Self => AppraisalStatuses.Self.Reviewed,
        EvaluatorRoles.Appraisal => AppraisalStatuses.Committee.Reviewed,
        _ => AppraisalStatuses.Kpi.Reviewed
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Admin") || authState.User.IsInRole("SystemAdmin");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(ExplicitRole))
            {
                _error = true;
                _errorMessage = UIConstants.EvaluationForm.NoFormsAvailable;
                return;
            }
            _currentRole = ExplicitRole;

            var formResponse = ViewOnly
                ? await EvalResponseApiClient.GetEvaluationViewAsync(AppraisalId, _currentRole, EvaluatorId)
                : await EvalResponseApiClient.GetFormFillAsync(AppraisalId, _currentRole);

            if (formResponse.Success && formResponse.Data != null)
            {
                _model = formResponse.Data;
            }
            else
            {
                _error = true;
                _errorMessage = formResponse.Message ?? UIConstants.Common.LoadFailed;
            }
        }
        catch (ApiException ex)
        {
            _error = true;
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            _errorMessage = error?.Message ?? UIConstants.Common.LoadFailed;
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = string.Format(UIConstants.Common.ErrorFormat, ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnYesNoChanged(EvaluationFormQuestionItem item, bool value)
    {
        item.YesNoAnswer = value;
        if (!value && item.RatingValue.HasValue && item.MaxScore.HasValue)
        {
            var max = (int)Math.Ceiling(item.MaxScore.Value * 0.6);
            if (item.RatingValue > max)
                item.RatingValue = null;
        }
        await DebouncedSaveAsync(item);
    }

    private async Task OnRatingChanged(EvaluationFormQuestionItem item, int? value)
    {
        item.RatingValue = value;
        await DebouncedSaveAsync(item);
    }

    private async Task OnCommentChanged(EvaluationFormQuestionItem item)
    {
        await DebouncedSaveAsync(item);
    }

    private async Task DebouncedSaveAsync(EvaluationFormQuestionItem item)
    {
        if (_saveCtsDict.TryGetValue(item.ResponseId, out var existingCts))
        {
            existingCts.Cancel();
            existingCts.Dispose();
        }

        var cts = new CancellationTokenSource();
        _saveCtsDict[item.ResponseId] = cts;
        var token = cts.Token;

        try
        {
            await Task.Delay(500, token); 

            if (!token.IsCancellationRequested)
            {
                var dto = new UpdateEvaluationResponseDto
                {
                    YesNoAnswer = item.YesNoAnswer,
                    RatingValue = item.RatingValue,
                    Comment = item.Comment
                };

                await EvalResponseApiClient.UpdateAsync(item.ResponseId, dto);
            }
        }
        catch (TaskCanceledException)
        {
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            var errorMessage = error?.Message ?? $"API Error: {ex.StatusCode}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
    }

    private async Task Submit()
    {
        if (_model?.Questions.Any(q => !q.RatingValue.HasValue) == true)
        {
            Snackbar.Add(UIConstants.EvaluationForm.RatingRequired, Severity.Warning);
            return;
        }

        if (_model?.Questions.Any(q => q.HasYesNo && !q.YesNoAnswer.HasValue) == true)
        {
            Snackbar.Add(UIConstants.EvaluationForm.YesNoRequired, Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var dto = new SubmitRoleRequestDto
            {
                AppraisalId = AppraisalId,
                Role = _currentRole
            };

            var response = await EvalResponseApiClient.SubmitRoleResponsesAsync(dto);
            if (response.Success)
            {
                Snackbar.Add(UIConstants.EvaluationForm.SubmitSuccess, Severity.Success);
                await LoadAsync();
                await ShowResultDialog();
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task Finalize()
    {
        if (_submitting) return;

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to finalize this evaluation? This action cannot be undone." },
            { x => x.Color, Color.Primary }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: true }) return;

        _submitting = true;
        StateHasChanged();
        try
        {
            var response = await AppraisalApiClient.FinalizeEvaluationAsync(AppraisalId, _currentRole);
            if (response.Success)
            {
                Snackbar.Add(ServiceResponseMessages.AppraisalMsg.Finalized, Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task ShowResultDialog()
    {
        var parameters = new DialogParameters<SubmitResultDialog>
        {
            { x => x.RatingLabel, _model.RatingLabel ?? "N/A" }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, BackdropClick = false };
        await DialogService.ShowAsync<SubmitResultDialog>("", parameters, options);
    }

    private static string GetRoleDisplay(string role) => role switch
    {
        EvaluatorRoles.Self => "Self Assessment",
        EvaluatorRoles.Manager => "Manager Review",
        EvaluatorRoles.Peer => "Peer Review",
        EvaluatorRoles.Subordinate => "Subordinate Review",
        EvaluatorRoles.Appraisal => "Appraisal Review",
        _ => role
    };

    private Color GetStatusColor(string status) => status switch
    {
        AppraisalStatuses.Self.Draft or AppraisalStatuses.Kpi.Draft or AppraisalStatuses.Committee.Draft or AppraisalStatuses.Manager.Draft or AppraisalStatuses.Peer.Draft or AppraisalStatuses.Subordinate.Draft => Color.Warning,
        AppraisalStatuses.Self.InProgress => Color.Info,
        AppraisalStatuses.Self.Reviewed or AppraisalStatuses.Committee.Reviewed => Color.Primary,
        AppraisalStatuses.Self.Finalized or AppraisalStatuses.Manager.Finalized or AppraisalStatuses.Peer.Finalized or AppraisalStatuses.Subordinate.Finalized or AppraisalStatuses.Committee.Finalized or AppraisalStatuses.Kpi.Finalized => Color.Success,
        _ => Color.Default
    };
}
