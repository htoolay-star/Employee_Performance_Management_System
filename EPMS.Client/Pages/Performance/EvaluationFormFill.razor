@page "/performance/appraisals/{AppraisalId:long}/evaluate"
@using EPMS.Client.Constants
@using EPMS.Client.Models.Performance
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.FormDTOs
@using Mapster
@using MudBlazor
@using Refit
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IEvaluationResponseApiClient EvalResponseApiClient
@inject IAppraisalApiClient AppraisalApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@UIConstants.EvaluationForm.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <MudText Typo="Typo.h4" Class="mb-4">
        <BackButton Href="/performance/appraisals" />
        @UIConstants.EvaluationForm.PageTitle
    </MudText>

    @if (_loading)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudStack Spacing="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
            </MudStack>
        </MudPaper>
    }
    else if (_error)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudText Color="Color.Error" Typo="Typo.body1">@_errorMessage</MudText>
        </MudPaper>
    }
    else if (_model == null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudText Typo="Typo.body1">@UIConstants.EvaluationForm.NoFormsAvailable</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudForm @ref="_form">

                @* Header *@
                <MudSimpleTable Class="mb-4">
                    <tbody>
                        <tr>
                            <td><strong>@UIConstants.EvaluationForm.EmployeeLabel:</strong></td>
                            <td>@_model.EmployeeName</td>
                            <td><strong>Employee Id:</strong></td>
                            <td>@_model.EmployeeNo</td>
                        </tr>
                        <tr>
                            <td><strong>Current Position:</strong></td>
                            <td>@_model.Position</td>
                            <td><strong>Department:</strong></td>
                            <td>@_model.Department</td>
                        </tr>
                        <tr>
                            <td><strong>@UIConstants.EvaluationForm.CycleLabel:</strong></td>
                            <td>@_model.CycleName</td>
                            <td><strong>@UIConstants.EvaluationForm.RoleLabel:</strong></td>
                            <td><MudChip T="string" Size="Size.Small" Color="Color.Primary">@GetRoleDisplay(_model.Role)</MudChip></td>
                        </tr>
                        <tr>
                            <td><strong>@UIConstants.EvaluationForm.StatusLabel:</strong></td>
                            <td><MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_model.Status)">@_model.Status</MudChip></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                </MudSimpleTable>

                @* Submitted Banner *@
                @if (_model.IsSubmitted)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4" Dense="true">
                        @UIConstants.EvaluationForm.AlreadySubmitted
                    </MudAlert>
                }

                @* Read-Only Banner *@
                @if (ViewOnly)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
                        You are viewing the employee's self-assessment in read-only mode.
                    </MudAlert>
                }

                @* Questions by Template *@
                @{
                    var templateGroups = _model.Questions
                        .GroupBy(q => new { q.TemplateId, q.TemplateName });
                    var groupIndex = 0;
                }

                @foreach (var group in templateGroups)
                {
                    groupIndex++;
                    var questions = group.ToList();
                    var showYesNo = questions.Any(q => q.HasYesNo);
                    var showComment = questions.Any(q => q.HasComment);

                    <MudText Typo="Typo.h6" Class="mb-2 mt-4">
                        @(groupIndex). @(string.IsNullOrEmpty(group.Key.TemplateName) ? $"Template #{group.Key.TemplateId}" : group.Key.TemplateName)
                    </MudText>

                    <MudTable Items="@questions" Hover="true" Elevation="0" Class="mb-4">
                        <ColGroup>
                            <col style="width: 40px;" />
                            <col style="width: 120px;" />
                            <col />
                            <col style="width: @(showYesNo ? "220px" : "120px")" />
                            @if (showComment) { <col style="width: 200px;" /> }
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Category</MudTh>
                            <MudTh>@UIConstants.EvaluationForm.ColumnQuestion</MudTh>
                            <MudTh>@UIConstants.EvaluationForm.ColumnRating</MudTh>
                            @if (showComment)
                            {
                                <MudTh>@UIConstants.EvaluationForm.ColumnComment</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="#">@context.Sequence</MudTd>
                            <MudTd DataLabel="Category">
                                @if (!string.IsNullOrEmpty(context.CategoryName))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.CategoryName</MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Default">—</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Question">@context.QuestionText</MudTd>
                            <MudTd DataLabel="Rating">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    @if (context.RatingLevels != null && context.RatingLevels.Any())
                                    {
                                        <MudSelect T="int?"
                                                   Value="@context.RatingValue"
                                                   ValueChanged="@(v => OnRatingChanged(context, v))"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                    Disabled="@(_model.IsSubmitted || _model.IsLocked || ViewOnly)"
                                                   Style="min-width: 80px;">
                                            <MudSelectItem T="int?" Value="null">--</MudSelectItem>
                                            @foreach (var level in context.RatingLevels.OrderBy(l => l.Rating))
                                            {
                                                <MudSelectItem T="int?" Value="@level.Rating">@level.Rating</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    else if (context.MaxScore.HasValue)
                                    {
                                        var ratingMax = context.HasYesNo && context.YesNoAnswer == false
                                            ? (int)Math.Ceiling((context.MaxScore ?? 5) * 0.6)
                                            : (context.MaxScore ?? 5);
                                        <MudSelect T="int?"
                                                   Value="@context.RatingValue"
                                                   ValueChanged="@(v => OnRatingChanged(context, v))"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                    Disabled="@(_model.IsSubmitted || _model.IsLocked || ViewOnly)"
                                                   Style="min-width: 80px;">
                                            <MudSelectItem T="int?" Value="null">--</MudSelectItem>
                                            @for (var i = 1; i <= ratingMax; i++)
                                            {
                                                <MudSelectItem T="int?" Value="@i">@i</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    @if (context.HasYesNo)
                                    {
                                        <MudButton OnClick="() => OnYesNoChanged(context, true)"
                                                   Variant="@(context.YesNoAnswer == true ? Variant.Filled : Variant.Outlined)"
                                                   Color="Color.Success"
                                                    Disabled="@(_model.IsSubmitted || _model.IsLocked || ViewOnly)"
                                                   Size="Size.Small"
                                                   Class="px-3">Yes</MudButton>
                                        <MudButton OnClick="() => OnYesNoChanged(context, false)"
                                                   Variant="@(context.YesNoAnswer == false ? Variant.Filled : Variant.Outlined)"
                                                   Color="Color.Error"
                                                    Disabled="@(_model.IsSubmitted || _model.IsLocked || ViewOnly)"
                                                   Size="Size.Small"
                                                   Class="px-3">No</MudButton>
                                    }
                                </MudStack>
                            </MudTd>
                            @if (showComment)
                            {
                                <MudTd DataLabel="Comment">
                                    <MudTextField T="string" Value="@context.Comment"
                                                  ValueChanged="@(v => { context.Comment = v; _ = OnCommentChanged(context); })"
                                                  Variant="Variant.Outlined"
                                                  Placeholder="@UIConstants.EvaluationForm.CommentPlaceholder"
                                                  Margin="Margin.Dense"
                                                  Disabled="@(_model.IsSubmitted || _model.IsLocked)"
                                                  Immediate="true" />
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                }

                @* Submit Button *@
                @if (!ViewOnly)
                {
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="Submit"
                                   Disabled="@(_submitting || _model.IsSubmitted || _model.IsLocked || _model.Questions.Count == 0)">
                            @if (_submitting)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            }
                            @UIConstants.EvaluationForm.SubmitButton
                        </MudButton>
                    </MudStack>
                }
            </MudForm>
        </MudPaper>
    }
</MudContainer>

@code {

    [Parameter] public long AppraisalId { get; set; }
    [SupplyParameterFromQuery(Name = "role")] public string? ExplicitRole { get; set; }
    [SupplyParameterFromQuery(Name = "viewonly")] public bool ViewOnly { get; set; }

    private MudForm? _form;
    private EvaluationFormFillDto? _model;
    private bool _loading = true;
    private bool _error;
    private string _errorMessage = string.Empty;
    private bool _submitting;
    private long _currentUserId;
    private string _currentRole = string.Empty;
    private CancellationTokenSource? _saveCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrEmpty(userIdClaim) || !long.TryParse(userIdClaim, out _currentUserId))
            {
                _error = true;
                _errorMessage = UIConstants.Common.LoadFailed;
                return;
            }

            var appraisalResponse = await AppraisalApiClient.GetFillAsync(AppraisalId);
            if (!appraisalResponse.Success || appraisalResponse.Data == null)
            {
                _error = true;
                _errorMessage = appraisalResponse.Message ?? UIConstants.Common.LoadFailed;
                return;
            }

            var appraisal = appraisalResponse.Data;

            if (!string.IsNullOrEmpty(ExplicitRole))
            {
                _currentRole = ExplicitRole;
            }
            else
            {
                _currentRole = await ResolveRoleAsync(appraisal);
            }
            if (string.IsNullOrEmpty(_currentRole))
            {
                _loading = false;
                StateHasChanged();
                return;
            }

            SuccessResponse<EvaluationFormFillDto>? formResponse;
            if (ViewOnly && _currentRole == EvaluatorRoles.Self)
            {
                formResponse = await EvalResponseApiClient.GetSelfAssessmentAsync(AppraisalId, _currentUserId);
            }
            else
            {
                formResponse = await EvalResponseApiClient.GetFormFillAsync(AppraisalId, _currentUserId, _currentRole);
            }
            if (formResponse.Success && formResponse.Data != null)
            {
                _model = formResponse.Data;
            }
            else
            {
                _error = true;
                _errorMessage = formResponse.Message ?? UIConstants.Common.LoadFailed;
            }
        }
        catch (ApiException ex)
        {
            _error = true;
            _errorMessage = $"Error loading evaluation: {ex.StatusCode}";
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = string.Format(UIConstants.Common.ErrorFormat, ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task<string> ResolveRoleAsync(AppraisalFillDto appraisal)
    {
        if (_currentUserId == appraisal.EmployeeId)
        {
            var selfResponse = await EvalResponseApiClient.GetFormFillAsync(AppraisalId, _currentUserId, EvaluatorRoles.Self);
            if (selfResponse.Success && selfResponse.Data != null && selfResponse.Data.Questions.Count > 0)
                return EvaluatorRoles.Self;
        }

        if (_currentUserId == appraisal.ManagerReviewerId)
        {
            var mgrResponse = await EvalResponseApiClient.GetFormFillAsync(AppraisalId, _currentUserId, EvaluatorRoles.Manager);
            if (mgrResponse.Success && mgrResponse.Data != null && mgrResponse.Data.Questions.Count > 0)
                return EvaluatorRoles.Manager;
        }

        if (_currentUserId == appraisal.ManagerReviewerId)
        {
            var apprResponse = await EvalResponseApiClient.GetFormFillAsync(AppraisalId, _currentUserId, EvaluatorRoles.Appraisal);
            if (apprResponse.Success && apprResponse.Data != null && apprResponse.Data.Questions.Count > 0)
                return EvaluatorRoles.Appraisal;
        }

        var peerResponse = await EvalResponseApiClient.GetFormFillAsync(AppraisalId, _currentUserId, EvaluatorRoles.Peer);
        if (peerResponse.Success && peerResponse.Data != null && peerResponse.Data.Questions.Count > 0)
            return EvaluatorRoles.Peer;

        var subResponse = await EvalResponseApiClient.GetFormFillAsync(AppraisalId, _currentUserId, EvaluatorRoles.Subordinate);
        if (subResponse.Success && subResponse.Data != null && subResponse.Data.Questions.Count > 0)
            return EvaluatorRoles.Subordinate;

        return string.Empty;
    }

    private async Task OnYesNoChanged(EvaluationFormQuestionItem item, bool value)
    {
        item.YesNoAnswer = value;
        if (!value && item.RatingValue.HasValue)
        {
            var max = (int)Math.Ceiling((item.MaxScore ?? 5) * 0.6);
            if (item.RatingValue > max)
                item.RatingValue = null;
        }
        await DebouncedSaveAsync(item);
    }

    private async Task OnRatingChanged(EvaluationFormQuestionItem item, int? value)
    {
        item.RatingValue = value;
        await DebouncedSaveAsync(item);
    }

    private async Task OnCommentChanged(EvaluationFormQuestionItem item)
    {
        await DebouncedSaveAsync(item);
    }

    private async Task DebouncedSaveAsync(EvaluationFormQuestionItem item)
    {
        _saveCts?.Cancel();
        _saveCts = new CancellationTokenSource();
        var token = _saveCts.Token;

        try
        {
            await Task.Delay(500, token);
            if (!token.IsCancellationRequested)
            {
                var dto = new UpdateEvaluationResponseDto
                {
                    YesNoAnswer = item.YesNoAnswer,
                    RatingValue = item.RatingValue,
                    Comment = item.Comment
                };

                await EvalResponseApiClient.UpdateAsync(item.ResponseId, dto);
            }
        }
        catch (TaskCanceledException)
        {
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
    }

    private async Task Submit()
    {
        if (_model?.Questions.Any(q => !q.RatingValue.HasValue) == true)
        {
            Snackbar.Add(UIConstants.EvaluationForm.RatingRequired, Severity.Warning);
            return;
        }

        if (_model?.Questions.Any(q => q.HasYesNo && !q.YesNoAnswer.HasValue) == true)
        {
            Snackbar.Add(UIConstants.EvaluationForm.YesNoRequired, Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var dto = new SubmitRoleRequestDto
            {
                AppraisalId = AppraisalId,
                EvaluatorId = _currentUserId,
                Role = _currentRole
            };

            var response = await EvalResponseApiClient.SubmitRoleResponsesAsync(dto);
            if (response.Success)
            {
                Snackbar.Add(UIConstants.EvaluationForm.SubmitSuccess, Severity.Success);
                _model = _model! with { IsSubmitted = true };
                await ShowResultDialog();
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task ShowResultDialog()
    {
        var parameters = new DialogParameters<SubmitResultDialog>
        {
            { x => x.RatingLabel, _model.RatingLabel ?? "N/A" }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, BackdropClick = false };
        await DialogService.ShowAsync<SubmitResultDialog>("", parameters, options);
    }

    private static string GetRoleDisplay(string role) => role switch
    {
        EvaluatorRoles.Self => "Self Assessment",
        EvaluatorRoles.Manager => "Manager Review",
        EvaluatorRoles.Peer => "Peer Review",
        EvaluatorRoles.Subordinate => "Subordinate Review",
        EvaluatorRoles.Appraisal => "Appraisal Review",
        _ => role
    };

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Warning,
        "InProgress" => Color.Info,
        "Finalized" => Color.Success,
        _ => Color.Default
    };
}
