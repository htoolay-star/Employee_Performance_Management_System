@page "/performance/my-forms/self"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.FormDTOs
@using EPMS.Shared.DTOs.PerformanceDTOs.AppraisalCycleDTOs
@using MudBlazor
@using Refit
@inject IEvaluationResponseApiClient EvalResponseApiClient
@inject IAppraisalCycleApiClient AppraisalCycleApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@UIConstants.MySelfAssessments.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.MySelfAssessments.PageTitle</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">

        <MudStack Row="true" Class="mb-4" Wrap="Wrap.Wrap">
            <MudSelect T="long?"
                       Value="@_selectedCycleId"
                       ValueChanged="OnCycleChanged"
                       Label="Cycle"
                       Variant="Variant.Outlined"
                       Style="max-width: 200px;"
                       Clearable="true">
                @foreach (var cycle in _cycles)
                {
                    <MudSelectItem Value="@((long?)cycle.Id)">@cycle.Name</MudSelectItem>
                }
            </MudSelect>
        </MudStack>

        <MudDataGrid Items="@_items"
                     Loading="@_loading"
                     Hover="true"
                     Elevation="0"
                     SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="#" Sortable="false" Style="width: 60px;">
                    <CellTemplate>
                        <span style="display: block; text-align: left; padding-right: 12px;">@(_items.IndexOf(context.Item) + 1)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.EmployeeName" Title="Employee" Sortable="true" />
                <PropertyColumn Property="x => x.DepartmentName" Title="Department" Sortable="true" />
                <PropertyColumn Property="x => x.CycleName" Title="Cycle" Sortable="true" />
                <TemplateColumn Title="Status" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.SelfStatus)">@context.Item.SelfStatus</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.IsSubmitted)
                        {
                            <MudTooltip Text="View Self Assessment" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="@(() => NavigateToForm(context.Item))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Fill Self Assessment" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => NavigateToForm(context.Item))" />
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.MySelfAssessments.NoData</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">You have no self assessment forms assigned.</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="MyEvaluationFormDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
</MudContainer>

@code {

    private List<MyEvaluationFormDto> _items = new();
    private List<MyEvaluationFormDto> _allItems = new();
    private List<AppraisalCycleDto> _cycles = new();
    private long? _selectedCycleId;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadCyclesAsync();
        await LoadDataAsync();
    }

    private void OnCycleChanged(long? v)
    {
        _selectedCycleId = v;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _items = _allItems.Where(x => _selectedCycleId == null || x.CycleId == _selectedCycleId).ToList();
        StateHasChanged();
    }

    private async Task LoadCyclesAsync()
    {
        try
        {
            var response = await AppraisalCycleApiClient.GetAllAsync();
            if (response.Success && response.Data != null)
                _cycles = response.Data.ToList();
        }
        catch { }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var response = await EvalResponseApiClient.GetMyFormsAsync("self");
            if (response.Success && response.Data != null)
            {
                _allItems = response.Data.ToList();
                ApplyFilter();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to load forms.", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to load forms.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void NavigateToForm(MyEvaluationFormDto item)
    {
        var url = $"/performance/appraisals/{item.AppraisalId}/evaluate?role={item.Role}&from=my-forms/self";
        Navigation.NavigateTo(url);
    }

    private static Color GetStatusColor(string status) => status switch
    {
        AppraisalStatuses.Self.Draft => Color.Warning,
        AppraisalStatuses.Self.InProgress => Color.Info,
        AppraisalStatuses.Self.Reviewed => Color.Primary,
        AppraisalStatuses.Self.Finalized => Color.Success,
        _ => Color.Default
    };
}
