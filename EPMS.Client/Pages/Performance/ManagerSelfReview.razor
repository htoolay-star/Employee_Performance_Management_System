@page "/performance/appraisals/{AppraisalId:long}/manager-self-review"
@layout BlankLayout
@using EPMS.Client.Constants
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.FormDTOs
@using MudBlazor
@using Refit
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IEvaluationResponseApiClient EvalResponseApiClient
@inject IAppraisalApiClient AppraisalApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@UIConstants.ManagerSelfReview.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    @if (_loading)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudStack Spacing="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
            </MudStack>
        </MudPaper>
    }
    else if (_error)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudText Color="Color.Error" Typo="Typo.body1">@_errorMessage</MudText>
        </MudPaper>
    }
    else if (_model == null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudText Typo="Typo.body1">No self assessment data found.</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
            <MudForm @ref="_form">

            @* Header *@
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                <MudSimpleTable Class="w-100 mb-4">
                    <tbody>
                        <tr>
                            <td style="width: 48px;">
                                <BackButton Href="/performance/manager-self-pending" />
                            </td>
                            <td style="text-align: center;">
                                <MudText Typo="Typo.h5">@UIConstants.ManagerSelfReview.PageTitle</MudText>
                            </td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
                <MudSimpleTable Class="w-100">
                    <tbody>
                        <tr>
                            <td style="text-align: left;">
                                <MudText Typo="Typo.body1" Class="mr-2 d-inline">Form Type:</MudText>
                                <MudChip T="string" Size="Size.Medium">Self Assessment</MudChip>
                            </td>
                            <td style="text-align: right;">
                                <MudText Typo="Typo.body1" Class="mr-2 d-inline">Status:</MudText>
                                <MudChip T="string" Size="Size.Medium" Color="@GetStatusColor(_model.SelfStatus)">@_model.SelfStatus</MudChip>
                            </td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>

            @* Employee Info *@
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                <MudSimpleTable Class="employee-info-table">
                    <thead>
                        <tr>
                            <th>Staff No</th>
                            <th>Staff Name</th>
                            <th>Position</th>
                            <th>Department</th>
                            <th>Manager</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@_model.EmployeeNo</td>
                            <td>@_model.EmployeeName</td>
                            <td>@_model.Position</td>
                            <td>@_model.Department</td>
                            <td>@(_model.ManagerName ?? "—")</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>

            @* Questions by Template *@
            @{
                var templateGroups = _model.Questions
                    .GroupBy(q => new { q.TemplateId, q.TemplateName });
            }

            @foreach (var group in templateGroups)
            {
                var questions = group.ToList();
                var showYesNo = questions.Any(q => q.HasYesNo);
                var showComment = questions.Any(q => q.HasComment);

                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg">
                    <MudSimpleTable Class="w-100">
                        <colgroup>
                            <col style="width: 40px;" />
                            <col style="width: 120px;" />
                            <col />
                            <col style="width: @(showYesNo ? "220px" : "80px")" />
                            @if (showComment) { <col style="width: 200px;" /> }
                        </colgroup>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Category</th>
                                <th>Question</th>
                                <th>Rating</th>
                                @if (showYesNo)
                                {
                                    <th>Yes/No</th>
                                }
                                @if (showComment)
                                {
                                    <th>Comment</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in questions)
                            {
                                <tr>
                                    <td>@q.Sequence</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(q.CategoryName))
                                        {
                                            @q.CategoryName
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Default">—</MudText>
                                        }
                                    </td>
                                    <td>@q.QuestionText</td>
                                    <td>
                                        @if (q.RatingValue.HasValue)
                                        {
                                            @q.RatingValue.Value
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Default">—</MudText>
                                        }
                                    </td>
                                    @if (showYesNo)
                                    {
                                        <td>
                                            @if (q.HasYesNo && q.YesNoAnswer.HasValue)
                                            {
                                                <MudChip T="string" Size="Size.Small"
                                                         Color="@(q.YesNoAnswer.Value ? Color.Success : Color.Error)">
                                                    @(q.YesNoAnswer.Value ? "Yes" : "No")
                                                </MudChip>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Default">—</MudText>
                                            }
                                        </td>
                                    }
                                    @if (showComment)
                                    {
                                        <td>
                                            @if (!string.IsNullOrEmpty(q.Comment))
                                            {
                                                @q.Comment
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Default">—</MudText>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            }

            @* Approve Button *@
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="Approve"
                           Visible="@(_model.SelfStatus == AppraisalStatuses.Self.InProgress)"
                           Disabled="@(_submitting)">
                    @if (_submitting)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    }
                    @UIConstants.ManagerSelfReview.ApproveButton
                </MudButton>
            </MudStack>

            </MudForm>
        </MudPaper>
    }

</MudContainer>

@code {

    [Parameter] public long AppraisalId { get; set; }

    private EvaluationFormFillDto? _model;
    private bool _loading = true;
    private bool _error;
    private string _errorMessage = string.Empty;
    private bool _submitting;
    private MudForm? _form;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        StateHasChanged();
        try
        {
            var response = await EvalResponseApiClient.GetSelfAssessmentAsync(AppraisalId);
            if (response.Success && response.Data != null)
            {
                _model = response.Data;
            }
            else
            {
                _error = true;
                _errorMessage = response.Message ?? "Failed to load self assessment.";
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            _error = true;
            _errorMessage = error?.Message ?? "An error occurred.";
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task Approve()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to approve this self assessment? This action cannot be undone." },
            { x => x.Color, Color.Primary }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: true }) return;

        _submitting = true;
        StateHasChanged();
        try
        {
            var response = await AppraisalApiClient.ApproveSelfAssessmentAsync(AppraisalId);
            if (response.Success)
            {
                Snackbar.Add(UIConstants.ManagerSelfReview.Approved, Severity.Success);
                Navigation.NavigateTo("/performance/manager-self-pending");
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        AppraisalStatuses.Self.Draft => Color.Warning,
        AppraisalStatuses.Self.InProgress => Color.Info,
        AppraisalStatuses.Self.Reviewed => Color.Primary,
        AppraisalStatuses.Self.Finalized => Color.Success,
        _ => Color.Default
    };
}
