@page "/forgot-password"
@using EPMS.Client.Services.Auth
@using EPMS.Shared.DTOs.Auth
@using MudBlazor
@attribute [AllowAnonymous]
@inject IAuthApiClient AuthApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height:100vh;">
    <MudPaper Elevation="25" Class="pa-8 pt-6" Style="width: 100%; max-width: 500px;">
        @if (_otpSent)
        {
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Check Your Email</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6">
                An OTP has been sent to <strong>@_email</strong>. Please check your inbox and use the code to verify your identity.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Href="@($"/verify-otp?email={Uri.EscapeDataString(_email)}")" Class="mt-4">
                Enter OTP
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                       OnClick="ResetForm" Class="mt-2">
                Use a different email
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Forgot Password</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-8">
                Enter your email address and we'll send you an OTP to verify your identity.
            </MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid" @bind-Errors="_errors">
                <MudTextField T="string" Label="Email"
                              @bind-Value="_email"
                              For="@(() => _email)"
                              Required="true" RequiredError="Email is required"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="mb-4" />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mt-2 mb-4">
                        @_errorMessage
                    </MudAlert>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Disabled="!_isValid || _isLoading" OnClick="Submit" Class="mt-4">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send OTP</span>
                    }
                </MudButton>
            </MudForm>

            <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                       Href="login" Class="mt-4">
                Back to Login
            </MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = new();
    private string _email = string.Empty;
    private bool _isValid;
    private string[] _errors = { };
    private string _errorMessage = string.Empty;
    private bool _isLoading;
    private bool _otpSent;

    private async Task Submit()
    {
        _isLoading = true;
        await _form.Validate();
        if (!_isValid) { _isLoading = false; return; }

        _errorMessage = string.Empty;

        try
        {
            var result = await AuthApiClient.ForgotPassword(new ForgotPasswordRequest { Email = _email });
            if (result.Success)
            {
                _otpSent = true;
                Snackbar.Add(result.Message, Severity.Success);
            }
            else
            {
                _errorMessage = result.Message;
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            Snackbar.Add(string.Format(EPMS.Client.Constants.UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetForm()
    {
        _otpSent = false;
        _email = string.Empty;
        _errorMessage = string.Empty;
    }
}
