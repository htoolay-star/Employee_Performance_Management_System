@page "/change-password"
@using EPMS.Client.Services.Auth
@using EPMS.Shared.DTOs.AuthDTOs
@using MudBlazor
@inject IAuthApiClient AuthApiClient
@inject TokenStorage TokenStorage
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height:100vh;">
    <MudPaper Elevation="25" Class="pa-8" Style="width: 100%; max-width: 500px;">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-6">Change Your Password</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-8">
            You must change your default password before continuing.
        </MudText>
        <MudForm @ref="form" @bind-IsValid="success" @bind-Errors="errors">
            <MudTextField T="string" Label="Current Password"
                          @bind-Value="_model.CurrentPassword"
                          InputType="@InputType.Password"
                          Variant="Variant.Outlined" Class="mb-4"
                          Required="true" RequiredError="Current password is required" />
            <MudTextField T="string" Label="New Password"
                          @bind-Value="_model.NewPassword"
                          InputType="@InputType.Password"
                          Variant="Variant.Outlined" Class="mb-4"
                          Required="true" RequiredError="New password is required" />
            <MudTextField T="string" Label="Confirm Password"
                          @bind-Value="_model.ConfirmPassword"
                          InputType="@InputType.Password"
                          Variant="Variant.Outlined" Class="mb-4"
                          Required="true" RequiredError="Please confirm your password" />
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mt-2 mb-4">
                    @_errorMessage
                </MudAlert>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="!success || _isLoading" OnClick="Submit" Class="mt-4">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>Change Password</span>
                }
            </MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm form = new();
    private ChangePasswordModel _model = new();
    private bool success;
    private string[] errors = { };
    private string _errorMessage = string.Empty;
    private bool _isLoading;

    private async Task Submit()
    {
        _isLoading = true;
        await form.Validate();
        if (!success) { _isLoading = false; return; }

        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errorMessage = "New password and confirmation do not match.";
            _isLoading = false;
            return;
        }

        _errorMessage = string.Empty;
        var request = new ChangePasswordRequest
        {
            CurrentPassword = _model.CurrentPassword,
            NewPassword = _model.NewPassword,
            ConfirmPassword = _model.ConfirmPassword
        };

        var result = await AuthApiClient.ChangePassword(request);

        if (result.Success && result.Data != null)
        {
            var newAccessToken = result.Data.Tokens.AccessToken;
            await TokenStorage.SetTokensAsync(
                newAccessToken,
                result.Data.Tokens.RefreshToken);
            ((JwtAuthenticationStateProvider)AuthenticationStateProvider).MarkUserAsAuthenticated(newAccessToken);
            Snackbar.Add("Password changed successfully!", Severity.Success);
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            _errorMessage = result.Message;
            Snackbar.Add(result.Message, Severity.Error);
        }

        _isLoading = false;
    }

    private class ChangePasswordModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
