@page "/logout"
@using EPMS.Client.Services.Auth
@using EPMS.Shared.DTOs.AuthDTOs
@inject IAuthApiClient AuthApiClient
@inject TokenStorage TokenStorage
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CurrentUserPermissionService PermService

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var refreshToken = await TokenStorage.GetRefreshTokenAsync();
            if (!string.IsNullOrEmpty(refreshToken))
            {
                await AuthApiClient.Logout(new LogoutRequest { RefreshToken = refreshToken });
            }
        }
        catch
        {
            // Server call is best-effort — always clear local and logout
        }

        await TokenStorage.ClearTokensAsync();
        ((JwtAuthenticationStateProvider)AuthenticationStateProvider).MarkUserAsLoggedOut();
        PermService.InvalidateCache();
        Navigation.NavigateTo("/login");
    }
}
