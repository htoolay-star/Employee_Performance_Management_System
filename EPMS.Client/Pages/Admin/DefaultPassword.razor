@page "/admin/default-password"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Auth
@using EPMS.Shared.DTOs.AuthDTOs
@using MudBlazor
@attribute [Authorize(Roles = "Admin,SystemAdmin")]
@inject IAuthApiClient AuthApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@UIConstants.DefaultPassword.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="0" Outlined="true" Class="pa-8 rounded-lg">
        <MudText Typo="Typo.h5" Class="mb-2">@UIConstants.DefaultPassword.PageTitle</MudText>
        <MudText Typo="Typo.body2" Class="mb-6">
            This password will be used as the default when creating new users.
            Users will be required to change it on first login.
        </MudText>

        <MudForm @ref="_form" @bind-IsValid="_isValid" @bind-Errors="_errors">
            <MudTextField T="string"
                          Label="@UIConstants.DefaultPassword.NewPasswordLabel"
                          @bind-Value="_newPassword"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="New default password is required" />

            <MudTextField T="string"
                          Label="@UIConstants.DefaultPassword.ConfirmPasswordLabel"
                          @bind-Value="_confirmPassword"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="Please confirm the password" />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mt-2 mb-4">
                    @_errorMessage
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="!_isValid || _isLoading"
                       OnClick="Submit"
                       Class="mt-4">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>@UIConstants.DefaultPassword.SaveButton</span>
                }
            </MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = new();
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isValid;
    private string[] _errors = { };
    private string _errorMessage = string.Empty;
    private bool _isLoading;

    private async Task Submit()
    {
        _isLoading = true;
        await _form.Validate();
        if (!_isValid) { _isLoading = false; return; }

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "Passwords do not match.";
            _isLoading = false;
            return;
        }

        _errorMessage = string.Empty;

        try
        {
            var request = new UpdateDefaultPasswordRequest { NewDefaultPassword = _newPassword };
            var result = await AuthApiClient.UpdateDefaultPassword(request);

            if (result.Success)
            {
                Snackbar.Add(UIConstants.DefaultPassword.SuccessMessage, Severity.Success);
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
            }
            else
            {
                _errorMessage = result.Message;
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
