@page "/admin/default-password"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Auth
@using EPMS.Shared.DTOs.AuthDTOs
@using EPMS.Shared.DTOs.Common
@using MudBlazor
@attribute [Authorize(Roles = "Admin,SystemAdmin")]
@inject IAuthApiClient AuthApiClient
@inject ISnackbar Snackbar

<PageTitle>@UIConstants.DefaultPassword.PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="0" Outlined="true" Class="pa-8 rounded-lg">
        <MudText Typo="Typo.h5" Class="mb-2">@UIConstants.DefaultPassword.PageTitle</MudText>
        <MudText Typo="Typo.body2" Class="mb-6">
            This password will be used as the default when creating new users.
            Users will be required to change it on first login.
        </MudText>

        @* Current Password *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">Current Default Password</MudText>
        <MudTextField T="string"
                      Value="@_currentPassword"
                      ReadOnly="true"
                      InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                      Variant="Variant.Outlined"
                      Class="mb-6"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      AdornmentButton="@(true)"
                      OnAdornmentClick="ToggleCurrentVisibility">
        </MudTextField>

        @* Change Password Section *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">Change Password</MudText>

        <MudForm @ref="_form" @bind-IsValid="_isValid" @bind-Errors="_errors">
            <MudTextField T="string"
                          Label="New Password"
                          @bind-Value="_newPassword"
                          InputType="@(_showNew ? InputType.Text : InputType.Password)"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="New password is required"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentButton="@(true)"
                          OnAdornmentClick="ToggleNewVisibility">
                <Validator>
                    @((string value) =>
                    {
                        if (string.IsNullOrWhiteSpace(value))
                            return "New password is required.";
                        if (value.Length < 6)
                            return "Password must be at least 6 characters.";
                        return null;
                    })
                </Validator>
            </MudTextField>

            <MudTextField T="string"
                          Label="Confirm Password"
                          @bind-Value="_confirmPassword"
                          InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="Please confirm the password"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentButton="@(true)"
                          OnAdornmentClick="ToggleConfirmVisibility">
                <Validator>
                    @((string value) =>
                    {
                        if (string.IsNullOrWhiteSpace(value))
                            return "Please confirm the password.";
                        if (value != _newPassword)
                            return "Passwords do not match.";
                        return null;
                    })
                </Validator>
            </MudTextField>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mt-2 mb-4">
                    @_errorMessage
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="!_isValid || _isLoading"
                       OnClick="Submit"
                       Class="mt-4">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>Change Password</span>
                }
            </MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = new();
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isValid;
    private string[] _errors = { };
    private string _errorMessage = string.Empty;
    private bool _isLoading;
    private bool _showCurrent;
    private bool _showNew;
    private bool _showConfirm;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentPasswordAsync();
    }

    private async Task LoadCurrentPasswordAsync()
    {
        try
        {
            var response = await AuthApiClient.GetDefaultPasswordAsync();
            if (response.Success)
            {
                _currentPassword = response.Data ?? string.Empty;
            }
        }
        catch
        {
        }
    }

    private void ToggleCurrentVisibility() => _showCurrent = !_showCurrent;
    private void ToggleNewVisibility() => _showNew = !_showNew;
    private void ToggleConfirmVisibility() => _showConfirm = !_showConfirm;

    private async Task Submit()
    {
        _isLoading = true;
        await _form.Validate();
        if (!_isValid) { _isLoading = false; return; }

        _errorMessage = string.Empty;

        try
        {
            var request = new UpdateDefaultPasswordRequest { NewDefaultPassword = _newPassword };
            var result = await AuthApiClient.UpdateDefaultPassword(request);

            if (result.Success)
            {
                Snackbar.Add("Default password updated successfully!", Severity.Success);
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
                await LoadCurrentPasswordAsync();
            }
            else
            {
                _errorMessage = result.Message;
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch (Refit.ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            _errorMessage = error?.Message ?? "An error occurred.";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
