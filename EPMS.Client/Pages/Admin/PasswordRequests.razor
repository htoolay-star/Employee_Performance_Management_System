@page "/admin/password-requests"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Auth
@using EPMS.Shared.DTOs.Auth
@using EPMS.Shared.DTOs.Common
@using MudBlazor
@using Refit
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,SystemAdmin")]
@inject IAuthApiClient AuthApiClient
@inject ISnackbar Snackbar

<PageTitle>Password Reset Requests</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Password Reset Requests</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
        <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Primary"
                           Size="Size.Medium"
                           OnClick="LoadDataAsync" />
        </MudStack>

        <MudDataGrid Items="@_requests"
                     Loading="@_loading"
                     Hover="true"
                     Elevation="0"
                     SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="No." Sortable="false" Style="width: 60px;">
                    <CellTemplate>
                        <span>@_rowNumbers.GetValueOrDefault(context.Item.Id)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Email" Title="Email" />
                <PropertyColumn Property="x => x.StaffName" Title="Staff Name" />
                <PropertyColumn Property="x => x.RequestedAt" Title="Requested At" Sortable="true">
                    <CellTemplate>
                        @context.Item.RequestedAt.ToOffset(TimeSpan.FromHours(6.5)).ToString("dd/MM/yyyy hh:mm tt")
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   OnClick="@(() => OpenApproveDialog(context.Item))"
                                   Class="me-2">
                            Approve
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   OnClick="@(() => OpenRejectConfirm(context.Item))">
                            Reject
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">No pending requests</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

<MudDialog @bind-Visible="_showApproveDialog">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">Approve Password Reset</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            Setting new password for <strong>@_selectedRequest?.Email</strong>.
            The user will be required to change this password on first login.
        </MudText>
        <MudForm @ref="_approveForm" @bind-IsValid="_approveFormValid" @bind-Errors="_approveFormErrors">
            <MudTextField T="string"
                          Label="New Password"
                          @bind-Value="_newPassword"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="New password is required" />
            <MudTextField T="string"
                          Label="Confirm Password"
                          @bind-Value="_confirmPassword"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="Please confirm the password" />
            @if (!string.IsNullOrEmpty(_approveError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-4">
                    @_approveError
                </MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default"
                   OnClick="CancelApprove">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="!_approveFormValid || _isApproving"
                   OnClick="ConfirmApprove">
            @if (_isApproving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            <span>Confirm & Set Password</span>
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showRejectDialog">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">Reject Password Reset</MudText>
        <MudText Typo="Typo.body2">
            Are you sure you want to reject the password reset request for <strong>@_selectedRequest?.Email</strong>?
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default"
                   OnClick="CancelReject">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   Disabled="_isRejecting"
                   OnClick="ConfirmReject">
            @if (_isRejecting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            <span>Confirm Reject</span>
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = true;
    private List<PasswordResetRequestDto> _requests = new();
    private Dictionary<long, int> _rowNumbers = new();

    private bool _showApproveDialog;
    private PasswordResetRequestDto? _selectedRequest;
    private MudForm _approveForm = new();
    private bool _approveFormValid;
    private string[] _approveFormErrors = { };
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _approveError = string.Empty;
    private bool _isApproving;

    private bool _showRejectDialog;
    private bool _isRejecting;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var response = await AuthApiClient.GetPendingResetRequests();
            if (response.Success && response.Data != null)
            {
                _requests = response.Data;
                _rowNumbers = _requests
                    .Select((x, i) => (x.Id, Index: i + 1))
                    .ToDictionary(x => x.Id, x => x.Index);
            }
            else
            {
                Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OpenApproveDialog(PasswordResetRequestDto request)
    {
        _selectedRequest = request;
        _newPassword = string.Empty;
        _confirmPassword = string.Empty;
        _approveError = string.Empty;
        _showApproveDialog = true;
    }

    private void CancelApprove()
    {
        _showApproveDialog = false;
        _selectedRequest = null;
    }

    private async Task ConfirmApprove()
    {
        await _approveForm.Validate();
        if (!_approveFormValid) return;

        if (_newPassword != _confirmPassword)
        {
            _approveError = "Passwords do not match.";
            return;
        }

        _isApproving = true;
        _approveError = string.Empty;

        try
        {
            var request = new AdminResetPasswordRequest
            {
                NewPassword = _newPassword,
                ConfirmPassword = _confirmPassword
            };

            var result = await AuthApiClient.ApproveResetRequest(_selectedRequest!.Id, request);
            if (result.Success)
            {
                Snackbar.Add(result.Message, Severity.Success);
                _showApproveDialog = false;
                _selectedRequest = null;
                await LoadDataAsync();
            }
            else
            {
                _approveError = result.Message;
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            _approveError = error?.Message ?? "Failed to approve request.";
            Snackbar.Add(_approveError, Severity.Error);
        }
        catch (Exception ex)
        {
            _approveError = ex.Message;
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _isApproving = false;
        }
    }

    private void OpenRejectConfirm(PasswordResetRequestDto request)
    {
        _selectedRequest = request;
        _showRejectDialog = true;
    }

    private void CancelReject()
    {
        _showRejectDialog = false;
        _selectedRequest = null;
    }

    private async Task ConfirmReject()
    {
        _isRejecting = true;
        try
        {
            var result = await AuthApiClient.RejectResetRequest(_selectedRequest!.Id);
            if (result.Success)
            {
                Snackbar.Add(result.Message, Severity.Success);
                _showRejectDialog = false;
                _selectedRequest = null;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to reject request.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(UIConstants.Common.ErrorFormat, ex.Message), Severity.Error);
        }
        finally
        {
            _isRejecting = false;
        }
    }
}
