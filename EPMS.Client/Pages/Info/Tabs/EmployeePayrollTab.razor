@using EPMS.Client.Extensions
@using EPMS.Client.Models.Info
@using EPMS.Client.Services.Info
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using EPMS.Shared.Validators.EmployeeInfoDTOs
@using Mapster
@using MudBlazor
@using Refit

@inject IEmployeePayrollInfoApiClient PayrollInfoApiClient
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
}
else if (_payrollInfo == null)
{
    <MudAlert Severity="Severity.Info">No payroll data found.</MudAlert>
}
else
{
    <MudPaper Elevation="0" Class="border rounded pa-4">
        <MudForm @ref="_form" Model="@_model" Validation="@ValidateField">
            <MudGrid>

                @* ── Salary Information ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2">Salary Information</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Salary</MudText>
                        <MudText Typo="Typo.body1" Style="text-align: right;">@_payrollInfo.Salary.ToString("N2")</MudText>
                    }
                    else
                    {
                        <MudNumericField @bind-Value="_model.Salary"
                                         Label="Salary"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentText="$"
                                         For="@(() => _model.Salary)"
                                         Style="text-align: right;" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Currency</MudText>
                        <MudText Typo="Typo.body1">@(_payrollInfo.Currency ?? "-")</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" @bind-Value="_model.Currency" Label="Currency" Variant="Variant.Outlined" For="@(() => _model.Currency)">
                            @foreach (var c in Currency.All)
                            {
                                <MudSelectItem Value="@c" />
                            }
                        </MudSelect>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Pay Type</MudText>
                        <MudText Typo="Typo.body1">@(_payrollInfo.PayType ?? "-")</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" @bind-Value="_model.PayType" Label="Pay Type" Variant="Variant.Outlined" For="@(() => _model.PayType)">
                            @foreach (var p in PayType.All)
                            {
                                <MudSelectItem Value="@p" />
                            }
                        </MudSelect>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Date of Pay Type Changed</MudText>
                    <MudText Typo="Typo.body1">@(_payrollInfo.DateOfPayTypeChanged?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                </MudItem>

                @* ── Additional Info ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Additional Info</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Cost Allocate</MudText>
                        <MudText Typo="Typo.body1">@(_payrollInfo.CostAllocate ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.CostAllocate" Label="Cost Allocate" Variant="Variant.Outlined" For="@(() => _model.CostAllocate)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Pay By Backlog</MudText>
                        <MudText Typo="Typo.body1">@(_payrollInfo.PayByBacklog ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.PayByBacklog" Label="Pay By Backlog" Variant="Variant.Outlined" For="@(() => _model.PayByBacklog)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Date of Salary Changed</MudText>
                    <MudText Typo="Typo.body1">@(_payrollInfo.DateOfSalaryChanged?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                </MudItem>

                @* ── Tax Information ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Tax Information</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Tax Status</MudText>
                        <MudText Typo="Typo.body1">@(_payrollInfo.TaxStatus ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.TaxStatus" Label="Tax Status" Variant="Variant.Outlined" For="@(() => _model.TaxStatus)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Tax No</MudText>
                        <MudText Typo="Typo.body1">@(_payrollInfo.TaxNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.TaxNo" Label="Tax No" Variant="Variant.Outlined" For="@(() => _model.TaxNo)" />
                    }
                </MudItem>

                @* ── SSB / SOCSO ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">SSB / SOCSO</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">SSB Status</MudText>
                        <MudText Typo="Typo.body1">@(_payrollInfo.SSBStatus ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.SSBStatus" Label="SSB Status" Variant="Variant.Outlined" For="@(() => _model.SSBStatus)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">SSCB No</MudText>
                        <MudText Typo="Typo.body1">@(_payrollInfo.SSCBNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.SSCBNo" Label="SSCB No" Variant="Variant.Outlined" For="@(() => _model.SSCBNo)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Compliance Earned Points</MudText>
                        <MudText Typo="Typo.body1" Style="text-align: right;">@(_payrollInfo.ComplianceEarnedPoints?.ToString() ?? "-")</MudText>
                    }
                    else
                    {
                        <MudNumericField @bind-Value="_model.ComplianceEarnedPoints"
                                         Label="Compliance Earned Points"
                                         Variant="Variant.Outlined"
                                         For="@(() => _model.ComplianceEarnedPoints)"
                                         Style="text-align: right;" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Compliance Balance Points</MudText>
                        <MudText Typo="Typo.body1" Style="text-align: right;">@(_payrollInfo.ComplianceBalancePoints?.ToString() ?? "-")</MudText>
                    }
                    else
                    {
                        <MudNumericField @bind-Value="_model.ComplianceBalancePoints"
                                         Label="Compliance Balance Points"
                                         Variant="Variant.Outlined"
                                         For="@(() => _model.ComplianceBalancePoints)"
                                         Style="text-align: right;" />
                    }
                </MudItem>

                @* ── Action Buttons ── *@
                <MudItem xs="12">
                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Class="mt-4">
                        @if (!_editMode)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="ToggleEdit">
                                Edit Payroll
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="CancelEdit">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePayrollInfo" Disabled="_saving">
                                @if (_saving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                Save
                            </MudButton>
                        }
                    </MudStack>
                </MudItem>

            </MudGrid>
        </MudForm>
    </MudPaper>
}

@code {
    [Parameter]
    public Guid PublicId { get; set; }

    private EmployeePayrollInfoDto? _payrollInfo;
    private bool _loading = true;
    private bool _editMode = false;
    private bool _saving = false;
    private MudForm? _form;

    private EmployeePayrollFormModel _model = new();
    private Dictionary<string, string> _serverErrors = new();

    private readonly UpdateEmployeePayrollInfoValidator _validator = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var response = await PayrollInfoApiClient.GetByEmployeeIdAsync(PublicId);
            if (response.Success && response.Data != null)
            {
                _payrollInfo = response.Data;
                ResetFormModel();
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to load payroll data", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFormModel()
    {
        if (_payrollInfo == null) return;

        _model = _payrollInfo.Adapt<EmployeePayrollFormModel>();
    }

    private async Task<IEnumerable<string>> ValidateField(object model, string propertyName)
    {
        return await _validator.ValidateMappedValue<EmployeePayrollFormModel, UpdateEmployeePayrollInfoDto>(
            _model, _serverErrors)(model, propertyName);
    }

    private void ToggleEdit()
    {
        _editMode = true;
    }

    private void CancelEdit()
    {
        ResetFormModel();
        _editMode = false;
    }

    private async Task SavePayrollInfo()
    {
        await _form!.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add("Please fill all required fields correctly.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var dto = _model.Adapt<UpdateEmployeePayrollInfoDto>();
            var response = await PayrollInfoApiClient.UpdateAsync(_payrollInfo!.Id, dto);
            if (response.Success)
            {
                Snackbar.Add("Payroll info updated successfully", Severity.Success);
                _editMode = false;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to update payroll info", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to update payroll info", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
