@using EPMS.Client.Extensions
@using EPMS.Client.Models.Info
@using EPMS.Client.Services.Info
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using EPMS.Shared.Validators.EmployeeInfoDTOs
@using Mapster
@using MudBlazor
@using Refit

@inject IEmployeeEmploymentApiClient EmploymentApiClient
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
}
else if (_employment == null)
{
    <MudAlert Severity="Severity.Info">No employment data found.</MudAlert>
}
else
{
    <MudPaper Elevation="0" Class="border rounded pa-4">
        <MudForm @ref="_form" Model="@_model" Validation="@ValidateField">
            <MudGrid>

                @* ── Employment Details ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2">Employment Details</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Employment Status</MudText>
                        <MudText Typo="Typo.body1">@_employment.EmploymentStatus</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" @bind-Value="_model.EmploymentStatus" Label="Employment Status" Variant="Variant.Outlined" For="@(() => _model.EmploymentStatus)">
                            @foreach (var s in EmploymentStatuses.All)
                            {
                                <MudSelectItem Value="@s" />
                            }
                        </MudSelect>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Staff Type</MudText>
                        <MudText Typo="Typo.body1">@(_employment.StaffType ?? "-")</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" @bind-Value="_model.StaffType" Label="Staff Type" Variant="Variant.Outlined" For="@(() => _model.StaffType)">
                            @foreach (var s in StaffTypes.All)
                            {
                                <MudSelectItem Value="@s" />
                            }
                        </MudSelect>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Probation Months</MudText>
                        <MudText Typo="Typo.body1">@(_employment.ProbationMonth?.ToString() ?? "-")</MudText>
                    }
                    else
                    {
                        <MudNumericField @bind-Value="_model.ProbationMonth" Label="Probation Months" Variant="Variant.Outlined" For="@(() => _model.ProbationMonth)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Shift</MudText>
                        <MudText Typo="Typo.body1">@(_employment.Shift ?? "-")</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" @bind-Value="_model.Shift" Label="Shift" Variant="Variant.Outlined" For="@(() => _model.Shift)">
                            @foreach (var s in Shift.All)
                            {
                                <MudSelectItem Value="@s" />
                            }
                        </MudSelect>
                    }
                </MudItem>

                @* ── Dates ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Dates</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Date of Appointment</MudText>
                        <MudText Typo="Typo.body1">@(_employment.DateOfAppointment?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                    }
                    else
                    {
                        <MudDatePicker @bind-Date="_model.DateOfAppointmentProxy" Label="Date of Appointment" Variant="Variant.Outlined" For="@(() => _model.DateOfAppointmentProxy)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Date of Confirmation</MudText>
                        <MudText Typo="Typo.body1">@(_employment.DateOfConfirmation?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                    }
                    else
                    {
                        <MudDatePicker @bind-Date="_model.DateOfConfirmationProxy" Label="Date of Confirmation" Variant="Variant.Outlined" For="@(() => _model.DateOfConfirmationProxy)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Date of Promotion</MudText>
                        <MudText Typo="Typo.body1">@(_employment.DateOfPromotion?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                    }
                    else
                    {
                        <MudDatePicker @bind-Date="_model.DateOfPromotionProxy" Label="Date of Promotion" Variant="Variant.Outlined" For="@(() => _model.DateOfPromotionProxy)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Mobile Attendance</MudText>
                        <MudText Typo="Typo.body1">@(_employment.MobileAttendance ? "Yes" : "No")</MudText>
                    }
                    else
                    {
                        <MudSwitch @bind-Value="_model.MobileAttendance" Label="Mobile Attendance" Color="Color.Success" />
                    }
                </MudItem>

                @* ── Work Information ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Work Information</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Department</MudText>
                    <MudText Typo="Typo.body1">@_employment.DepartmentName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Parent Department</MudText>
                    <MudText Typo="Typo.body1">@_employment.ParentDepartmentName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Team</MudText>
                    <MudText Typo="Typo.body1">@(_employment.TeamName ?? "-")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Position</MudText>
                    <MudText Typo="Typo.body1">@_employment.PositionName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Product/Project</MudText>
                        <MudText Typo="Typo.body1">@(_employment.ProductProject ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.ProductProject" Label="Product/Project" Variant="Variant.Outlined" For="@(() => _model.ProductProject)" />
                    }
                </MudItem>

                @* ── Finger Print ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Finger Print</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Finger Print ID</MudText>
                        <MudText Typo="Typo.body1">@(_employment.FingerPrintId ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.FingerPrintId" Label="Finger Print ID" Variant="Variant.Outlined" For="@(() => _model.FingerPrintId)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Direct Manager</MudText>
                    <MudText Typo="Typo.body1">@(_employment.DirectManagerName ?? "-")</MudText>
                </MudItem>

                @* ── Action Buttons ── *@
                <MudItem xs="12">
                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Class="mt-4">
                        @if (!_editMode)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="ToggleEdit">
                                Edit Employment
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="CancelEdit">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEmployment" Disabled="_saving">
                                @if (_saving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                Save
                            </MudButton>
                        }
                    </MudStack>
                </MudItem>

            </MudGrid>
        </MudForm>
    </MudPaper>
}

@code {
    [Parameter]
    public Guid PublicId { get; set; }

    private EmployeeEmploymentDto? _employment;
    private bool _loading = true;
    private bool _editMode = false;
    private bool _saving = false;
    private MudForm? _form;

    private EmployeeEmploymentFormModel _model = new();
    private Dictionary<string, string> _serverErrors = new();

    private readonly UpdateEmployeeEmploymentValidator _validator = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var response = await EmploymentApiClient.GetByEmployeeIdAsync(PublicId);
            if (response.Success && response.Data != null)
            {
                _employment = response.Data;
                ResetFormModel();
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to load employment data", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFormModel()
    {
        if (_employment == null) return;

        _model = _employment.Adapt<EmployeeEmploymentFormModel>();
    }

    private async Task<IEnumerable<string>> ValidateField(object model, string propertyName)
    {
        return await _validator.ValidateMappedValue<EmployeeEmploymentFormModel, UpdateEmployeeEmploymentDto>(
            _model, _serverErrors)(model, propertyName);
    }

    private void ToggleEdit()
    {
        _editMode = true;
    }

    private void CancelEdit()
    {
        ResetFormModel();
        _editMode = false;
    }

    private async Task SaveEmployment()
    {
        await _form!.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add("Please fill all required fields correctly.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var dto = _model.Adapt<UpdateEmployeeEmploymentDto>();
            var response = await EmploymentApiClient.UpdateAsync(_employment!.Id, dto);
            if (response.Success)
            {
                Snackbar.Add("Employment updated successfully", Severity.Success);
                _editMode = false;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to update employment", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to update employment", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
