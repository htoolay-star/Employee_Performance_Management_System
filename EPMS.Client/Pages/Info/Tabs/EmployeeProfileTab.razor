@using EPMS.Client.Extensions
@using EPMS.Client.Models.Info
@using EPMS.Client.Services.Info
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using EPMS.Shared.Validators.EmployeeInfoDTOs
@using Mapster
@using MudBlazor
@using Refit

@inject IEmployeeProfileApiClient EmployeeProfileApiClient
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" />
}
else if (_employee == null)
{
    <MudAlert Severity="Severity.Info">No profile data found.</MudAlert>
}
else
{
    <MudPaper Elevation="0" Class="border rounded pa-4">
        <MudForm @ref="_form" Model="@_model" Validation="@ValidateField">
            <MudGrid>
                
                @* ── Basic Information ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2">Basic Information</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Staff No</MudText>
                    <MudText Typo="Typo.body1">@_employee.StaffNo</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Staff Name</MudText>
                        <MudText Typo="Typo.body1">@(_employee.StaffName ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.StaffName" Label="Staff Name" Variant="Variant.Outlined" For="@(() => _model.StaffName)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Other Name</MudText>
                        <MudText Typo="Typo.body1">@(_employee.OtherName ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.OtherName" Label="Other Name" Variant="Variant.Outlined" For="@(() => _model.OtherName)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Gender</MudText>
                        <MudText Typo="Typo.body1">@(_employee.Gender ?? "-")</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" @bind-Value="_model.Gender" Label="Gender" Variant="Variant.Outlined" For="@(() => _model.Gender)">
                            @foreach (var g in Genders.All)
                            {
                                <MudSelectItem Value="@g" />
                            }
                        </MudSelect>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Date of Birth</MudText>
                        <MudText Typo="Typo.body1">@(_employee.DateOfBirth?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                    }
                    else
                    {
                        <MudDatePicker @bind-Date="_model.DateOfBirthProxy" Label="Date of Birth" Variant="Variant.Outlined" For="@(() => _model.DateOfBirthProxy)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Email Address</MudText>
                        <MudText Typo="Typo.body1">@(_employee.EmailAddress ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.EmailAddress" Label="Email Address" Variant="Variant.Outlined" For="@(() => _model.EmailAddress)" />
                    }
                </MudItem>

                @* ── Identification ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Identification</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">NRC No</MudText>
                        <MudText Typo="Typo.body1">@(_employee.NRCNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.NRCNo" Label="NRC No" Variant="Variant.Outlined" For="@(() => _model.NRCNo)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Labour Registration No</MudText>
                        <MudText Typo="Typo.body1">@(_employee.LabourRegistrationNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.LabourRegistrationNo" Label="Labour Registration No" Variant="Variant.Outlined" For="@(() => _model.LabourRegistrationNo)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Passport No</MudText>
                        <MudText Typo="Typo.body1">@(_employee.PassportNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.PassportNo" Label="Passport No" Variant="Variant.Outlined" For="@(() => _model.PassportNo)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Passport Expiry</MudText>
                        <MudText Typo="Typo.body1">@(_employee.PassportExpireDate?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                    }
                    else
                    {
                        <MudDatePicker @bind-Date="_model.PassportExpireDateProxy" Label="Passport Expiry" Variant="Variant.Outlined" For="@(() => _model.PassportExpireDateProxy)" />
                    }
                </MudItem>

                @* ── Personal Details ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Personal Details</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Race</MudText>
                        <MudText Typo="Typo.body1">@(_employee.Race ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.Race" Label="Race" Variant="Variant.Outlined" For="@(() => _model.Race)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Religion</MudText>
                        <MudText Typo="Typo.body1">@(_employee.Religion ?? "-")</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" @bind-Value="_model.Religion" Label="Religion" Variant="Variant.Outlined" For="@(() => _model.Religion)">
                            @foreach (var r in Religions.All)
                            {
                                <MudSelectItem Value="@r" />
                            }
                        </MudSelect>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Nationality</MudText>
                        <MudText Typo="Typo.body1">@(_employee.Nationality ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.Nationality" Label="Nationality" Variant="Variant.Outlined" For="@(() => _model.Nationality)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Birth Place</MudText>
                        <MudText Typo="Typo.body1">@(_employee.BirthPlace ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.BirthPlace" Label="Birth Place" Variant="Variant.Outlined" For="@(() => _model.BirthPlace)" />
                    }
                </MudItem>

                @* ── Work Permit ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Work Permit</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Work Permit No</MudText>
                        <MudText Typo="Typo.body1">@(_employee.WorkPermitNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.WorkPermitNo" Label="Work Permit No" Variant="Variant.Outlined" For="@(() => _model.WorkPermitNo)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Work Permit Valid Date</MudText>
                        <MudText Typo="Typo.body1">@(_employee.WorkPermitValidDate?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                    }
                    else
                    {
                        <MudDatePicker @bind-Date="_model.WorkPermitValidDateProxy" Label="Work Permit Valid Date" Variant="Variant.Outlined" For="@(() => _model.WorkPermitValidDateProxy)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Work Permit Expire Date</MudText>
                        <MudText Typo="Typo.body1">@(_employee.WorkPermitExpireDate?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                    }
                    else
                    {
                        <MudDatePicker @bind-Date="_model.WorkPermitExpireDateProxy" Label="Work Permit Expire Date" Variant="Variant.Outlined" For="@(() => _model.WorkPermitExpireDateProxy)" />
                    }
                </MudItem>

                @* ── Action Buttons ── *@
                <MudItem xs="12">
                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Class="mt-4">
                        @if (!_editMode)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="ToggleEdit">
                                Edit Profile
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="CancelEdit">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProfile" Disabled="_saving">
                                @if (_saving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                Save
                            </MudButton>
                        }
                    </MudStack>
                </MudItem>

            </MudGrid>
        </MudForm>
    </MudPaper>
}

@code {
    [Parameter] public Guid PublicId { get; set; }

    private EmployeeProfileDto? _employee;
    private bool _loading = true;
    private bool _editMode = false;
    private bool _saving = false;
    private MudForm? _form;

    private EmployeeProfileFormModel _model = new();
    private Dictionary<string, string> _serverErrors = new();

    private readonly UpdateEmployeeProfileValidator _validator = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var response = await EmployeeProfileApiClient.GetByPublicIdAsync(PublicId);
            if (response.Success && response.Data != null)
            {
                _employee = response.Data;
                ResetFormModel(); 
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to load profile", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFormModel()
    {
        if (_employee == null) return;

        _model = _employee.Adapt<EmployeeProfileFormModel>();
    }

    private async Task<IEnumerable<string>> ValidateField(object model, string propertyName)
    {
        var actualPropertyName = propertyName.EndsWith("Proxy") 
                             ? propertyName.Replace("Proxy", "") 
                             : propertyName;

        return await _validator.ValidateMappedValue<EmployeeProfileFormModel, UpdateEmployeeProfileDto>(
            _model, _serverErrors)(model, actualPropertyName);
    }

    private void ToggleEdit()
    {
        _editMode = true; 
    }

    private void CancelEdit()
    {
        ResetFormModel(); 
        _editMode = false;
    }

    private async Task SaveProfile()
    {
        await _form!.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add("Please fill all required fields correctly.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var dto = _model.Adapt<UpdateEmployeeProfileDto>();
            var response = await EmployeeProfileApiClient.UpdateAsync(_employee!.Id, dto);
            
            if (response.Success)
            {
                Snackbar.Add("Profile updated successfully", Severity.Success);
                _editMode = false;
                await LoadDataAsync(); 
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to update profile", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to update profile", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
