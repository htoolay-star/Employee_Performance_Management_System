@using EPMS.Client.Models.Info
@using EPMS.Client.Services.Info
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using Mapster
@using MudBlazor
@using Refit

@inject IEmployeeProfileApiClient EmployeeProfileApiClient
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
}
else if (_employee == null)
{
    <MudAlert Severity="Severity.Info">No profile data found.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="0" Class="border rounded pa-4">
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2">Basic Information</MudText>
                <MudStack Spacing="2">
                    <MudText><strong>Staff No:</strong> @_employee.StaffNo</MudText>
                    <MudText><strong>Name:</strong> @_employee.StaffName</MudText>
                    <MudText><strong>Other Name:</strong> @_employee.OtherName ?? "-"</MudText>
                    <MudText><strong>Gender:</strong> @_employee.Gender ?? "-"</MudText>
                    <MudText><strong>Date of Birth:</strong> @_employee.DateOfBirth?.ToString("yyyy-MM-dd") ?? "-"</MudText>
                    <MudText><strong>Email:</strong> @_employee.EmailAddress</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="0" Class="border rounded pa-4">
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2">Identification</MudText>
                <MudStack Spacing="2">
                    <MudText><strong>NRC No:</strong> @_employee.NRCNo ?? "-"</MudText>
                    <MudText><strong>Passport No:</strong> @_employee.PassportNo ?? "-"</MudText>
                    <MudText><strong>Passport Expiry:</strong> @_employee.PassportExpireDate?.ToString("yyyy-MM-dd") ?? "-"</MudText>
                    <MudText><strong>Labour Reg No:</strong> @_employee.LabourRegistrationNo ?? "-"</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="0" Class="border rounded pa-4">
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2">Personal Details</MudText>
                <MudStack Spacing="2">
                    <MudText><strong>Race:</strong> @_employee.Race ?? "-"</MudText>
                    <MudText><strong>Religion:</strong> @_employee.Religion ?? "-"</MudText>
                    <MudText><strong>Nationality:</strong> @_employee.Nationality ?? "-"</MudText>
                    <MudText><strong>Birth Place:</strong> @_employee.BirthPlace ?? "-"</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="0" Class="border rounded pa-4">
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2">Work Permit</MudText>
                <MudStack Spacing="2">
                    <MudText><strong>Work Permit No:</strong> @_employee.WorkPermitNo ?? "-"</MudText>
                    <MudText><strong>Valid Date:</strong> @_employee.WorkPermitValidDate?.ToString("yyyy-MM-dd") ?? "-"</MudText>
                    <MudText><strong>Expire Date:</strong> @_employee.WorkPermitExpireDate?.ToString("yyyy-MM-dd") ?? "-"</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="ToggleEdit">
                    Edit Profile
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>

    @if (_editMode)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-4">Edit Profile</MudText>
        <MudPaper Elevation="0" Class="border rounded pa-4">
            <MudForm @ref="_form">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.StaffName"
                                      Label="Staff Name"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.OtherName"
                                      Label="Other Name"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.NRCNo"
                                      Label="NRC No"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_dateOfBirth"
                                       Label="Date of Birth"
                                       Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.EmailAddress"
                                      Label="Email Address"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.Gender" Label="Gender" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Male")" />
                            <MudSelectItem Value="@("Female")" />
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.Race"
                                      Label="Race"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.Religion"
                                      Label="Religion"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.Nationality"
                                      Label="Nationality"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.BirthPlace"
                                      Label="Birth Place"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.PassportNo"
                                      Label="Passport No"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_passportExpiry"
                                       Label="Passport Expiry"
                                       Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.LabourRegistrationNo"
                                      Label="Labour Registration No"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.WorkPermitNo"
                                      Label="Work Permit No"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_workPermitValid"
                                       Label="Work Permit Valid Date"
                                       Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_workPermitExpire"
                                       Label="Work Permit Expire Date"
                                       Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                            <MudButton Variant="Variant.Outlined" OnClick="CancelEdit">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProfile" Disabled="_saving">
                                @if (_saving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                Save
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudPaper>
    }
}

@code {
    [Parameter]
    public long EmployeeId { get; set; }

    [Parameter]
    public Guid PublicId { get; set; }

    private EmployeeProfileDto? _employee;
    private bool _loading = true;
    private bool _editMode = false;
    private bool _saving = false;
    private MudForm? _form;

    private EmployeeProfileFormModel _model = new();
    private DateTime? _dateOfBirth;
    private DateTime? _passportExpiry;
    private DateTime? _workPermitValid;
    private DateTime? _workPermitExpire;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var response = await EmployeeProfileApiClient.GetByIdAsync(EmployeeId);
            if (response.Success && response.Data != null)
            {
                _employee = response.Data;
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to load profile", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleEdit()
    {
        if (_employee == null) return;

        _model = _employee.Adapt<EmployeeProfileFormModel>();
        _dateOfBirth = _employee.DateOfBirth.HasValue ? _employee.DateOfBirth.Value.ToDateTime(TimeOnly.MinValue) : null;
        _passportExpiry = _employee.PassportExpireDate.HasValue ? _employee.PassportExpireDate.Value.ToDateTime(TimeOnly.MinValue) : null;
        _workPermitValid = _employee.WorkPermitValidDate.HasValue ? _employee.WorkPermitValidDate.Value.ToDateTime(TimeOnly.MinValue) : null;
        _workPermitExpire = _employee.WorkPermitExpireDate.HasValue ? _employee.WorkPermitExpireDate.Value.ToDateTime(TimeOnly.MinValue) : null;
        _editMode = true;
    }

    private void CancelEdit()
    {
        _editMode = false;
    }

    private async Task SaveProfile()
    {
        _saving = true;
        try
        {
            _model.DateOfBirth = _dateOfBirth.HasValue ? DateOnly.FromDateTime(_dateOfBirth.Value) : null;
            _model.PassportExpireDate = _passportExpiry.HasValue ? DateOnly.FromDateTime(_passportExpiry.Value) : null;
            _model.WorkPermitValidDate = _workPermitValid.HasValue ? DateOnly.FromDateTime(_workPermitValid.Value) : null;
            _model.WorkPermitExpireDate = _workPermitExpire.HasValue ? DateOnly.FromDateTime(_workPermitExpire.Value) : null;

            var dto = _model.Adapt<UpdateEmployeeProfileDto>();
            var response = await EmployeeProfileApiClient.UpdateAsync(EmployeeId, dto);
            if (response.Success)
            {
                Snackbar.Add("Profile updated successfully", Severity.Success);
                _editMode = false;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to update profile", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to update profile", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}