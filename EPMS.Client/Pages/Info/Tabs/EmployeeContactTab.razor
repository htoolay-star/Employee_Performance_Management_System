@using EPMS.Client.Extensions
@using EPMS.Client.Models.Info
@using EPMS.Client.Services.Info
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using EPMS.Shared.Validators.EmployeeInfoDTOs
@using Mapster
@using MudBlazor
@using Refit

@inject IEmployeeContactApiClient ContactApiClient
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
}
else if (_contact == null)
{
    <MudAlert Severity="Severity.Info">No contact data found.</MudAlert>
}
else
{
    <MudPaper Elevation="0" Class="border rounded pa-4">
        <MudForm @ref="_form" Model="@_model" Validation="@ValidateField">
            <MudGrid>

                @* ── Phone Numbers ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2">Phone Numbers</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Phone No</MudText>
                        <MudText Typo="Typo.body1">@(_contact.PhoneNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.PhoneNo" Label="Phone No" Variant="Variant.Outlined" For="@(() => _model.PhoneNo)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Permanent Phone</MudText>
                        <MudText Typo="Typo.body1">@(_contact.PermanentPhoneNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.PermanentPhoneNo" Label="Permanent Phone No" Variant="Variant.Outlined" For="@(() => _model.PermanentPhoneNo)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Present Phone</MudText>
                        <MudText Typo="Typo.body1">@(_contact.PresentPhoneNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.PresentPhoneNo" Label="Present Phone No" Variant="Variant.Outlined" For="@(() => _model.PresentPhoneNo)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Internal Phone</MudText>
                        <MudText Typo="Typo.body1">@(_contact.InternalPhoneNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.InternalPhoneNo" Label="Internal Phone No" Variant="Variant.Outlined" For="@(() => _model.InternalPhoneNo)" />
                    }
                </MudItem>

                @* ── Addresses ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Addresses</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Contact Address</MudText>
                        <MudText Typo="Typo.body1">@(_contact.ContactAddress ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.ContactAddress" Label="Contact Address" Variant="Variant.Outlined" Lines="2" For="@(() => _model.ContactAddress)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Permanent Address</MudText>
                        <MudText Typo="Typo.body1">@(_contact.PermanentAddress ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.PermanentAddress" Label="Permanent Address" Variant="Variant.Outlined" Lines="2" For="@(() => _model.PermanentAddress)" />
                    }
                </MudItem>

                @* ── Emergency Contact ── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Emergency Contact</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Emergency Mobile</MudText>
                        <MudText Typo="Typo.body1">@(_contact.EmergencyMobileNo ?? "-")</MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_model.EmergencyMobileNo" Label="Emergency Mobile No" Variant="Variant.Outlined" For="@(() => _model.EmergencyMobileNo)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (!_editMode)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Relationship</MudText>
                        <MudText Typo="Typo.body1">@(_contact.RelationWithEmergencyContact ?? "-")</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" @bind-Value="_model.RelationWithEmergencyContact" Label="Relation With Emergency Contact" Variant="Variant.Outlined" For="@(() => _model.RelationWithEmergencyContact)">
                            @foreach (var r in RelationWithEmergencyContact.All)
                            {
                                <MudSelectItem Value="@r" />
                            }
                        </MudSelect>
                    }
                </MudItem>

                @* ── Action Buttons ── *@
                <MudItem xs="12">
                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Class="mt-4">
                        @if (!_editMode)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="ToggleEdit">
                                Edit Contact
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="CancelEdit">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveContact" Disabled="_saving">
                                @if (_saving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                Save
                            </MudButton>
                        }
                    </MudStack>
                </MudItem>

            </MudGrid>
        </MudForm>
    </MudPaper>
}

@code {
    [Parameter]
    public Guid PublicId { get; set; }

    private EmployeeContactDto? _contact;
    private bool _loading = true;
    private bool _editMode = false;
    private bool _saving = false;
    private MudForm? _form;

    private EmployeeContactFormModel _model = new();
    private Dictionary<string, string> _serverErrors = new();

    private readonly UpdateEmployeeContactValidator _validator = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var response = await ContactApiClient.GetByEmployeeIdAsync(PublicId);
            if (response.Success && response.Data != null)
            {
                _contact = response.Data;
                ResetFormModel();
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to load contact data", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFormModel()
    {
        if (_contact == null) return;

        _model = _contact.Adapt<EmployeeContactFormModel>();
    }

    private async Task<IEnumerable<string>> ValidateField(object model, string propertyName)
    {
        return await _validator.ValidateMappedValue<EmployeeContactFormModel, UpdateEmployeeContactDto>(
            _model, _serverErrors)(model, propertyName);
    }

    private void ToggleEdit()
    {
        _editMode = true;
    }

    private void CancelEdit()
    {
        ResetFormModel();
        _editMode = false;
    }

    private async Task SaveContact()
    {
        await _form!.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add("Please fill all required fields correctly.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var dto = _model.Adapt<UpdateEmployeeContactDto>();
            var response = await ContactApiClient.UpdateAsync(_contact!.Id, dto);
            if (response.Success)
            {
                Snackbar.Add("Contact updated successfully", Severity.Success);
                _editMode = false;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to update contact", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to update contact", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
