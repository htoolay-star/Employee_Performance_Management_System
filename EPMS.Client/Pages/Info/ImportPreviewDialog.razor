@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using MudBlazor
@using System.Reflection
@using System.Text.RegularExpressions

@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="@(PreviewResult.ErrorCount > 0 ? Severity.Warning : Severity.Success)"
                      Variant="Variant.Outlined">
                @PreviewResult.ValidCount valid / @PreviewResult.TotalRows total
                @if (PreviewResult.ErrorCount > 0)
                {
                    <span> — @PreviewResult.ErrorCount row(s) have errors.</span>
                }
            </MudAlert>

            <div style="overflow-x: auto; max-height: 450px; overflow-y: auto; border: 1px solid #e0e0e0; border-radius: 4px;">
                <table class="mud-table" style="width: auto; min-width: 100%; white-space: nowrap; font-size: 0.8125rem; border-collapse: collapse;">
                    <thead style="position: sticky; top: 0; background: #f5f5f5; z-index: 1;">
                        <tr>
                            <th style="padding: 8px 12px; text-align: center; border-bottom: 2px solid #e0e0e0;">#</th>
                            <th style="padding: 8px 12px; text-align: center; border-bottom: 2px solid #e0e0e0;"></th>
                            @foreach (var prop in _rowProperties)
                            {
                                <th style="padding: 8px 12px; text-align: left; border-bottom: 2px solid #e0e0e0;">@FormatHeader(prop.Name)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PreviewResult.Rows)
                        {
                            var bg = row.IsValid ? "" : "background: #fff0f0;";
                            <tr>
                                <td style="padding: 4px 12px; text-align: center; @bg">@row.RowNumber</td>
                                <td style="padding: 4px 12px; text-align: center; @bg">
                                    @if (row.IsValid)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Style="vertical-align: middle;" />
                                    }
                                    else
                                    {
                                        <MudTooltip Text="@string.Join(" | ", row.Errors)">
                                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" Style="vertical-align: middle;" />
                                        </MudTooltip>
                                    }
                                </td>
                                @foreach (var prop in _rowProperties)
                                {
                                    var val = prop.GetValue(row.Data);
                                    <td style="padding: 4px 12px; @bg">@(val?.ToString() ?? "")</td>
                                }
                            </tr>
                            @if (!row.IsValid && row.Errors.Count > 0)
                            {
                                <tr style="background: #fff0f0;">
                                    <td colspan="@(2 + _rowProperties.Length)" style="padding: 4px 12px; color: #d32f2f; font-size: 0.75rem;">
                                        @string.Join(" | ", row.Errors)
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Disabled="@(PreviewResult.ValidCount == 0)"
                   StartIcon="@Icons.Material.Filled.Upload"
                   OnClick="Confirm">
            Import @PreviewResult.ValidCount valid row(s)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? _mudDialog { get; set; }

    [Parameter]
    public ImportPreviewResult PreviewResult { get; set; } = null!;

    private static readonly PropertyInfo[] _rowProperties =
        typeof(EmployeeFullImportRow).GetProperties(BindingFlags.Public | BindingFlags.Instance);

    private static readonly Regex _headerRegex = new("(?<=[a-z])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", RegexOptions.Compiled);

    private static string FormatHeader(string name) => _headerRegex.Replace(name, " ");

    private void Confirm() => _mudDialog?.Close(DialogResult.Ok(true));

    private void Cancel() => _mudDialog?.Cancel();
}
