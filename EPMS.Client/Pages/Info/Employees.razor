@page "/hr/employees"
@using EPMS.Client.Constants
@using EPMS.Client.Services.Hr
@using EPMS.Client.Services.Auth
@using EPMS.Client.Services.Info
@using EPMS.Client.Services.Performance
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using EPMS.Shared.Features.EmployeeProfiles
@using MudBlazor
@using Refit
@using static EPMS.Shared.Constants.ServiceResponseMessages

@inject IEmployeeProfileApiClient EmployeeProfileApiClient
@inject IDepartmentApiClient DepartmentApiClient
@inject ITeamApiClient TeamApiClient
@inject IPositionApiClient PositionApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject LookupStateService LookupState
@inject IJSRuntime JS
@inject CurrentUserPermissionService PermService

<PageTitle>@UIConstants.Employee.PageTitle - EPMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@UIConstants.Employee.PageTitle</MudText>

    @if (!_initialized)
    {
        <MudPaper Elevation="2" Class="pa-6" Style="width: 100%;">
            <MudStack Spacing="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
            </MudStack>
        </MudPaper>
    }
    else if (!_canView)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">You do not have permission to view employees.</MudAlert>
    }
    else
    {
    <MudPaper Elevation="2" Class="pa-4">

        @* ── Toolbar ──────────────────────────────────────────────────── *@
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField T="string"
                              Value="@_searchString"
                              ValueChanged="@OnSearchChanged"
                              Immediate="true"
                              DebounceInterval="500"
                              Placeholder="@UIConstants.Employee.SearchPlaceholder"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Style="max-width: 300px;" />

                <MudAutocomplete T="long?"
                           Value="@_departmentFilter"
                           ValueChanged="@OnDepartmentFilterChanged"
                           Placeholder="All Departments"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Style="max-width: 200px;"
                           SearchFunc="SearchFilterDepartments"
                           ToStringFunc="GetFilterDepartmentDisplay"
                           ResetValueOnEmptyText="true"
                           OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                    <ItemTemplate Context="deptId">
                        @{ var dept = _departments.FirstOrDefault(x => x.Id == deptId); }
                        @if (dept != null)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText>@dept.Name</MudText>
                                @if (!dept.IsActive)
                                {
                                        <MudTooltip Text="This department is inactive" Placement="Placement.Right">
                                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                                        </MudTooltip>
                                }
                            </MudStack>
                        }
                    </ItemTemplate>
                </MudAutocomplete>

                <MudAutocomplete T="long?"
                           Value="@_teamFilter"
                           ValueChanged="@OnTeamFilterChanged"
                           Placeholder="All Teams"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Style="max-width: 200px;"
                           SearchFunc="SearchFilterTeams"
                           ToStringFunc="GetFilterTeamDisplay"
                           ResetValueOnEmptyText="true"
                           OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                    <ItemTemplate Context="teamId">
                        @{ var team = _teams.FirstOrDefault(x => x.Id == teamId); }
                        @if (team != null)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText>@team.Name</MudText>
                                @if (!team.IsActive)
                                {
                                        <MudTooltip Text="This team is inactive" Placement="Placement.Right">
                                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                                        </MudTooltip>
                                }
                            </MudStack>
                        }
                    </ItemTemplate>
                </MudAutocomplete>

                <MudAutocomplete T="long?"
                           Value="@_positionFilter"
                           ValueChanged="@OnPositionFilterChanged"
                           Placeholder="All Positions"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Style="max-width: 200px;"
                           SearchFunc="SearchFilterPositions"
                           ToStringFunc="GetFilterPositionDisplay"
                           ResetValueOnEmptyText="true"
                           OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                    <ItemTemplate Context="posId">
                        @{ var pos = _positions.FirstOrDefault(x => x.Id == posId); }
                        @if (pos != null)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText>@pos.Name</MudText>
                                @if (!pos.IsActive)
                                {
                                        <MudTooltip Text="This position is inactive" Placement="Placement.Right">
                                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                                        </MudTooltip>
                                }
                            </MudStack>
                        }
                    </ItemTemplate>
                </MudAutocomplete>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <TableSortControl SortBy="@_sortBy"
                                  SortDirection="@_sortDirection"
                                  SortColumns="@_sortableColumns"
                                  OnSortChanged="OnSortChanged" />
                @if (_canCreate)
                {
                <MudButton Variant="Variant.Outlined" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="DownloadTemplateAsync">
                    Template
                </MudButton>
                <MudFileUpload T="IReadOnlyList<IBrowserFile>" Hidden="true" FilesChanged="OnImportFileSelected">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Upload">
                            Import
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportAsync">
                    Export
                </MudButton>
                @if (_canCreate)
                {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateWizardAsync">
                    Add Employee
                </MudButton>
                }
            </MudStack>

        </MudStack>

        @* ── Data Grid ────────────────────────────────────────────────── *@
        <MudDataGrid @ref="_dataGrid"
                     T="EmployeeProfileGridItemDto"
                     ServerData="LoadServerDataAsync"
                     SortMode="SortMode.None"
                     Hover="true"
                     Striped="true"
                     Dense="true"
                     RowsPerPage="10">
            <Columns>
                <TemplateColumn Title="No." Sortable="true" Class="text-center" HeaderClass="text-center" Style="width: 60px;">
                    <CellTemplate><span style="display: block; text-align: right;">@context.Item.RowIndex</span></CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.StaffNo" Title="@UIConstants.Employee.ColumnStaffNo" />
                <PropertyColumn Property="x => x.StaffName" Title="@UIConstants.Employee.ColumnName" />
                <PropertyColumn Property="x => x.EmailAddress" Title="Email" />

                <PropertyColumn Property="x => x.DepartmentName" Title="@UIConstants.Employee.ColumnDepartment" />
                <PropertyColumn Property="x => x.TeamName" Title="Team" />
                <PropertyColumn Property="x => x.PositionName" Title="@UIConstants.Employee.ColumnPosition" />
                
                <TemplateColumn Title="@UIConstants.Employee.ColumnStatus" Sortable="false">
                    <CellTemplate>
                        @{
                            var status = context.Item.EmploymentStatus;
                            var color = (status ?? EmploymentStatuses.Pending) switch
                            {
                                EmploymentStatuses.Permanent => Color.Success,
                                EmploymentStatuses.Probation => Color.Warning,
                                EmploymentStatuses.Resigned => Color.Error,
                                EmploymentStatuses.Pending => Color.Info,
                                _ => Color.Default
                            };
                        }
                        <MudChip T="string" Color="@color" Size="Size.Small">
                            @(string.IsNullOrEmpty(status) ? EmploymentStatuses.Pending : status)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="@UIConstants.Employee.ColumnActions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudTooltip Text="View Details" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="@(() => NavigateToDetail(context.Item.Id))" />
                            </MudTooltip>
                            @if (_canViewEntityKpi)
                            {
                                <MudTooltip Text="View KPI" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.FactCheck"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenViewKpiDialog(context.Item))" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>

            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 4rem;" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@UIConstants.Common.NoRecords</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@UIConstants.Employee.NoDataFound</MudText>
                </MudStack>
            </NoRecordsContent>
            <LoadingContent>
                <MudStack Spacing="3" Class="w-100">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Animation="Animation.Wave" />
                </MudStack>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager T="EmployeeProfileGridItemDto" />
            </PagerContent>
        </MudDataGrid>

    </MudPaper>
    }
</MudContainer>

@code {
    private MudDataGrid<EmployeeProfileGridItemDto> _dataGrid = null!;
    private bool _isLoading = false;
    private bool _importing = false;
    private byte[]? _importFileBytes;
    private string? _importFileName;
    private bool _initialized;
    private bool _canView;
    private bool _canCreate;
    private bool _canViewEntityKpi;

    private static readonly DialogOptions _kpiDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Large,
        FullWidth = true
    };

    
    // Filters
    private string _searchString = string.Empty;
    private long? _departmentFilter = null;
    private long? _teamFilter = null;
    private long? _positionFilter = null;
    private string _sortBy = "StaffNo";
    private string _sortDirection = "asc";

    private List<LookUpDto> _departments = [];
    private List<LookUpDto> _teams = [];
    private List<LookUpDto> _positions = [];

    private readonly Dictionary<string, string> _sortableColumns = new()
    {
        { "StaffNo", "Staff No" },
        { "StaffName", "Staff Name" }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var deptTask = LookupState.GetDepartmentsAsync();
            var teamTask = LookupState.GetTeamsAsync();
            var posTask = LookupState.GetPositionsAsync();
            var permTask = PermService.GetPermissionsAsync();

            await Task.WhenAll(deptTask, teamTask, posTask, permTask);

            _departments = await deptTask;
            _teams = await teamTask;
            _positions = await posTask;

            var perms = await permTask;
            var permSet = new HashSet<string>(perms);
            _canView = permSet.Contains("EMPLOYEES.VIEW");
            _canCreate = permSet.Contains("EMPLOYEES.CREATE");
            _canViewEntityKpi = permSet.Contains("ENTITYKPI.VIEW");
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Failed to load lookup data", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to load lookup data", Severity.Error);
        }
        finally
        {
            _initialized = true;
        }
    }

    private async Task<GridData<EmployeeProfileGridItemDto>> LoadServerDataAsync(GridState<EmployeeProfileGridItemDto> state)
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var query = new EmployeeProfileQueryParameters
            {
                PageNumber = state.Page + 1,
                PageSize = state.PageSize,
                SearchTerm = string.IsNullOrWhiteSpace(_searchString) ? null : _searchString.Trim(),
                DepartmentId = _departmentFilter,
                TeamId = _teamFilter,
                PositionId = _positionFilter,
                OrderBy = _sortBy,
                SortDirection = _sortDirection
            };

            var response = await EmployeeProfileApiClient.GetPagedAsync(query);

            if (response.Success && response.Data != null)
            {
                var items = response.Data.Items.ToList();

                if (_sortBy == "RowIndex")
                {
                    var startIndex = state.Page * state.PageSize;
                    for (int i = 0; i < items.Count; i++)
                    {
                        items[i] = items[i] with { RowIndex = startIndex + i + 1 };
                    }
                }

                return new GridData<EmployeeProfileGridItemDto>
                {
                    Items = items,
                    TotalItems = response.Data.TotalCount
                };
            }

            Snackbar.Add(response.Message ?? UIConstants.Common.LoadFailed, Severity.Error);
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(UIConstants.Common.ErrorOccurred, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        return new GridData<EmployeeProfileGridItemDto> { Items = [], TotalItems = 0 };
    }

    private async Task OnSearchChanged(string value)
    {
        _searchString = value;
        await RefreshDataAsync();
    }

    private async Task OnDepartmentFilterChanged(long? value)
    {
        _departmentFilter = value;
        await RefreshDataAsync();
    }

    private async Task OnTeamFilterChanged(long? value)
    {
        _teamFilter = value;
        await RefreshDataAsync();
    }

    private async Task OnPositionFilterChanged(long? value)
    {
        _positionFilter = value;
        await RefreshDataAsync();
    }

    private async Task OnSortChanged((string SortBy, string SortDirection) sort)
    {
        _sortBy = sort.SortBy;
        _sortDirection = sort.SortDirection;
        await RefreshDataAsync();
    }

    private Task<IEnumerable<long?>> SearchFilterDepartments(string value, CancellationToken token)
    {
        var query = _departments.AsQueryable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).AsEnumerable());
    }

    private string GetFilterDepartmentDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var dept = _departments.FirstOrDefault(x => x.Id == id);
        if (dept == null) return string.Empty;
        return dept.IsActive ? dept.Name : $"{dept.Name} (Inactive)";
    }

    private Task<IEnumerable<long?>> SearchFilterTeams(string value, CancellationToken token)
    {
        var query = _teams.AsQueryable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).AsEnumerable());
    }

    private string GetFilterTeamDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var team = _teams.FirstOrDefault(x => x.Id == id);
        if (team == null) return string.Empty;
        return team.IsActive ? team.Name : $"{team.Name} (Inactive)";
    }

    private Task<IEnumerable<long?>> SearchFilterPositions(string value, CancellationToken token)
    {
        var query = _positions.AsQueryable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).AsEnumerable());
    }

    private string GetFilterPositionDisplay(long? id)
    {
        if (id == null) return string.Empty;
        var pos = _positions.FirstOrDefault(x => x.Id == id);
        if (pos == null) return string.Empty;
        return pos.IsActive ? pos.Name : $"{pos.Name} (Inactive)";
    }

    private async Task RefreshDataAsync()
    {
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private void NavigateToDetail(long id)
    {
        Navigation.NavigateTo($"/hr/employees/{id}");
    }

    private async Task OpenViewKpiDialog(EmployeeProfileGridItemDto employee)
    {
        var parameters = new DialogParameters<EmployeeKpiViewDialog>
        {
            { x => x.EmployeeId, employee.Id },
            { x => x.EmployeeName, employee.StaffName }
        };

        await DialogService.ShowAsync<EmployeeKpiViewDialog>(
            $"{UIConstants.Employee.ViewKpiDialogTitle} — {employee.StaffName}", parameters, _kpiDialogOptions);
    }

    private async Task OpenCreateWizardAsync()
    {
        var dialog = await DialogService.ShowAsync<EmployeeCreateWizard>("Add Employee");
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is long newId)
        {
            Snackbar.Add("Employee created successfully.", Severity.Success);
            NavigateToDetail(newId);
        }
    }

    private async Task ExportAsync()
    {
        try
        {
            var response = await EmployeeProfileApiClient.ExportAsync();
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("downloadFile", $"employees-{DateTime.Now:yyyy-MM-dd}.xlsx", base64);
                Snackbar.Add("Export completed.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Export failed.", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Export failed.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export error: {ex.Message}", Severity.Error);
        }
    }

    private async Task DownloadTemplateAsync()
    {
        try
        {
            var response = await EmployeeProfileApiClient.ExportTemplateAsync();
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("downloadFile", "employee-import-template.xlsx", base64);
            }
            else
            {
                Snackbar.Add("Template download failed.", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Template download failed.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Template error: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnImportFileSelected(IReadOnlyList<IBrowserFile> files)
    {
        var file = files.FirstOrDefault();
        if (file == null) return;

        _importing = true;
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            _importFileBytes = ms.ToArray();
            _importFileName = file.Name;

            var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(_importFileBytes), "file", _importFileName);

            var preview = await EmployeeProfileApiClient.ImportPreviewAsync(content);

            if (!preview.Success || preview.Data == null)
            {
                Snackbar.Add(preview?.Message ?? "Preview failed.", Severity.Error);
                return;
            }

            var dialog = await DialogService.ShowAsync<ImportPreviewDialog>(
                "Import Preview",
                new DialogParameters { ["PreviewResult"] = preview.Data },
                new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true });

            var result = await dialog.Result;
            if (!result.Canceled)
            {
                await ImportConfirmedAsync();
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Import failed.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
            _importFileBytes = null;
            _importFileName = null;
            StateHasChanged();
        }
    }

    private async Task ImportConfirmedAsync()
    {
        if (_importFileBytes == null) return;

        try
        {
            var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(_importFileBytes), "file", _importFileName ?? "import.xlsx");

            var response = await EmployeeProfileApiClient.ImportAsync(content);
            if (!response.Success || response.Data == null)
            {
                Snackbar.Add(response?.Message ?? "Import failed to queue.", Severity.Error);
                return;
            }

            var jobId = response.Data;

            while (true)
            {
                await Task.Delay(3000);
                var status = await EmployeeProfileApiClient.GetImportStatusAsync(jobId);
                if (status.Success && status.Data != null)
                {
                    var msg = status.Data.Errors.Count > 0
                        ? $"{status.Data.SuccessCount} created, {status.Data.ErrorCount} errors."
                        : $"{status.Data.SuccessCount} employees imported successfully.";
                    Snackbar.Add(msg, status.Data.ErrorCount > 0 ? Severity.Warning : Severity.Success);
                    await RefreshDataAsync();
                    break;
                }
                if (!status.Success)
                {
                    Snackbar.Add(status.Message ?? "Import failed.", Severity.Error);
                    break;
                }
            }
        }
        catch (ApiException ex)
        {
            var error = await ex.GetContentAsAsync<SuccessResponse>();
            Snackbar.Add(error?.Message ?? "Import failed.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import error: {ex.Message}", Severity.Error);
        }
    }
}
