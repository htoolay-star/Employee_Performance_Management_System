                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.Religion" Label="Religion" Variant="Variant.Outlined" For="@(() => _model.Religion)">
                            @foreach (var r in Religions.All)
                            {
                                <MudSelectItem Value="@r" />
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.MaritalStatus" Label="Marital Status" Variant="Variant.Outlined" For="@(() => _model.MaritalStatus)">
                            @foreach (var m in MaritalStatuses.All)
                            {
                                <MudSelectItem Value="@m" />
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.RelationWithEmergencyContact" Label="Emergency Contact Relation" Variant="Variant.Outlined" For="@(() => _model.RelationWithEmergencyContact)">
