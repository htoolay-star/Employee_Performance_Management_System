@using EPMS.Client.Extensions
@using EPMS.Client.Models.Info
@using EPMS.Client.Services.Info
@using EPMS.Client.Services.Auth
@using EPMS.Shared.Constants
@using EPMS.Shared.DTOs.Common
@using EPMS.Shared.DTOs.EmployeeInfoDTOs
@using EPMS.Shared.Validators.EmployeeInfoDTOs
@using Mapster
@using MudBlazor

@inject IEmployeeProfileApiClient EmployeeProfileApiClient
@inject ISnackbar Snackbar
@inject LookupStateService LookupState

<MudDialog MaxWidth="MaxWidth.Large" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="w-100">
            <MudText Typo="Typo.h6">Create Employee</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" />
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model" Validation="@ValidateField">
            <MudStack Spacing="3">

                @* ── ✏️ Text Fields ── *@
                <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">Enter text values</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.StaffNo" Label="Staff No" Variant="Variant.Outlined" For="@(() => _model.StaffNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.StaffName" Label="Staff Name" Variant="Variant.Outlined" For="@(() => _model.StaffName)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.OtherName" Label="Other Name" Variant="Variant.Outlined" For="@(() => _model.OtherName)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.NRCNo" Label="NRC No" Variant="Variant.Outlined" For="@(() => _model.NRCNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.Race" Label="Race" Variant="Variant.Outlined" For="@(() => _model.Race)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.Religion" Label="Religion" Variant="Variant.Outlined" For="@(() => _model.Religion)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.Nationality" Label="Nationality" Variant="Variant.Outlined" For="@(() => _model.Nationality)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.BirthPlace" Label="Birth Place" Variant="Variant.Outlined" For="@(() => _model.BirthPlace)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.EmailAddress" Label="Email Address" Variant="Variant.Outlined" For="@(() => _model.EmailAddress)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.PassportNo" Label="Passport No" Variant="Variant.Outlined" For="@(() => _model.PassportNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.WorkPermitNo" Label="Work Permit No" Variant="Variant.Outlined" For="@(() => _model.WorkPermitNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.LabourRegistrationNo" Label="Labour Registration No" Variant="Variant.Outlined" For="@(() => _model.LabourRegistrationNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.PhoneNo" Label="Phone No" Variant="Variant.Outlined" For="@(() => _model.PhoneNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.PermanentPhoneNo" Label="Permanent Phone" Variant="Variant.Outlined" For="@(() => _model.PermanentPhoneNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.PresentPhoneNo" Label="Present Phone" Variant="Variant.Outlined" For="@(() => _model.PresentPhoneNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.InternalPhoneNo" Label="Internal Phone" Variant="Variant.Outlined" For="@(() => _model.InternalPhoneNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.EmergencyMobileNo" Label="Emergency Mobile" Variant="Variant.Outlined" For="@(() => _model.EmergencyMobileNo)" />
                    </MudItem>
