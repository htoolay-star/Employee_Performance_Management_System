                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.Gender" Label="Gender" Variant="Variant.Outlined" For="@(() => _model.Gender)">
                            @foreach (var g in Genders.All)
                            {
                                <MudSelectItem Value="@g" />
