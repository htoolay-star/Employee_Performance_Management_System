                        <MudTextField @bind-Value="_model.FingerPrintId" Label="Finger Print ID" Variant="Variant.Outlined" For="@(() => _model.FingerPrintId)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.ProductProject" Label="Product/Project" Variant="Variant.Outlined" For="@(() => _model.ProductProject)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.SpouseName" Label="Spouse Name" Variant="Variant.Outlined" For="@(() => _model.SpouseName)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.SpouseNRCNo" Label="Spouse NRC No" Variant="Variant.Outlined" For="@(() => _model.SpouseNRCNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.SpouseOccupation" Label="Spouse Occupation" Variant="Variant.Outlined" For="@(() => _model.SpouseOccupation)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.FatherName" Label="Father Name" Variant="Variant.Outlined" For="@(() => _model.FatherName)" />
