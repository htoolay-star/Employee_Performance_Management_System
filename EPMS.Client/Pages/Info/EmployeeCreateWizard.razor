                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.EmploymentStatus" Label="Employment Status" Variant="Variant.Outlined" For="@(() => _model.EmploymentStatus)">
                            @foreach (var s in EmploymentStatuses.All)
                            {
                                <MudSelectItem Value="@s" />
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.StaffType" Label="Staff Type" Variant="Variant.Outlined" For="@(() => _model.StaffType)">
                            @foreach (var s in StaffTypes.All)
                            {
                                <MudSelectItem Value="@s" />
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.Shift" Label="Shift" Variant="Variant.Outlined" For="@(() => _model.Shift)">
                            @foreach (var s in Shift.All)
                            {
                                <MudSelectItem Value="@s" />
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.Currency" Label="Currency" Variant="Variant.Outlined" For="@(() => _model.Currency)">
                            @foreach (var c in Currency.All)
                            {
                                <MudSelectItem Value="@c" />
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.PayType" Label="Pay Type" Variant="Variant.Outlined" For="@(() => _model.PayType)">
                            @foreach (var p in PayType.All)
                            {
                                <MudSelectItem Value="@p" />
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                @* ── 🔍 Search Fields ── *@
                <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">Type to search and select</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                     <MudAutocomplete T="long"
                            @bind-Value="_model.DepartmentId"
                            Label="Department"
                            Variant="Variant.Outlined"
                            For="@(() => _model.DepartmentId)"
                            Clearable="true"
                            SearchFunc="SearchDepartments"
                            ToStringFunc="GetDepartmentDisplay"
                            OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                             <ItemTemplate Context="deptId">
                                 @{ var dept = _departments.FirstOrDefault(x => x.Id == deptId); }
                                  @if (dept != null)
                                  {
                                      <MudText>@dept.Name</MudText>
                                  }
                              </ItemTemplate>
                          </MudAutocomplete>
                      </MudItem>
                      <MudItem xs="12" sm="6">
                          <MudAutocomplete T="long"
                             @bind-Value="_model.ParentDepartmentId"
                             Label="Parent Department"
                             Variant="Variant.Outlined"
                             For="@(() => _model.ParentDepartmentId)"
                             Clearable="true"
                             SearchFunc="SearchDepartments"
                             ToStringFunc="GetDepartmentDisplay"
                             OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                              <ItemTemplate Context="deptId">
                                  @{ var dept = _departments.FirstOrDefault(x => x.Id == deptId); }
                                  @if (dept != null)
                                  {
                                      <MudText>@dept.Name</MudText>
                                  }
                              </ItemTemplate>
                          </MudAutocomplete>
                      </MudItem>
                      <MudItem xs="12" sm="6">
                          <MudAutocomplete T="long"
                             @bind-Value="_model.PositionId"
                             Label="Position"
                             Variant="Variant.Outlined"
                             For="@(() => _model.PositionId)"
                             Clearable="true"
                             SearchFunc="SearchPositions"
                             ToStringFunc="GetPositionDisplay"
                             OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                              <ItemTemplate Context="posId">
                                  @{ var pos = _positions.FirstOrDefault(x => x.Id == posId); }
                                  @if (pos != null)
                                  {
                                      <MudText>@pos.Name</MudText>
                                  }
                              </ItemTemplate>
                         </MudAutocomplete>
                     </MudItem>
                     <MudItem xs="12" sm="6">
                         <MudAutocomplete T="long?"
                            @bind-Value="_model.TeamId"
                            Label="Team"
                            Variant="Variant.Outlined"
                            For="@(() => _model.TeamId)"
                            Clearable="true"
                            SearchFunc="SearchTeams"
                            ToStringFunc="GetTeamDisplay"
                            ResetValueOnEmptyText="true"
                            OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                             <ItemTemplate Context="teamId">
                                 @{ var team = teamId.HasValue ? _teams.FirstOrDefault(x => x.Id == teamId.Value) : null; }
                                 @if (team != null)
                                 {
                                     <MudText>@team.Name</MudText>
                                }
                            </ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="long?"
                           @bind-Value="_model.DirectManagerId"
                           Label="Direct Manager"
                           Variant="Variant.Outlined"
                           For="@(() => _model.DirectManagerId)"
                           Clearable="true"
                           SearchFunc="SearchEmployees"
                           ToStringFunc="GetEmployeeDisplay"
                           ResetValueOnEmptyText="true"
                           OpenIcon="@Icons.Material.Filled.ArrowDropDown">
                            <ItemTemplate Context="empId">
                                @{ var emp = empId.HasValue ? _employees.FirstOrDefault(x => x.Id == empId.Value) : null; }
                                @if (emp != null)
                                {
                                    <MudText>@emp.StaffNo - @emp.StaffName</MudText>
                                }
                            </ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>
                </MudGrid>

                @* ── 🔢 Number Fields ── *@
                <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">Enter numeric values</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_model.ProbationMonth" Label="Probation Months" Variant="Variant.Outlined" For="@(() => _model.ProbationMonth)" Style="text-align: right;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_model.Salary" Label="Salary" Variant="Variant.Outlined" For="@(() => _model.Salary)" Style="text-align: right;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_model.ComplianceEarnedPoints" Label="Compliance Earned Points" Variant="Variant.Outlined" For="@(() => _model.ComplianceEarnedPoints)" Style="text-align: right;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_model.ComplianceBalancePoints" Label="Compliance Balance Points" Variant="Variant.Outlined" For="@(() => _model.ComplianceBalancePoints)" Style="text-align: right;" />
                    </MudItem>
                </MudGrid>

                @* ── 📅 Date Fields ── *@
                <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">Pick dates</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_model.DateOfBirthProxy" Label="Date of Birth" Variant="Variant.Outlined" For="@(() => _model.DateOfBirthProxy)" Style="text-align: center;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_model.PassportExpireDateProxy" Label="Passport Expiry" Variant="Variant.Outlined" For="@(() => _model.PassportExpireDateProxy)" Style="text-align: center;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_model.WorkPermitValidDateProxy" Label="Work Permit Valid Date" Variant="Variant.Outlined" For="@(() => _model.WorkPermitValidDateProxy)" Style="text-align: center;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_model.WorkPermitExpireDateProxy" Label="Work Permit Expire Date" Variant="Variant.Outlined" For="@(() => _model.WorkPermitExpireDateProxy)" Style="text-align: center;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_model.DateOfAppointmentProxy" Label="Date of Appointment" Variant="Variant.Outlined" For="@(() => _model.DateOfAppointmentProxy)" Style="text-align: center;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_model.DateOfConfirmationProxy" Label="Date of Confirmation" Variant="Variant.Outlined" For="@(() => _model.DateOfConfirmationProxy)" Style="text-align: center;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_model.DateOfPromotionProxy" Label="Date of Promotion" Variant="Variant.Outlined" For="@(() => _model.DateOfPromotionProxy)" Style="text-align: center;" />
                    </MudItem>
                </MudGrid>

                @* ── ⬆ Toggle ── *@
                <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">Turn on or off</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudSwitch @bind-Value="_model.MobileAttendance" Label="Mobile Attendance" Color="Color.Success" />
                    </MudItem>
                </MudGrid>

            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? _mudDialog { get; set; }

    private bool _saving;

    private void Cancel() => _mudDialog?.Cancel();

    // ── Form ──
    private MudForm? _form;
    private EmployeeCreateFormModel _model = new();
    private Dictionary<string, string> _serverErrors = new();

    // ── Validators ──
    private readonly CreateEmployeeProfileValidator _profileValidator = new();
    private readonly CreateEmployeeEmploymentValidator _employmentValidator = new();
    private readonly CreateEmployeeContactValidator _contactValidator = new();
    private readonly CreateEmployeeFamilyInfoValidator _familyValidator = new();
    private readonly CreateEmployeePayrollInfoValidator _payrollValidator = new();

    // ── Lookup data ──
    private List<LookUpDto> _departments = new();
    private List<LookUpDto> _positions = new();
    private List<LookUpDto> _teams = new();
    private List<EmployeeLookupDto> _employees = new();

    protected override async Task OnInitializedAsync()
    {
        _departments = await LookupState.GetDepartmentsAsync();
        _positions = await LookupState.GetPositionsAsync();
        _teams = await LookupState.GetTeamsAsync();
        _employees = await LookupState.GetEmployeesAsync();
    }

    // ── Validation ──

    private async Task<IEnumerable<string>> ValidateField(object model, string propertyName)
    {
        if (string.IsNullOrEmpty(propertyName)) return Array.Empty<string>();

        var allErrors = new List<string>();

        var profileErrors = await _profileValidator.ValidateMappedValue<EmployeeCreateFormModel, CreateEmployeeProfileDto>(
            _model, _serverErrors)(model, propertyName);
        allErrors.AddRange(profileErrors);

        var employmentErrors = await _employmentValidator.ValidateMappedValue<EmployeeCreateFormModel, CreateEmployeeEmploymentDto>(
            _model, _serverErrors)(model, propertyName);
        allErrors.AddRange(employmentErrors);

        var contactErrors = await _contactValidator.ValidateMappedValue<EmployeeCreateFormModel, CreateEmployeeContactDto>(
            _model, _serverErrors)(model, propertyName);
        allErrors.AddRange(contactErrors);

        var familyErrors = await _familyValidator.ValidateMappedValue<EmployeeCreateFormModel, CreateEmployeeFamilyInfoDto>(
            _model, _serverErrors)(model, propertyName);
        allErrors.AddRange(familyErrors);

        var payrollErrors = await _payrollValidator.ValidateMappedValue<EmployeeCreateFormModel, CreateEmployeePayrollInfoDto>(
            _model, _serverErrors)(model, propertyName);
        allErrors.AddRange(payrollErrors);

        if (_serverErrors.TryGetValue(propertyName, out var serverError))
            allErrors.Add(serverError);

        return allErrors;
    }

    // ── Save ──

    private async Task Save()
    {
        if (_saving) return;

        _serverErrors.Clear();
        await _form!.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add("Please fix all validation errors before saving.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var dto = new CreateFullEmployeeDto
            {
                Profile = _model.Adapt<CreateEmployeeProfileDto>(),
                Employment = _model.Adapt<CreateEmployeeEmploymentDto>(),
                Contact = _model.Adapt<CreateEmployeeContactDto>(),
                Family = _model.Adapt<CreateEmployeeFamilyInfoDto>(),
                Payroll = _model.Adapt<CreateEmployeePayrollInfoDto>()
            };

            var response = await EmployeeProfileApiClient.CreateFullAsync(dto);
            if (response.Success)
            {
                LookupState.ClearEmployeeCache();
                Snackbar.Add("Employee created successfully", Severity.Success);
                _mudDialog?.Close(DialogResult.Ok(response.Data));
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to create employee", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Lookup search/display helpers ──

    private Task<IEnumerable<long>> SearchDepartments(string value, CancellationToken token)
    {
        var query = _departments.AsQueryable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => x.Id).AsEnumerable());
    }

    private string GetDepartmentDisplay(long id)
    {
        if (id <= 0) return string.Empty;
        var dept = _departments.FirstOrDefault(x => x.Id == id);
        if (dept == null) return string.Empty;
        return dept.IsActive ? dept.Name : $"{dept.Name} (Inactive)";
    }

    private Task<IEnumerable<long>> SearchPositions(string value, CancellationToken token)
    {
        var query = _positions.AsQueryable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => x.Id).AsEnumerable());
    }

    private string GetPositionDisplay(long id)
    {
        if (id <= 0) return string.Empty;
        var pos = _positions.FirstOrDefault(x => x.Id == id);
        if (pos == null) return string.Empty;
        return pos.IsActive ? pos.Name : $"{pos.Name} (Inactive)";
    }

    private Task<IEnumerable<long?>> SearchTeams(string value, CancellationToken token)
    {
        var query = _teams.AsQueryable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).AsEnumerable());
    }

    private string GetTeamDisplay(long? id)
    {
        if (id == null || id <= 0) return string.Empty;
        var team = _teams.FirstOrDefault(x => x.Id == id);
        if (team == null) return string.Empty;
        return team.IsActive ? team.Name : $"{team.Name} (Inactive)";
    }

    private Task<IEnumerable<long?>> SearchEmployees(string value, CancellationToken token)
    {
        var query = _employees.AsQueryable();
        if (!string.IsNullOrWhiteSpace(value))
            query = query.Where(x => x.StaffNo.Contains(value, StringComparison.OrdinalIgnoreCase)
                                  || x.StaffName.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(x => (long?)x.Id).AsEnumerable());
    }

    private string GetEmployeeDisplay(long? id)
    {
        if (id == null || id <= 0) return string.Empty;
        var emp = _employees.FirstOrDefault(x => x.Id == id);
        if (emp == null) return string.Empty;
        return $"{emp.StaffNo} - {emp.StaffName}";
    }
}
