@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <MudText>Hello, @context.User.Identity?.Name!</MudText>
        <MudButton Href="logout" Variant="Variant.Text" Color="Color.Inherit">Log out</MudButton>
    </Authorized>
    <NotAuthorized>
        <MudButton Href="login" Variant="Variant.Text" Color="Color.Inherit">Log in</MudButton>
    </NotAuthorized>
</AuthorizeView>
