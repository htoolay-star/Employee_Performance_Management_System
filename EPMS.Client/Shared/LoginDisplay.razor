@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject NavigationManager Navigation
@inject IDialogService DialogService

<AuthorizeView>
    <Authorized>
        <MudText>Hello, @context.User.Identity?.Name!</MudText>
        <MudButton OnClick="LogoutAsync" Variant="Variant.Text" Color="Color.Inherit">Log out</MudButton>
    </Authorized>
    <NotAuthorized>
        <MudButton Href="login" Variant="Variant.Text" Color="Color.Inherit">Log in</MudButton>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task LogoutAsync()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to log out?" },
            { x => x.ButtonText, "Log Out" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Confirm Logout", parameters);

        if (await dialog.Result is { Canceled: false })
            Navigation.NavigateTo("logout");
    }
}
