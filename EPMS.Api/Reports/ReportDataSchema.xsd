<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="ReportDataSchema"
    targetNamespace="http://tempuri.org/ReportDataSchema.xsd"
    elementFormDefault="qualified"
    xmlns="http://tempuri.org/ReportDataSchema.xsd"
    xmlns:mstns="http://tempuri.org/ReportDataSchema.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">

	<xs:element name="ReportDataSchema" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="EmployeeSummaryTable">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="StaffName" type="xs:string" minOccurs="0" />
							<xs:element name="EmailAddress" type="xs:string" minOccurs="0" />
							<xs:element name="TotalScore" type="xs:double" minOccurs="0" />
							<xs:element name="Grade" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>